@inject DialogService Dialoge
@*
    Schaltfläche, die – wenn sie gesperrt ist – immer erklärt, warum.
    Die Begründung erscheint als Tooltip bei Maus-Hover und bei Tastaturfokus und wird Screenreadern vorgelesen.
    Mit „Rueckfrage“ fragt sie vor der Aktion nach (Löschen, Entfernen, Stornieren …, QA-58); die bestätigende Schaltfläche heißt wie die Folge.
*@
@if (Freigabe is { Erlaubt: false })
{
    <span class="vhs-why" tabindex="0" data-why="@Freigabe.Begruendung" aria-label="@($"{Text} – nicht möglich: {Freigabe.Begruendung}")">
        <RadzenButton Text="@Text" Icon="@Icon" ButtonStyle="@ButtonStyle" Variant="@Variant" Size="@Size" Disabled="true" tabindex="-1" />
    </span>
}
else
{
    <RadzenButton Text="@Text" Icon="@Icon" ButtonStyle="@ButtonStyle" Variant="@Variant" Size="@Size"
                  Click="@KlickAsync" IsBusy="@IsBusy" BusyText="@(BusyText ?? Text)" />
}

@code {
    [Parameter, EditorRequired]
    public string Text { get; set; } = string.Empty;

    [Parameter]
    public string? Icon { get; set; }

    [Parameter]
    public ButtonStyle ButtonStyle { get; set; } = ButtonStyle.Primary;

    [Parameter]
    public Variant Variant { get; set; } = Variant.Filled;

    [Parameter]
    public ButtonSize Size { get; set; } = ButtonSize.Medium;

    [Parameter]
    public EventCallback<MouseEventArgs> Click { get; set; }

    /// <summary>Ist die Aktion gerade erlaubt? <c>null</c> = ja.</summary>
    [Parameter]
    public Freigabe? Freigabe { get; set; }

    [Parameter]
    public bool IsBusy { get; set; }

    [Parameter]
    public string? BusyText { get; set; }

    /// <summary>Frage vor der Aktion (nennt Objekt und Folge); <c>null</c> = keine Rückfrage.</summary>
    [Parameter]
    public string? Rueckfrage { get; set; }

    /// <summary>Titel der Rückfrage; Standard: Text der Schaltfläche mit Fragezeichen.</summary>
    [Parameter]
    public string? RueckfrageTitel { get; set; }

    /// <summary>Text der bestätigenden Schaltfläche; Standard: Text dieser Schaltfläche (ohne „…“).</summary>
    [Parameter]
    public string? RueckfrageJa { get; set; }

    private async Task KlickAsync(MouseEventArgs e)
    {
        if (Rueckfrage is { Length: > 0 } frage
            && !await Dialoge.BestaetigenAsync(frage, RueckfrageTitel ?? Rueckfragen.Folge(Text) + "?", RueckfrageJa ?? Rueckfragen.Folge(Text)))
        {
            return;
        }

        await Click.InvokeAsync(e);
    }
}
