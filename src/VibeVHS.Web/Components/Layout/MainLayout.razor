@inherits LayoutComponentBase
@using VibeVHS.Application.Stammdaten
@using VibeVHS.Domain.Stammdaten
@inject NavigationManager Navigation
@inject Vorgang Vorgang
@inject IConfiguration Konfiguration

<RadzenComponents />

<div class="vhs-app">
    <Testsystemhinweis />
    <aside class="vhs-side">
        <div class="vhs-brand" title="@einrichtung?.Name"><b>VibeVHS</b><span>@(einrichtung?.Kurzname ?? "Volkshochschule")</span></div>
        <nav class="vhs-nav" aria-label="Hauptnavigation">
            @foreach (var gruppe in Navigationspunkte.GroupBy(n => n.Gruppe))
            {
                <div class="vhs-grp">@gruppe.Key</div>
                @foreach (var punkt in gruppe)
                {
                    @if (punkt.Gesperrt is { } grund)
                    {
                        <span class="vhs-why vhs-nav-off" tabindex="0" data-why="@grund" aria-disabled="true">@punkt.Titel</span>
                    }
                    else
                    {
                        <NavLink href="@punkt.Ziel" Match="@(punkt.Ziel == "" ? NavLinkMatch.All : NavLinkMatch.Prefix)" ActiveClass="on">@punkt.Titel</NavLink>
                    }
                }
            }
        </nav>
        <div class="vhs-foot">Phase B · bis Iteration 9<br />Entwicklungsstand, Mock-Anbindungen</div>
    </aside>
    <div class="vhs-main">
        <header class="vhs-top">
            <GlobaleSuche />
            <AuthorizeView>
                <Authorized>
                    @{
                        var benutzer = VibeVHS.Adapters.Mocks.MockAnmeldung.AlsBenutzer(context.User);
                    }
                    <div class="vhs-role">
                        <span>Angemeldet als <b>@benutzer?.Name</b></span>
                        @if (benutzer is { Rollen.Count: > 1 })
                        {
                            <form method="post" action="rolle-wechseln" class="vhs-inline">
                                <AntiforgeryToken />
                                <input type="hidden" name="zurueck" value="@AktuellerPfad" />
                                <label for="rolle-wahl">Rolle</label>
                                <select id="rolle-wahl" name="rolle" class="vhs-select" data-auto-absenden
                                        title="Aktive Rolle wechseln: Aufgaben und Rechte richten sich nach ihr.">
                                    @foreach (var r in benutzer.Rollen)
                                    {
                                        <option value="@r" selected="@(r == benutzer.Rolle)">@r.Anzeigename()</option>
                                    }
                                </select>
                                <noscript><button type="submit" class="vhs-linkbutton">wechseln</button></noscript>
                            </form>
                        }
                        else
                        {
                            <span class="vhs-why" tabindex="0" data-why="Ihrem Konto ist nur diese eine Rolle zugeordnet.">Rolle <b>@benutzer?.Rolle?.Anzeigename()</b></span>
                        }
                        <a href="anmelden" class="vhs-link" title="Mit einem anderen Testkonto anmelden">Konto wechseln</a>
                        <form method="post" action="abmelden" class="vhs-inline">
                            <AntiforgeryToken />
                            <button type="submit" class="vhs-linkbutton">Abmelden</button>
                        </form>
                    </div>
                </Authorized>
            </AuthorizeView>
            <span class="vhs-proto" title="Alle Mails und Schnittstellen werden nur simuliert; nichts verlässt das System.">@(Konfiguration.GetValue("Testsystem:Aktiv", false) ? "Testsystem" : "Entwicklung") · Mock-Anbindungen</span>
        </header>
        <main class="vhs-content">
            @Body
        </main>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Es ist ein unerwarteter Fehler aufgetreten.
    <a href="." class="reload">Neu laden</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private sealed record Navigationspunkt(string Gruppe, string Titel, string Ziel, string? Gesperrt = null);

    private static string Geplant(string was) => Freigabe.Geplant(was).Begruendung!;

    private static readonly IReadOnlyList<Navigationspunkt> Navigationspunkte =
    [
        new("Übersicht", "Start", ""),
        new("Übersicht", "Aufgaben", "aufgaben"),
        new("Übersicht", "Dashboard", "dashboard"),
        new("Programm", "Kurse", "kurse"),
        new("Programm", "Raumplan", "raumplan"),
        new("Programm", "Orte", "orte"),
        new("Programm", "Qualifikationen", "qualifikationen"),
        new("Programm", "Ferien und Feiertage", "ferien"),
        new("Teilnahme", "Anmeldung", "anmeldung"),
        new("Teilnahme", "Personen", "personen"),
        new("Teilnahme", "Anwesenheit", "anwesenheit"),
        new("Teilnahme", "Integrationskurse", "integration"),
        new("Teilnahme", "Anliegen Kursleitungen", "portal-anliegen"),
        new("Verwaltung", "Finanzen", "finanzen"),
        new("Verwaltung", "Postausgang", "postausgang"),
        new("Verwaltung", "Vorlagen", "vorlagen"),
        new("Verwaltung", "Protokoll", "protokoll"),
        new("Verwaltung", "Datenschutz", "datenschutz"),
        new("Verwaltung", "Auswertungen", "auswertungen"),
        new("Verwaltung", "Import", "import"),
        new("Verwaltung", "Betrieb", "betrieb"),
    ];

    private Einrichtung? einrichtung;

    private string AktuellerPfad => Navigation.ToBaseRelativePath(Navigation.Uri);

    protected override async Task OnInitializedAsync()
        => einrichtung = await Vorgang.AusfuehrenAsync(d => d.GetRequiredService<IStammdaten>().EinrichtungAsync());
}
