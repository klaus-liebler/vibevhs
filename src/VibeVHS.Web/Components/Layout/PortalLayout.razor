@inherits LayoutComponentBase
@inject NavigationManager Navigation

@* Schlankes Layout des Dozierendenportals: mobil zuerst, statisch gerendert, große Ziele, keine Seitenleiste. *@

<div class="vhs-portal">
    <header class="vhs-portal-kopf">
        <b>@(Teilnehmende ? "Meine vhs" : "Dozierendenportal")</b>
        <span class="vhs-small vhs-muted" style="flex:1">Volkshochschule</span>
        <AuthorizeView>
            <Authorized>
                <span class="vhs-small">@context.User.Identity?.Name</span>
                @if (VibeVHS.Adapters.Mocks.MockAnmeldung.AlsBenutzer(context.User) is { } ich
                     && ich.Rollen.Contains(VibeVHS.Application.Sicherheit.Rolle.Teilnehmende) && ich.Rollen.Contains(VibeVHS.Application.Sicherheit.Rolle.Dozierende))
                {
                    @* Beide Rollen: zwischen „Meine vhs“ und Dozierendenportal wechseln *@
                    <form method="post" action="rolle-wechseln" style="display:inline">
                        <AntiforgeryToken />
                        <input type="hidden" name="rolle" value="@(Teilnehmende ? "Dozierende" : "Teilnehmende")" />
                        <input type="hidden" name="zurueck" value="@(Teilnehmende ? "portal/dozierende" : "portal/teilnehmende")" />
                        <button type="submit" class="vhs-linkbutton">@(Teilnehmende ? "Zum Dozierendenportal" : "Zu „Meine vhs“")</button>
                    </form>
                }
                <form method="post" action="abmelden" style="display:inline">
                    <AntiforgeryToken />
                    <button type="submit" class="vhs-linkbutton">Abmelden</button>
                </form>
            </Authorized>
        </AuthorizeView>
    </header>
    <AuthorizeView>
        <Authorized>
            <nav class="vhs-portal-nav" aria-label="Portal">
                @foreach (var (pfad, text) in Teilnehmende ? TnPunkte : Navigationspunkte)
                {
                    <a href="@pfad" class="@(Aktiv(pfad) ? "active" : null)" aria-current="@(Aktiv(pfad) ? "page" : null)">@text</a>
                }
            </nav>
        </Authorized>
    </AuthorizeView>
    <main class="vhs-portal-inhalt">
        @Body
    </main>
</div>

@code {
    private static readonly (string Pfad, string Text)[] Navigationspunkte =
    [
        ("portal/dozierende", "Termine"),
        ("portal/dozierende/kurse", "Kurse & Unterlagen"),
        ("portal/dozierende/honorar", "Honorar"),
        ("portal/dozierende/planung", "Nächstes Semester"),
        ("portal/dozierende/daten", "Meine Daten"),
    ];

    private static readonly (string Pfad, string Text)[] TnPunkte =
    [
        ("portal/teilnehmende", "Termine"),
        ("portal/teilnehmende/buchungen", "Buchungen"),
        ("portal/teilnehmende/unterlagen", "Unterlagen & Rechnungen"),
        ("portal/teilnehmende/daten", "Meine Daten"),
        ("portal/teilnehmende/hilfe", "Hilfe / Sprache"),
    ];

    private bool Teilnehmende => Navigation.ToBaseRelativePath(Navigation.Uri).StartsWith("portal/teilnehmende", StringComparison.Ordinal);

    private bool Aktiv(string pfad)
    {
        var hier = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?')[0].TrimEnd('/');
        return pfad is "portal/dozierende" or "portal/teilnehmende"
            ? hier == pfad || hier.StartsWith(pfad + "/termin", StringComparison.Ordinal)
            : hier.StartsWith(pfad, StringComparison.Ordinal);
    }
}
