<!DOCTYPE html>
<html lang="de">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <BasePath />
    <ResourcePreloader />
    <RadzenTheme Theme="standard" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["VibeVHS.Web.styles.css"]" />
    <ImportMap />
    <HeadOutlet @rendermode="SeitenModus" />
</head>

<body>
    <Routes @rendermode="SeitenModus" />
    <ReconnectModal />
    <script src="_content/Radzen.Blazor/Radzen.Blazor.js?v=@(typeof(Radzen.Colors).Assembly.GetName().Version)"></script>
    <script src="@Assets["lib/html5-qrcode/html5-qrcode.min.js"]"></script>
    <script src="@Assets["scanner.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    // Seiten mit [ExcludeFromInteractiveRouting] (z. B. Anmeldung) laufen statisch, alle anderen interaktiv.
    private IComponentRenderMode? SeitenModus =>
        HttpContext.AcceptsInteractiveRouting() ? InteractiveServer : null;
}
