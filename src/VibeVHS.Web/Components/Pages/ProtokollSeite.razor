@page "/protokoll"
@using VibeVHS.Application.Protokoll
@inject Vorgang Vorgang

<PageTitle>Protokoll · VibeVHS</PageTitle>

<div class="vhs-head">
    <div>
        <h1>Protokoll</h1>
        <p class="vhs-sub">Wer hat wann was getan. Einträge können nicht geändert oder gelöscht werden.</p>
    </div>
</div>

<section class="vhs-card">
    <RadzenDataGrid TItem="AuditEintrag" Data="@eintraege" AllowSorting="true" AllowPaging="true" PageSize="50"
                    EmptyText="Noch keine Einträge." ShowPagingSummary="true" PagingSummaryFormat="Seite {0} von {1} ({2} Einträge)">
        <Columns>
            <RadzenDataGridColumn TItem="AuditEintrag" Property="@nameof(AuditEintrag.Zeitpunkt)" Title="Zeitpunkt" Width="160px">
                <Template Context="e"><span class="vhs-mono">@e.Zeitpunkt.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss")</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AuditEintrag" Property="@nameof(AuditEintrag.Benutzer)" Title="Wer" Width="220px">
                <Template Context="e">@e.Benutzer@(e.Rolle is null ? "" : $" ({e.Rolle})")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AuditEintrag" Property="@nameof(AuditEintrag.Beschreibung)" Title="Was">
                <Template Context="e">
                    @e.Beschreibung
                    @if (e.ObjektTyp == "Person" && e.ObjektId is { } pid && namen.TryGetValue(pid, out var n))
                    {
                        <br /><a class="vhs-small" href="@($"personen/{pid}")">Bezug: @n</a>
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AuditEintrag" Property="@nameof(AuditEintrag.Aktion)" Title="Aktion" Width="220px">
                <Template Context="e"><span class="vhs-mono vhs-small">@e.Aktion</span></Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="AuditEintrag" Property="@nameof(AuditEintrag.Erfolgreich)" Title="Ergebnis" Width="130px">
                <Template Context="e">
                    @if (e.Erfolgreich)
                    {
                        <StatusPille Stil="gut">erledigt</StatusPille>
                    }
                    else
                    {
                        <StatusPille Stil="warn">Prüfung nötig</StatusPille>
                    }
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
</section>

@code {
    private IReadOnlyList<AuditEintrag> eintraege = [];

    protected override async Task OnInitializedAsync()
    {
        await Vorgang.AusfuehrenAsync(async d =>
        {
            eintraege = await d.GetRequiredService<IAuditProtokoll>().NeuesteAsync(2000);
            // Das Protokoll speichert nur Pseudonyme; der aktuelle Name wird zur Anzeige aufgelöst (nach Anonymisierung: Platzhalter).
            namen = await d.GetRequiredService<VibeVHS.Application.Personen.IPersonenSpeicher>()
                .AnzeigenamenAsync(eintraege.Where(e => e.ObjektTyp == "Person" && e.ObjektId is not null).Select(e => e.ObjektId!.Value));
        });
    }

    private IReadOnlyDictionary<Guid, string> namen = new Dictionary<Guid, string>();
}
