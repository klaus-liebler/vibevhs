@page "/qualifikationen"
@using VibeVHS.Application.Programm
@using VibeVHS.Domain.Programm
@inject Vorgang Vorgang
@inject NotificationService Hinweise

<PageTitle>Qualifikationen · VibeVHS</PageTitle>

<div class="vhs-head">
    <div>
        <h1>Qualifikationen von Dozierenden</h1>
        <p class="vhs-sub">Gemeinsamer Merkmalskatalog (hier: Merkmale an Personen) und was jede Kursart von Dozierenden verlangt. Geprüft wird an jedem Veranstaltungstag.</p>
    </div>
</div>

<div class="vhs-split">
    <section class="vhs-card">
        <h2>Kursarten verlangen</h2>
        <p class="vhs-small vhs-muted" style="margin-top:-6px">Änderungen gelten auch für alle nicht archivierten Kurse dieser Art; kursbezogene Ergänzungen (z. B. Alpha) bleiben.</p>
        <div class="vhs-tbl">
            <table>
                <thead><tr><th>Kursart</th><th>Qualifikationen</th><th></th></tr></thead>
                <tbody>
                    @foreach (var art in kursarten)
                    {
                        var auswahl = Auswahl(art);
                        <tr>
                            <td><b>@art.Name</b><br /><span class="vhs-small vhs-muted">@NutzungsartAnzeige.Text(art.Nutzungsart)</span></td>
                            <td>
                                <div class="vhs-chips">
                                    @foreach (var m in merkmale)
                                    {
                                        <button class="vhs-chip @(auswahl.Contains(m.Schluessel) ? "on" : "")" disabled="@(!Pflegen.Erlaubt)" title="@(m.Gesetzlich ? "gesetzlich – keine Ausnahme möglich" : "Ausnahme durch Fachbereichsleitung möglich")"
                                                @onclick="@(() => { if (!auswahl.Remove(m.Schluessel)) auswahl.Add(m.Schluessel); })">@m.Name</button>
                                    }
                                </div>
                            </td>
                            <td><BegruendeterButton Text="Übernehmen" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Freigabe="@(Pflegen.Und(() => auswahl.SetEquals(art.BenoetigteDozierendenmerkmale) ? Freigabe.Nein("Keine Änderung.") : Freigabe.Ja))"
                                                    Click="@(() => KursartAsync(art, auswahl))" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <section class="vhs-card">
        <h2>Katalog: Merkmale an Personen</h2>
        <MerkmalKatalogPflege Bezug="MerkmalBezug.Person" Rolle="@rolle" Geaendert="LadenAsync" />
    </section>
</div>

<NaechsteSchritte Schritte="@([new NaechsterSchritt("Zur Personenliste", "personen", "Qualifikationen je Person auf der Personenseite pflegen (Filter Rolle: Dozierende)"), new NaechsterSchritt("Kurse", "kurse")])" />

@code {
    private IReadOnlyList<Merkmal> merkmale = [];
    private IReadOnlyList<Kursart> kursarten = [];
    private readonly Dictionary<Guid, HashSet<string>> auswahlen = [];
    private Rolle? rolle;

    private Freigabe Pflegen => Freigabe.NurFuer(rolle, Rolle.Fachbereichsleitung, Rolle.Verwaltungsleitung, Rolle.Leitung);

    private HashSet<string> Auswahl(Kursart art)
    {
        if (!auswahlen.TryGetValue(art.Id, out var a))
        {
            a = [.. art.BenoetigteDozierendenmerkmale];
            auswahlen[art.Id] = a;
        }

        return a;
    }

    protected override async Task OnInitializedAsync()
    {
        rolle = (await Vorgang.BenutzerAsync()).Rolle;
        await LadenAsync();
    }

    private async Task LadenAsync()
    {
        await Vorgang.AusfuehrenAsync(async d =>
        {
            merkmale = await d.GetRequiredService<QualifikationsDienst>().PersonenmerkmaleAsync();
            kursarten = await d.GetRequiredService<IProgrammSpeicher>().KursartenAsync();
        });
        auswahlen.Clear();
    }

    private async Task KursartAsync(Kursart art, HashSet<string> auswahl)
    {
        try
        {
            await Vorgang.AusfuehrenAsync(d => d.GetRequiredService<QualifikationsDienst>().KursartAnforderungenSetzenAsync(art.Id, auswahl.ToList()));
            Hinweise.Notify(NotificationSeverity.Success, "Gespeichert", $"„{art.Name}“ aktualisiert, auch in den Kursen dieser Art.");
            await LadenAsync();
        }
        catch (InvalidOperationException ex)
        {
            Hinweise.Notify(NotificationSeverity.Error, "Nicht möglich", ex.Message);
        }
    }


}
