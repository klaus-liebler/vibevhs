@page "/kurse/{Id:guid}"
@using VibeVHS.Application.Programm
@using VibeVHS.Domain.Programm
@inject Vorgang Vorgang
@inject TimeProvider Uhr
@inject NotificationService Hinweise

<PageTitle>@(kurs?.Kursnummer ?? "Kurs") · VibeVHS</PageTitle>

@if (kurs is null || verzeichnis is null)
{
    <h1>Kurs nicht gefunden</h1>
    <NaechsteSchritte Schritte="@([new NaechsterSchritt("Zur Kursliste", "kurse", Hauptschritt: true)])" />
    return;
}

<ZurueckZurListe Liste="kurse" />
<div class="vhs-head">
    <div>
        <h1>@kurs.Kursnummer @kurs.Titel</h1>
        <p class="vhs-sub">
            <StatusPille Stil="@(kurs.Status == Kursstatus.Veroeffentlicht ? "gut" : kurs.Status == Kursstatus.Abgesagt ? "krit" : "neutral")">@KursAnzeige.Status(kurs.Status)</StatusPille>
            FB @kurs.Fachbereich · @NutzungsartAnzeige.Text(verzeichnis!.NutzungsartVon(kurs)) · @KursAnzeige.Sichtbarkeit(kurs.Sichtbarkeit)@(namen.Organisation(kurs.AuftraggeberId) is { } ag ? $" für {ag}" : "")
            · @kurs.MinTeilnehmende–@kurs.MaxTeilnehmende Teilnehmende
        </p>
    </div>
    <div class="vhs-row">
        @if (kurs.Sichtbarkeit == Sichtbarkeit.Oeffentlich)
        {
            <a class="vhs-btn vhs-btn-light" href="@($"kurse/qr/{Uri.EscapeDataString(kurs.Kursnummer)}.png")" download title="QR-Code für Programmheft und Aushang: führt zur Kursseite mit Online-Anmeldung, mit gemerktem Gerät zur Schnellanmeldung">Kurs-QR (PNG)</a>
            <a class="vhs-btn vhs-btn-light" href="@($"kurse/qr/{Uri.EscapeDataString(kurs.Kursnummer)}.svg")" download title="Vektorgrafik für den Druck">SVG</a>
        }
        <BegruendeterButton Text="Veröffentlichen" Icon="public" Freigabe="@VeroeffentlichenFreigabe" Click="@(() => StatusAsync(Kursstatus.Veroeffentlicht))" />
        <BegruendeterButton Text="Absagen …" Icon="cancel" ButtonStyle="ButtonStyle.Light" Freigabe="@AbsagenFreigabe" Click="@(() => { absageOffen = true; absageGrund = null; })" />
    </div>
</div>

@if (kurs.Archiviert)
{
    <div class="vhs-alert vhs-info">Archiviert am @kurs.ArchiviertAm?.ToLocalTime().ToString("dd.MM.yyyy"): schreibgeschützt und in der Kursliste ausgeblendet.
        <BegruendeterButton Text="Wiederherstellen" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Freigabe="@(Freigabe.NurFuer(rolle, Rolle.Verwaltungsleitung, Rolle.Leitung, Rolle.Fachbereichsleitung))" Click="WiederherstellenAsync" />
    </div>
}

<NaechsteSchritte Titel="Wie geht es weiter?" Schritte="@folgeschritte" />

@if (absageOffen && kurs.Status != Kursstatus.Abgesagt)
{
    @* Absage mit Bestätigung und Grund; derselbe Dienst wie bei der Aufgabe „absagen oder durchführen?“ *@
    var offeneBelegungen = teilnehmende.Count(t => t.Belegung.Offen);
    var kuenftigeTermine = kurs.Veranstaltungen.Count(v => !v.Ausgefallen && v.Beginn >= Uhr.GetLocalNow().DateTime);
    <section class="vhs-card vhs-einschub" id="kurs-absagen" aria-labelledby="h-absagen">
        <div class="vhs-head"><h2 id="h-absagen">Kurs absagen</h2></div>
        <div class="vhs-alert vhs-warn" role="note">
            <b>@offeneBelegungen</b> offene Belegung(en) (Angemeldete, Warteliste, Nachrückangebote) werden ohne Gebühr aufgehoben;
            die Personen bekommen eine Absage per Mail mit Übersetzungslink. <b>@kuenftigeTermine</b> künftige Termin(e) fallen aus.
            Bereits gestellte Rechnungen werden im nächsten Rechnungslauf storniert. Die Absage lässt sich nicht zurücknehmen.
        </div>
        <label for="absage-grund" class="vhs-small"><b>Grund für die Teilnehmenden *</b> (steht in der Absage)</label>
        <textarea id="absage-grund" class="vhs-textarea" rows="2" maxlength="300" @bind="absageGrund" @bind:event="oninput"
                  placeholder="z. B. Mindestteilnehmerzahl nicht erreicht · Kursleitung erkrankt"></textarea>
        <div class="vhs-row">
            <BegruendeterButton Text="Absagen und Teilnehmende benachrichtigen" Icon="cancel" ButtonStyle="ButtonStyle.Danger" IsBusy="@absageLaeuft"
                                Freigabe="@AbsageBestaetigenFreigabe" Click="AbsagenAsync" />
            <RadzenButton Text="Abbrechen" ButtonStyle="ButtonStyle.Light" Click="@(() => absageOffen = false)" />
        </div>
    </section>
}

@if (nachrichtTermin is { } nt)
{
    @* Nach einem Ausfall: Nachricht an die Teilnehmenden des Termins (Postausgang, mit Übersetzungslink) *@
    <section class="vhs-card" id="teilnehmende-informieren" aria-labelledby="h-nachricht">
        <div class="vhs-head"><h2 id="h-nachricht">Teilnehmende informieren</h2>
            <span class="vhs-small vhs-muted">Termin @nt.Nummer am @nt.Beginn.ToString("dd.MM.yyyy HH:mm") · Mail über den Postausgang, mit Übersetzungslink</span></div>
        <RadzenFormField Text="Betreff" Variant="Variant.Outlined" Style="width:100%"><RadzenTextBox @bind-Value="nachrichtBetreff" /></RadzenFormField>
        <RadzenFormField Text="Text (Anrede und Gruß werden ergänzt)" Variant="Variant.Outlined" Style="width:100%"><RadzenTextArea @bind-Value="nachrichtText" Rows="6" /></RadzenFormField>
        <div class="vhs-row">
            <BegruendeterButton Text="An Teilnehmende senden" Icon="send" Freigabe="@NachrichtFreigabe" Click="NachrichtSendenAsync" />
            <RadzenButton Text="Nicht senden" ButtonStyle="ButtonStyle.Light" Click="@(() => nachrichtTermin = null)" />
        </div>
    </section>
}

<div class="vhs-grid-2">
    <section class="vhs-card">
        <h2>Kursdaten</h2>
        <dl class="vhs-kv">
            <dt>Team</dt><dd>@(kurs.Team.Count == 0 ? "–" : string.Join(", ", kurs.Team.Select(t => namen.Team(kurs, t) + (t.Leitung ? " (Leitung)" : ""))))</dd><dd></dd>
            <dt>Serie</dt><dd>@SerieText</dd><dd></dd>
            <dt>Entgelt</dt>
            <dd>
                @(kurs.EntgeltAm(DateOnly.FromDateTime(Uhr.GetLocalNow().Date), Uhr.GetLocalNow())?.Wert ?? kurs.Entgelte.LastOrDefault()?.Wert ?? "–")
                @if (kurs.Entgelte.Count(e => e.IstAktuellerWissensstand) > 1)
                {
                    <br /><span class="vhs-small vhs-muted">@string.Join(" · ", kurs.Entgelte.Where(e => e.IstAktuellerWissensstand && !e.IstEndemarke).OrderBy(e => e.GueltigVon).Select(e => $"ab {e.GueltigVon:dd.MM.yyyy}: {e.Wert}"))</span>
                }
            </dd><dd></dd>
            <dt>Buchung</dt>
            <dd>
                @string.Join(", ", kurs.Richtlinie.Rechte.Where(r => r.DarfBuchen).Select(r => r.Weg + (r.DarfUeberbuchen ? " (darf überbuchen)" : "")))
                <br /><span class="vhs-small vhs-muted">
                    @(kurs.Richtlinie.Belegung == Belegungsart.Kontingent ? $"Kontingent: {kurs.Richtlinie.KontingentAnzahl} Termine, {kurs.Richtlinie.KontingentGueltigMonate} Monate gültig" : "Belegung aller Veranstaltungen")
                    · Warteliste @(kurs.Richtlinie.Warteliste ? "ja" : "nein") · Storno bis @kurs.Richtlinie.StornofristTage Tage vorher
                </span>
            </dd><dd></dd>
            <dt>Selbst-Check-in</dt>
            <dd>
                @if (Planen.Erlaubt)
                {
                    <select class="vhs-select" value="@kurs.Richtlinie.SelbstCheckin" @onchange="SelbstCheckinAsync" title="Für Kurse mit abrechnungsrelevanter Anwesenheit (z. B. Integrationskurse) abschalten oder Bestätigung verlangen.">
                        @foreach (var s in Enum.GetValues<SelbstCheckin>())
                        {
                            <option value="@s">@SelbstCheckinAnzeige.Text(s)</option>
                        }
                    </select>
                }
                else
                {
                    <span class="vhs-why" tabindex="0" data-why="@Planen.Begruendung">@SelbstCheckinAnzeige.Text(kurs.Richtlinie.SelbstCheckin)</span>
                }
            </dd><dd></dd>
            @if (kurs.BenoetigteMerkmale.Count > 0)
            {
                <dt>Ort braucht</dt><dd>@string.Join(", ", kurs.BenoetigteMerkmale.Select(s => verzeichnis.Katalog.GetValueOrDefault(s)?.Name ?? s))</dd><dd></dd>
            }
            @if (kurs.BenoetigteDozierendenmerkmale.Count > 0)
            {
                <dt>Dozierende brauchen</dt><dd>@string.Join(", ", kurs.BenoetigteDozierendenmerkmale.Select(s => VibeVHS.Domain.Programm.Anforderung.Anzeige(s, verzeichnis.Katalog)))</dd><dd></dd>
            }
        </dl>
    </section>

    <section class="vhs-card" id="termine-aendern">
        <h2>Ändern</h2>
        <RadzenRadioButtonList TValue="string" @bind-Value="modus" Orientation="Orientation.Vertical">
            <Items>
                <RadzenRadioButtonListItem Text="Nur diese Veranstaltung (Termin unten auswählen)" Value="@("einzeln")" />
                <RadzenRadioButtonListItem Text="Alle folgenden ab dem gewählten Termin (einzeln geänderte bleiben)" Value="@("folgende")" Disabled="@(kurs.Serie is null)" />
                <RadzenRadioButtonListItem Text="Zusätzliche Einzelveranstaltung" Value="@("zusatz")" />
            </Items>
        </RadzenRadioButtonList>
        <div class="vhs-fields">
            @if (modus != "folgende")
            {
                <RadzenFormField Text="Datum" Variant="Variant.Outlined"><RadzenDatePicker TValue="DateOnly" @bind-Value="aDatum" DateFormat="dd.MM.yyyy" /></RadzenFormField>
            }
            <RadzenFormField Text="Beginn (hh:mm)" Variant="Variant.Outlined"><RadzenTextBox @bind-Value="aBeginn" /></RadzenFormField>
            <RadzenFormField Text="Dauer (Min.)" Variant="Variant.Outlined"><RadzenNumeric TValue="int" @bind-Value="aDauer" Min="15" Step="15" /></RadzenFormField>
            <RadzenFormField Text="Ort" Variant="Variant.Outlined">
                <RadzenDropDown TValue="Guid" @bind-Value="aOrt" Data="@buchbareOrte" TextProperty="Anzeige" ValueProperty="Id" AllowFiltering="true" />
            </RadzenFormField>
            <RadzenFormField Text="Bemerkung" Variant="Variant.Outlined"><RadzenTextBox @bind-Value="aBemerkung" /></RadzenFormField>
        </div>
        @if (kurs.Team.Count > 0)
        {
            <div class="vhs-row">
                <span class="vhs-small vhs-muted">Dozent/in:</span>
                @foreach (var t in kurs.Team)
                {
                    var e = EignungAm(t.PersonId, AenderungsTag);
                    if (e is null || e.Geeignet)
                    {
                        <button class="vhs-chip @(aDozent == t.PersonId ? "on" : "")" title="@(e?.Code == Eignungscode.Ausnahme ? "mit Ausnahme" : "geeignet")" @onclick="@(() => aDozent = t.PersonId)">@namen.Team(kurs, t)</button>
                    }
                    else
                    {
                        <span class="vhs-why" tabindex="0" data-why="@($"{namen.Team(kurs, t)} am {AenderungsTag:dd.MM.yyyy}: {e.Begruendung}")"><button class="vhs-chip" disabled>@namen.Team(kurs, t)</button></span>
                    }
                }
            </div>
        }
        <div class="vhs-row">
            <BegruendeterButton Text="Übernehmen" Icon="save" Click="AendernAsync" Freigabe="@AendernFreigabe" />
            <BegruendeterButton Text="Gewählten Termin ausfallen lassen" Icon="event_busy" ButtonStyle="ButtonStyle.Light"
                                Freigabe="@(gewaehlt is null ? Freigabe.Nein("Bitte zuerst unten einen Termin auswählen.") : Planen)" Click="AusfallenAsync" />
        </div>
    </section>
</div>

<section class="vhs-card">
    <div class="vhs-head">
        <h2>Dozierendenteam</h2>
        <span class="vhs-small vhs-muted">Geprüft für alle künftigen Veranstaltungstage@(kurs.BenoetigteDozierendenmerkmale.Count == 0 ? " · diese Kursart verlangt keine Qualifikationen" : "")</span>
    </div>
    @if (betroffen.Values.Any(b => !b.Geeignet))
    {
        <div class="vhs-alert vhs-crit">@betroffen.Values.Count(b => !b.Geeignet) künftige Veranstaltung(en) mit fehlender Qualifikation – unten in der Tabelle markiert. Eine Aufgabe für die Fachbereichsleitung ist angelegt.</div>
    }
    <div class="vhs-list">
        @foreach (var t in kurs.Team)
        {
            var e = teamEignung.FirstOrDefault(x => x.PersonId == t.PersonId);
            <div>
                <span class="vhs-grow"><a href="@($"personen/{t.PersonId}")">@namen.Team(kurs, t)</a> @if (t.Leitung) { <StatusPille Stil="neutral">Leitung</StatusPille> }</span>
                @if (e is null || kurs.BenoetigteDozierendenmerkmale.Count == 0) { }
                else if (e.Geeignet)
                {
                    <StatusPille Stil="@(e.MitAusnahme ? "info" : "gut")">@(e.MitAusnahme ? "mit Ausnahme" : "geeignet")</StatusPille>
                }
                else
                {
                    <span class="vhs-why" tabindex="0" data-why="@e.Begruendung"><StatusPille Stil="krit">nicht geeignet ab @e.ErsterFehltag?.Tag.ToString("dd.MM.yyyy")</StatusPille></span>
                    <BegruendeterButton Text="Ausnahme erteilen" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@(() => AusnahmeAsync(t.PersonId, e))"
                                        Freigabe="@(Freigabe.NurFuer(rolle, Rolle.Fachbereichsleitung, Rolle.Leitung).Und(() => !e.AusnahmeMoeglich ? Freigabe.Nein("Gesetzlich vorgeschrieben (z. B. BAMF-Zulassung): keine Ausnahme möglich. Nachweis eintragen oder andere Person einplanen.") : string.IsNullOrWhiteSpace(ausnahmeText) ? Freigabe.Nein("Bitte unten eine Begründung eingeben.") : Freigabe.Ja))" />
                }
                <BegruendeterButton Text="Entfernen" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@(() => TeamEntfernenAsync(t.PersonId))"
                                    Rueckfrage="@($"{namen.Team(kurs, t)} wird aus dem Kursteam von {kurs.Kursnummer} entfernt.")" RueckfrageTitel="Aus dem Kursteam entfernen?"
                                    Freigabe="@(Planen.Und(() => kurs.Veranstaltungen.Any(v => v.DozentId == t.PersonId && !v.Ausgefallen && v.Ende >= Uhr.GetLocalNow().LocalDateTime) ? Freigabe.Nein("Leitet noch künftige Veranstaltungen; diese zuerst einer anderen Person zuordnen.") : Freigabe.Ja))" />
            </div>
        }
    </div>
    <div class="vhs-row">
        <RadzenTextBox @bind-Value="teamSuche" @bind-Value:after="TeamSuchenAsync" Placeholder="Dozierende suchen und hinzufügen" Style="min-width:260px" Disabled="@(!Planen.Erlaubt)" />
        @foreach (var o in teamTreffer.Where(o => kurs.Team.All(t => t.PersonId != o.Person.Id)))
        {
            if (o.Eignung.Geeignet)
            {
                <button class="vhs-chip" @onclick="@(() => TeamHinzufuegenAsync(o, null))">+ @o.Person.Anzeigename</button>
            }
            else if (o.Eignung.AusnahmeMoeglich && rolle is Rolle.Fachbereichsleitung or Rolle.Leitung)
            {
                <span class="vhs-why" tabindex="0" data-why="@($"{o.Eignung.Begruendung} Hinzufügen nur mit Begründung im Feld unten.")">
                    <button class="vhs-chip" style="border-color:var(--vhs-warn)" disabled="@string.IsNullOrWhiteSpace(ausnahmeText)" @onclick="@(() => TeamHinzufuegenAsync(o, ausnahmeText))">⚠ + @o.Person.Anzeigename</button>
                </span>
            }
            else
            {
                <span class="vhs-why" tabindex="0" data-why="@o.Eignung.Begruendung"><button class="vhs-chip" disabled>@o.Person.Anzeigename</button></span>
            }
        }
    </div>
    @if (kurs.BenoetigteDozierendenmerkmale.Any(a => VibeVHS.Domain.Programm.Anforderung.Basis(a) == VibeVHS.Domain.Programm.Sprachfreigabe.Schluessel))
    {
        <div class="vhs-row">
            <RadzenFormField Text="Sprache des Kurses (Lehrfreigabe)" Variant="Variant.Outlined">
                <RadzenDropDown TValue="string" @bind-Value="kursSprache" Data="@VibeVHS.Domain.Programm.Sprachfreigabe.Sprachen" AllowClear="true" Placeholder="beliebige Sprache" />
            </RadzenFormField>
            <BegruendeterButton Text="Sprache übernehmen" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Icon="translate"
                                Freigabe="@Planen.Und(() => kursSprache == AktuelleSprache ? Freigabe.Nein("Keine Änderung.") : Freigabe.Ja)"
                                Click="@(() => QualiAktionAsync(q => q.KursSpracheSetzenAsync(Id, kursSprache), "Sprache übernommen; die Eignung wird neu geprüft."))" />
        </div>
    }
    @if (kurs.BenoetigteDozierendenmerkmale.Count > 0)
    {
        <RadzenFormField Text="Begründung für eine Ausnahme (nur Fachbereichsleitung, wird protokolliert)" Variant="Variant.Outlined"><RadzenTextBox @bind-Value="ausnahmeText" /></RadzenFormField>
    }
    @foreach (var a in ausnahmen)
    {
        <p class="vhs-small vhs-muted" style="margin:0">Ausnahme: @namen.Person(a.PersonId) · „@(verzeichnis.Katalog.GetValueOrDefault(a.Schluessel)?.Name ?? a.Schluessel)“ · @a.Begruendung · @a.ErteiltVon, @a.ErteiltAm.ToLocalTime().ToString("dd.MM.yyyy")</p>
    }
</section>

<section class="vhs-card">
    <h2>@kurs.Veranstaltungen.Count Veranstaltungen @(konflikte.Count > 0 ? $"· {konflikte.Count} Konflikte" : "")</h2>
    <div class="vhs-tbl">
        <table>
            <thead><tr><th>Nr.</th><th>Datum</th><th>Zeit</th><th>Ort(e)</th><th>Dozent</th><th>Plätze</th><th>Hinweis</th></tr></thead>
            <tbody>
                @foreach (var v in kurs.Veranstaltungen.OrderBy(x => x.Beginn))
                {
                    var konflikt = konflikte.FirstOrDefault(k => k.A.VeranstaltungId == v.Id || k.B.VeranstaltungId == v.Id);
                    <tr class="vhs-klickzeile @(gewaehlt?.Id == v.Id ? "vhs-gewaehlt" : "") @(v.Ausgefallen ? "vhs-ersetzt" : "")" @onclick="@(() => Waehlen(v))">
                        <td class="vhs-mono"><a href="@Ruecksprung.Detail($"anwesenheit/{v.Id}", Ruecksprung.Aktuell(Navigation))" title="Anwesenheitsliste" @onclick:stopPropagation="true">@v.Nummer</a></td>
                        <td>@v.Beginn.ToString("ddd dd.MM.yyyy")</td>
                        <td class="vhs-mono">@v.Beginn.ToString("HH:mm")–@v.Ende.ToString("HH:mm")</td>
                        <td>@namen.Orte(v.Orte)</td>
                        <td class="vhs-small">
                            @namen.Dozent(v)
                            @if (betroffen.TryGetValue(v.Id, out var be))
                            {
                                <span class="vhs-why" tabindex="0" data-why="@be.Begruendung"><StatusPille Stil="@(be.Geeignet ? "info" : "krit")">@(be.Geeignet ? "Ausnahme" : "Qualifikation fehlt")</StatusPille></span>
                            }
                        </td>
                        <td class="vhs-mono">
                            @if (kurs.Richtlinie.VorabEinbuchung && v.Ende < Uhr.GetLocalNow().LocalDateTime)
                            {
                                <span title="besucht">@teilnehmende.Sum(t => t.Belegung.Ereignisse.Count(e => e.VeranstaltungId == v.Id && e.Art == VibeVHS.Domain.Anmeldung.Kontingentereignisart.Besucht)) besucht</span>
                            }
                            else if (kurs.Richtlinie.VorabEinbuchung)
                            {
                                <span title="eingebucht / Plätze">@v.Orte.Sum(o => lage.Belegt(v.Id, o.OrtId))/@Ortsplanung.Kapazitaet(v, kurs, verzeichnis)</span>
                            }
                            else
                            {
                                @Ortsplanung.Kapazitaet(v, kurs, verzeichnis)
                            }
                        </td>
                        <td>
                            @if (v.Ausgefallen) { <StatusPille Stil="neutral">fällt aus</StatusPille> }
                            @if (v.Ausnahme && !v.Ausgefallen) { <StatusPille Stil="info">einzeln geändert</StatusPille> }
                            @if (!v.AusSerie) { <StatusPille Stil="info">Einzeltermin</StatusPille> }
                            @if (konflikt is not null)
                            {
                                <span class="vhs-why" tabindex="0" data-why="@konflikt.Beschreibung(id => verzeichnis.Finden(id)?.Anzeige ?? "?")"><StatusPille Stil="krit">Konflikt</StatusPille></span>
                            }
                            <span class="vhs-small vhs-muted">@v.Bemerkung</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

<section class="vhs-card">
    @{
        var belegt = teilnehmende.Count(t => t.Belegung.HaeltPlatz);
        var wartend = teilnehmende.Count(t => t.Belegung.Status == VibeVHS.Domain.Anmeldung.Belegungsstatus.Warteliste);
        var kontingent = kurs.Richtlinie.Belegung == Belegungsart.Kontingent;
    }
    <div class="vhs-head">
        <h2>@(kontingent ? "Kontingente" : "Teilnehmende") · @(kontingent ? $"{belegt} aktiv" : $"{belegt} von {kurs.MaxTeilnehmende}")@(wartend > 0 ? $" · {wartend} auf der Warteliste" : "")</h2>
        <div class="vhs-row">
            <BegruendeterButton Text="Person anmelden" Icon="person_add" Size="ButtonSize.Small" Click="@(() => Navigation.NavigateTo($"anmeldung?kurs={Id}"))"
                                Freigabe="@(Freigabe.NurFuer(rolle, VibeVHS.Application.Anmeldung.AnmeldungDienst.BuchungsRollen))" />
            <BegruendeterButton Text="Freie Plätze an die Warteliste" Icon="low_priority" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="NachrueckenAsync"
                                Freigabe="@(Freigabe.NurFuer(rolle, VibeVHS.Application.Anmeldung.AnmeldungDienst.BuchungsRollen).Und(() => wartend == 0 ? Freigabe.Nein("Niemand steht auf der Warteliste.") : belegt >= kurs.MaxTeilnehmende ? Freigabe.Nein($"Der Kurs ist voll ({belegt} von {kurs.MaxTeilnehmende}). Wird ein Platz frei, bekommt die erste Person automatisch ein Angebot.") : Freigabe.Ja))" />
        </div>
    </div>
    @if (belegt < kurs.MinTeilnehmende && kurs.Status == Kursstatus.Veroeffentlicht && !kontingent)
    {
        <div class="vhs-alert vhs-warn">Mindestteilnehmerzahl noch nicht erreicht: @belegt von mindestens @kurs.MinTeilnehmende.</div>
    }
    @if (teilnehmende.Count == 0)
    {
        <p class="vhs-muted">Noch keine Anmeldungen.</p>
    }
    else
    {
        <div class="vhs-tbl">
            <table>
                <thead><tr><th>Name</th><th>Status</th><th>Weg</th><th>Gebucht</th><th>Entgelt</th>@if (kontingent) { <th>Kontingent</th> }</tr></thead>
                <tbody>
                    @foreach (var t in teilnehmende.Where(t => alleBelegungen || t.Belegung.Offen))
                    {
                        var bl = t.Belegung;
                        <tr class="vhs-klickzeile" @onclick="@(() => Navigation.NavigateTo(Ruecksprung.Detail($"belegungen/{bl.Id}", Ruecksprung.Aktuell(Navigation))))">
                            <td><a href="@Ruecksprung.Detail($"belegungen/{bl.Id}", Ruecksprung.Aktuell(Navigation))" @onclick:stopPropagation="true">@t.Name</a></td>
                            <td>
                                <StatusPille Stil="@(bl.Status == VibeVHS.Domain.Anmeldung.Belegungsstatus.Angemeldet ? "gut" : bl.Offen ? "warn" : "neutral")">@VibeVHS.Domain.Anmeldung.BelegungAnzeige.Status(bl.Status)@(t.Warteplatz is { } wp ? $" ({wp})" : "")</StatusPille>
                                @if (bl.AngebotBis is { } ab) { <span class="vhs-small vhs-muted">bis @ab.ToLocalTime().ToString("dd.MM. HH:mm")</span> }
                            </td>
                            <td class="vhs-small">@VibeVHS.Domain.Anmeldung.BelegungAnzeige.Weg(bl.Weg)@(bl.BevollmaechtigterName is { } bv ? $" · für {bv}" : "")</td>
                            <td class="vhs-small">@bl.GebuchtAm.ToLocalTime().ToString("dd.MM.yyyy") · @bl.GebuchtVon</td>
                            <td class="vhs-mono">@bl.Entgelt@(bl.Ermaessigt ? " erm." : "")</td>
                            @if (kontingent)
                            {
                                var s = bl.Kontingent;
                                <td class="vhs-small">@(bl.KontingentAnzahl is null ? "–" : $"{s.Besucht} besucht · {s.Verfallen} verfallen · {s.Eingebucht} eingebucht · {s.Verbleibend} übrig")</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <label class="vhs-small"><input type="checkbox" @bind="alleBelegungen" /> auch stornierte und umgebuchte zeigen</label>
        @if (kontingent)
        {
            <p class="vhs-small vhs-muted">Regel dieses Kurses: Einbuchen bis @kurs.Richtlinie.EinbuchungsfristStunden Stunden vorher, Austragen bis @kurs.Richtlinie.AustragefristStunden Stunden vorher. Nichterscheinen @(kurs.Richtlinie.NichterscheinenZaehlt ? "verbraucht die Einheit" : "wird nicht angerechnet").</p>
        }
    }
</section>

@code {
    [Inject]
    private NavigationManager Navigation { get; set; } = default!;

    // Dozierendenteam und Qualifikationen
    private IReadOnlyDictionary<Guid, Tageseignung> betroffen = new Dictionary<Guid, Tageseignung>();
    private IReadOnlyList<Dozenteneignung> teamEignung = [];
    private Dictionary<Guid, VibeVHS.Domain.Personen.Person> teamPersonen = [];
    private IReadOnlyList<Qualifikationsausnahme> ausnahmen = [];
    private IReadOnlyList<DozentOption> teamTreffer = [];
    private string? teamSuche, ausnahmeText;
    private Guid? aDozent;

    private DateOnly AenderungsTag => modus == "folgende" ? gewaehlt?.Datum ?? aDatum : aDatum;

    private Tageseignung? EignungAm(Guid personId, DateOnly tag)
        => kurs is null || kurs.BenoetigteDozierendenmerkmale.Count == 0 || !teamPersonen.TryGetValue(personId, out var p)
            ? null
            : Dozentenpruefung.AmTag(p, kurs.BenoetigteDozierendenmerkmale, verzeichnis!.Katalog, tag, Uhr.GetLocalNow(), ausnahmen);

    private async Task QualifikationenLadenAsync(IServiceProvider d)
    {
        var q = d.GetRequiredService<QualifikationsDienst>();
        betroffen = await q.BetroffeneVeranstaltungenAsync(kurs!);
        teamEignung = await q.TeamEignungAsync(kurs!);
        ausnahmen = await q.AusnahmenAsync(kurs!.Id);
        teamPersonen = (await d.GetRequiredService<VibeVHS.Application.Personen.IPersonenSpeicher>().LadenAsync(kurs.Team.Select(t => t.PersonId)))
            .ToDictionary(p => p.Id);
    }

    private async Task TeamSuchenAsync()
    {
        var tage = kurs!.Veranstaltungen.Where(v => !v.Ausgefallen && v.Ende >= Uhr.GetLocalNow().LocalDateTime).Select(v => v.Datum).Distinct().ToList();
        teamTreffer = await Vorgang.AusfuehrenAsync(d => d.GetRequiredService<QualifikationsDienst>().DozentenauswahlAsync(teamSuche, kurs.BenoetigteDozierendenmerkmale, tage, Id));
    }

    private async Task QualiAktionAsync(Func<QualifikationsDienst, Task> aktion, string meldung)
    {
        try
        {
            await Vorgang.AusfuehrenAsync(d => aktion(d.GetRequiredService<QualifikationsDienst>()));
            Hinweise.Notify(NotificationSeverity.Success, "Gespeichert", meldung);
            await LadenAsync();
            if (!string.IsNullOrWhiteSpace(teamSuche))
            {
                await TeamSuchenAsync();
            }
        }
        catch (InvalidOperationException ex)
        {
            Hinweise.Notify(NotificationSeverity.Error, "Nicht möglich", ex.Message);
        }
    }

    private Task AusnahmeAsync(Guid personId, Dozenteneignung e)
        => QualiAktionAsync(q => q.AusnahmeErteilenAsync(Id, personId, e.Tage.SelectMany(t => t.Fehlend), ausnahmeText!), "Ausnahme erteilt und protokolliert.");

    private Task TeamHinzufuegenAsync(DozentOption o, string? begruendung)
        => QualiAktionAsync(q => q.TeamHinzufuegenAsync(Id, o.Person.Id, kurs!.Team.Count == 0, begruendung), $"{o.Person.Anzeigename} ist im Dozierendenteam.");

    private Task TeamEntfernenAsync(Guid personId) => QualiAktionAsync(q => q.TeamEntfernenAsync(Id, personId), "Aus dem Team entfernt.");

    private IReadOnlyList<VibeVHS.Application.Anmeldung.TeilnehmerZeile> teilnehmende = [];
    private VibeVHS.Application.Anmeldung.Einbuchungslage lage = new(new Dictionary<(Guid, Guid?), int>(), new Dictionary<Guid, int>());
    private bool alleBelegungen;

    private async Task SelbstCheckinAsync(ChangeEventArgs e)
    {
        if (Enum.TryParse<SelbstCheckin>(e.Value?.ToString(), out var wert))
        {
            await Vorgang.AusfuehrenAsync(d => d.GetRequiredService<ProgrammDienst>().SelbstCheckinSetzenAsync(Id, wert));
            Hinweise.Notify(NotificationSeverity.Success, "Gespeichert", $"Selbst-Check-in: {SelbstCheckinAnzeige.Text(wert)}.");
            await LadenAsync();
        }
    }

    private async Task NachrueckenAsync()
    {
        var n = await Vorgang.AusfuehrenAsync(d => d.GetRequiredService<VibeVHS.Application.Anmeldung.AnmeldungDienst>().NachrueckenAnbietenAsync(Id));
        Hinweise.Notify(NotificationSeverity.Success, "Warteliste", $"{n} Nachrückangebot(e) mit Annahmefrist verschickt.");
        await LadenAsync();
    }

    [Parameter]
    public Guid Id { get; set; }

    [SupplyParameterFromQuery(Name = "neu")]
    private int? Neu { get; set; }

    private Kurs? kurs;
    private Namen namen = Namen.Leer;
    private Ortsverzeichnis? verzeichnis;
    private IReadOnlyList<Ort> buchbareOrte = [];
    private IReadOnlyList<Konflikt> konflikte = [];
    private Veranstaltung? gewaehlt;
    private Veranstaltung? nachrichtTermin;
    private string? nachrichtBetreff, nachrichtText;

    private Freigabe NachrichtFreigabe => Freigabe.NurFuer(rolle, Terminnachricht.Rollen)
        .Und(() => string.IsNullOrWhiteSpace(nachrichtBetreff) || string.IsNullOrWhiteSpace(nachrichtText)
            ? Freigabe.Nein("Bitte Betreff und Text eingeben.")
            : Freigabe.Ja);
    private Rolle? rolle;
    private string modus = "einzeln";
    private DateOnly aDatum = DateOnly.FromDateTime(DateTime.Today);
    private string aBeginn = "18:00";
    private int aDauer = 90;
    private Guid aOrt;
    private string? aBemerkung;
    private IReadOnlyList<NaechsterSchritt> folgeschritte = [];

    private string? kursSprache;

    private string? AktuelleSprache => kurs?.BenoetigteDozierendenmerkmale.Select(VibeVHS.Domain.Programm.Anforderung.Zerlegen)
        .FirstOrDefault(a => a.Schluessel == VibeVHS.Domain.Programm.Sprachfreigabe.Schluessel).Wert;

    private Freigabe Planen => kurs?.Archiviert == true
        ? Freigabe.Nein("Der Kurs ist archiviert und schreibgeschützt. Bitte zuerst wiederherstellen.")
        : Freigabe.NurFuer(rolle, Rolle.Fachbereichsleitung, Rolle.Leitung);

    private async Task WiederherstellenAsync()
    {
        await Vorgang.AusfuehrenAsync(d => d.GetRequiredService<VibeVHS.Application.Datenschutz.DatenschutzDienst>().KursWiederherstellenAsync(Id));
        await LadenAsync();
    }

    private Freigabe VeroeffentlichenFreigabe => Planen.Und(() => kurs!.Status == Kursstatus.Veroeffentlicht
        ? Freigabe.Nein("Der Kurs ist bereits veröffentlicht.")
        : kurs.Veranstaltungen.Count == 0 ? Freigabe.Nein("Ohne Veranstaltungen kann der Kurs nicht veröffentlicht werden.") : Freigabe.Ja);

    private Freigabe AbsagenFreigabe => Planen.Und(() => kurs!.Status == Kursstatus.Abgesagt ? Freigabe.Nein("Der Kurs ist bereits abgesagt.") : Freigabe.Ja);

    private bool absageOffen;
    private string? absageGrund;
    private bool absageLaeuft;

    private Freigabe AbsageBestaetigenFreigabe => AbsagenFreigabe.Und(() => string.IsNullOrWhiteSpace(absageGrund)
        ? Freigabe.Nein("Bitte zuerst einen Grund eingeben – er steht in der Absage an die Teilnehmenden.")
        : Freigabe.Ja);

    private async Task AbsagenAsync()
    {
        absageLaeuft = true;
        try
        {
            var n = await Vorgang.AusfuehrenAsync(d => d.GetRequiredService<VibeVHS.Application.Anmeldung.AnmeldungDienst>().KursAbsagenAsync(Id, absageGrund!.Trim()));
            absageOffen = false;
            await LadenAsync();
            Hinweise.Notify(NotificationSeverity.Success, "Kurs abgesagt", n == 0 ? "Es gab keine offenen Belegungen." : $"{n} Absage(n) liegen im Postausgang.");
            folgeschritte = [new("Postausgang ansehen", "postausgang", "Absagen mit Übersetzungslink", Hauptschritt: n > 0), new("Raumplan ansehen", "raumplan"), new("Protokoll ansehen", "protokoll")];
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException)
        {
            Hinweise.Notify(NotificationSeverity.Error, "Nicht abgesagt", ex.Message);
        }
        finally
        {
            absageLaeuft = false;
        }
    }

    private Freigabe AendernFreigabe => Planen.Und(() =>
        !TimeOnly.TryParse(aBeginn, out _) ? Freigabe.Nein("Beginn bitte als hh:mm eingeben.")
        : modus != "zusatz" && gewaehlt is null ? Freigabe.Nein("Bitte unten den Termin anklicken, der geändert werden soll.")
        : aOrt == Guid.Empty ? Freigabe.Nein("Bitte einen Ort wählen.")
        : aDozent is { } dz && EignungAm(dz, AenderungsTag) is { Geeignet: false } e ? Freigabe.Nein($"Die gewählte Person darf am {AenderungsTag:dd.MM.yyyy} nicht eingesetzt werden: {e.Begruendung}")
        : Freigabe.Ja);

    private string SerieText => kurs?.Serie is not { } s ? "keine (nur Einzeltermine)"
        : $"{string.Join("/", s.Wochentage.Select(KursAnzeige.Wochentag))} {s.Beginn:HH\\:mm}, {s.DauerMinuten} Min., ab {s.Start:dd.MM.yyyy}, "
          + (s.Unbefristet ? $"unbefristet (erzeugt bis {kurs.ErzeugtBis:dd.MM.yyyy}, rollierend)" : s.Anzahl is { } a ? $"{a} Termine" : $"bis {s.Ende:dd.MM.yyyy}")
          + (s.FerienAuslassen ? ", pausiert in den Schulferien" : ", läuft in den Schulferien weiter") + ", Feiertage ausgelassen";

    protected override async Task OnParametersSetAsync()
    {
        rolle = (await Vorgang.BenutzerAsync()).Rolle;
        await LadenAsync();
        if (Neu == 1)
        {
            folgeschritte =
            [
                new("Kurs veröffentlichen", "#", Freigabe: VeroeffentlichenFreigabe, Hauptschritt: true),
                new("Raumplan prüfen", "raumplan"),
                new("Weiteren Kurs anlegen", "kurse/neu"),
            ];
        }
    }

    private async Task LadenAsync()
    {
        await Vorgang.AusfuehrenAsync(async d =>
        {
            var p = d.GetRequiredService<IProgrammSpeicher>();
            kurs = await p.KursLadenAsync(Id);
            namen = kurs is null ? Namen.Leer : await p.FuerKurseAsync([kurs]);
            verzeichnis = await p.OrtsverzeichnisAsync();
            teilnehmende = await d.GetRequiredService<VibeVHS.Application.Anmeldung.AnmeldungDienst>().TeilnehmendeAsync(Id);
            lage = VibeVHS.Application.Anmeldung.Einbuchungslage.Berechnen(teilnehmende.Select(t => t.Belegung));
            if (kurs is not null)
            {
                kursSprache = AktuelleSprache;
                await QualifikationenLadenAsync(d);
            }
            if (kurs is { Veranstaltungen.Count: > 0 })
            {
                var von = kurs.Veranstaltungen.Min(v => v.Beginn);
                var bis = kurs.Veranstaltungen.Max(v => v.Ende);
                var termine = await p.TermineAsync(von, bis);
                konflikte = Konfliktpruefung.Finden(termine.Select(t => t.Termin), id => verzeichnis.Finden(id)?.Exklusiv ?? false)
                    .Where(k => k.A.KursId == Id || k.B.KursId == Id).ToList();
            }
        });
        buchbareOrte = verzeichnis?.Alle.Where(o => o.Buchbar).OrderBy(o => o.Anzeige).ToList() ?? [];
        if (aOrt == Guid.Empty && kurs?.Serie?.OrtIds.FirstOrDefault() is { } o)
        {
            aOrt = o;
        }
    }

    private void Waehlen(Veranstaltung v)
    {
        gewaehlt = v;
        aDatum = v.Datum;
        aBeginn = v.Beginn.ToString("HH:mm");
        aDauer = (int)(v.Ende - v.Beginn).TotalMinutes;
        aOrt = v.Orte.FirstOrDefault()?.OrtId ?? aOrt;
        aBemerkung = v.Bemerkung;
        aDozent = v.DozentId;
    }

    private async Task AendernAsync()
    {
        var b = TimeOnly.Parse(aBeginn, System.Globalization.CultureInfo.InvariantCulture);
        var dienst = (IServiceProvider d) => d.GetRequiredService<ProgrammDienst>();
        try
        {
            switch (modus)
            {
                case "einzeln":
                    var beginn = aDatum.ToDateTime(b);
                    await Vorgang.AusfuehrenAsync(d => dienst(d).NurDieseAendernAsync(Id, gewaehlt!.Id, beginn, beginn.AddMinutes(aDauer), [aOrt], aBemerkung, dozentId: aDozent));
                    break;
                case "folgende":
                    var regel = kurs!.Serie! with { Beginn = b, DauerMinuten = aDauer, OrtIds = [aOrt], DozentId = aDozent ?? kurs.Serie.DozentId };
                    await Vorgang.AusfuehrenAsync(d => dienst(d).SerieAendernAbAsync(Id, gewaehlt!.Datum, regel));
                    break;
                default:
                    var zusatz = aDatum.ToDateTime(b);
                    await Vorgang.AusfuehrenAsync(d => dienst(d).EinzelveranstaltungAsync(Id, zusatz, zusatz.AddMinutes(aDauer), [aOrt], dozentId: aDozent));
                    break;
            }

            Hinweise.Notify(NotificationSeverity.Success, "Gespeichert", "Die Termine wurden geändert und protokolliert.");
            gewaehlt = null;
            await LadenAsync();
            folgeschritte = [new("Raumplan prüfen", "raumplan", Hauptschritt: konflikte.Count > 0), new("Protokoll ansehen", "protokoll")];
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException)
        {
            Hinweise.Notify(NotificationSeverity.Error, "Nicht möglich", ex.Message);
        }
    }

    private async Task AusfallenAsync()
    {
        var terminId = gewaehlt!.Id;
        await Vorgang.AusfuehrenAsync(d => d.GetRequiredService<ProgrammDienst>().AusfallenLassenAsync(Id, terminId, aBemerkung ?? "ohne Angabe"));
        Hinweise.Notify(NotificationSeverity.Info, "Fällt aus", "Der Termin ist als ausgefallen markiert.");
        gewaehlt = null;
        await LadenAsync();
        // Nachricht vorbereiten: Text mit Datum und Grund, die Verwaltung kann ihn anpassen.
        nachrichtTermin = kurs?.Veranstaltungen.FirstOrDefault(v => v.Id == terminId);
        if (nachrichtTermin is not null && kurs is not null)
        {
            nachrichtBetreff = $"Termin am {nachrichtTermin.Beginn:dd.MM.yyyy} fällt aus";
            nachrichtText = Terminnachricht.AusfallText(kurs, nachrichtTermin);
        }

        folgeschritte =
        [
            new("Teilnehmende informieren", $"kurse/{Id}#teilnehmende-informieren", "Mail mit Übersetzungslink über den Postausgang, Text unten anpassen",
                Freigabe: Freigabe.NurFuer(rolle, Terminnachricht.Rollen), Hauptschritt: true),
            new("Ersatztermin anlegen", $"kurse/{Id}", "Oben „Termin hinzufügen“ wählen"),
        ];
    }

    private async Task NachrichtSendenAsync()
    {
        try
        {
            var (versandt, ohneMail) = await Vorgang.AusfuehrenAsync(d =>
                d.GetRequiredService<Terminnachricht>().SendenAsync(Id, nachrichtTermin!.Id, nachrichtBetreff!, nachrichtText!));
            Hinweise.Notify(NotificationSeverity.Success, "Nachricht eingereiht",
                $"{versandt} Mail(s) im Postausgang{(ohneMail > 0 ? $"; {ohneMail} Teilnehmende ohne E-Mail-Adresse – bitte anrufen oder anschreiben" : "")}.");
            nachrichtTermin = null;
            folgeschritte = [new("Postausgang ansehen", "postausgang", Hauptschritt: true), new("Protokoll ansehen", "protokoll")];
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException)
        {
            Hinweise.Notify(NotificationSeverity.Error, "Nicht gesendet", ex.Message);
        }
    }

    private async Task StatusAsync(Kursstatus status)
    {
        await Vorgang.AusfuehrenAsync(d => d.GetRequiredService<ProgrammDienst>().StatusSetzenAsync(Id, status));
        await LadenAsync();
        folgeschritte = [new("Person anmelden", $"anmeldung?kurs={Id}", Hauptschritt: true), new("Zur Kursliste", "kurse")];
    }
}
