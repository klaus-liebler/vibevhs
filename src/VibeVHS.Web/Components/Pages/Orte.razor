@page "/orte"
@using VibeVHS.Application.Programm
@using VibeVHS.Domain.Aufgaben
@using VibeVHS.Domain.Programm
@inject Vorgang Vorgang
@inject TimeProvider Uhr
@inject NavigationManager Navigation
@inject NotificationService Hinweise

<PageTitle>Orte · VibeVHS</PageTitle>

<div class="vhs-head">
    <div>
        <h1>Orte</h1>
        <p class="vhs-sub">Liegenschaft › Gebäude › Raum, dazu Treffpunkte und virtuelle Räume. Merkmale werden vom Gebäude auf die Räume vererbt.</p>
    </div>
    <div class="vhs-row">
        <RadzenButton Text="Raumplan" Icon="calendar_view_week" ButtonStyle="ButtonStyle.Light" Click="@(() => Navigation.NavigateTo("raumplan"))" />
    </div>
</div>

@foreach (var a in aufgaben)
{
    <div class="vhs-alert vhs-warn"><b>Aufgabe:</b> @a.Titel (fällig @a.Faellig.ToString("dd.MM.yyyy")) – @a.Beschreibung <a href="@a.Ziel">öffnen</a></div>
}

<div class="vhs-split">
    <section class="vhs-card">
        <h2>Alle Orte</h2>
        @if (verzeichnis is not null)
        {
            var ortsmerkmale = verzeichnis.Katalog.Values.Where(k => k.Bezug == MerkmalBezug.Ort && k.AlsBedingung).OrderBy(k => k.Gruppe).ThenBy(k => k.Name).ToList();
            <details class="vhs-filterbox" open="@(filter.Count > 0)">
                <summary><b>Räume filtern</b> <span class="vhs-small vhs-muted">nach Merkmalen am @tag.ToString("dd.MM.yyyy")@(filter.Count > 0 ? $" · {filter.Count} Filter aktiv" : "")</span></summary>
                <div class="vhs-filter">
                    @foreach (var k in ortsmerkmale.Where(k => k.Typ == Merkmalstyp.JaNein))
                    {
                        <button class="vhs-chip @(filter.Contains(k.Schluessel) ? "on" : "")" aria-pressed="@(filter.Contains(k.Schluessel) ? "true" : "false")" @onclick="@(() => Umschalten(k.Schluessel))">@k.Name</button>
                    }
                </div>
                @foreach (var k in ortsmerkmale.Where(k => k.Typ == Merkmalstyp.Auswahl))
                {
                    <div class="vhs-filter"><span class="vhs-filter-lbl">@k.Name</span>
                        @foreach (var w in k.AktiveWerte)
                        {
                            var b = Anforderung.Bilden(k.Schluessel, w);
                            <button class="vhs-chip @(filter.Contains(b) ? "on" : "")" aria-pressed="@(filter.Contains(b) ? "true" : "false")" @onclick="@(() => Umschalten(b))">@w</button>
                        }
                    </div>
                }
                @foreach (var k in ortsmerkmale.Where(k => k.Typ == Merkmalstyp.Ganzzahl))
                {
                    <div class="vhs-filter"><span class="vhs-filter-lbl">@k.Name ab</span>
                        <RadzenNumeric TValue="int?" Value="@MindestAus(k.Schluessel)" ValueChanged="@((int? v) => MindestSetzen(k.Schluessel, v))" ShowUpDown="false" Style="width:90px"
                                       aria-label="@($"{k.Name} mindestens")" />
                        @if (k.Einheit is { } e) { <span class="vhs-small vhs-muted">@e</span> }
                    </div>
                }
                @if (filter.Count > 0)
                {
                    <button class="vhs-linkbutton" @onclick="@(() => filter.Clear())">alle Filter zurücksetzen</button>
                }
            </details>
            @if (filter.Count > 0)
            {
                var treffer = verzeichnis.Alle.Where(o => o.Buchbar && o.Aktiv && Passt(o)).OrderBy(o => verzeichnis.PfadAnzeige(o)).ToList();
                <p class="vhs-small"><b>@treffer.Count</b> passende Räume: @string.Join(", ", filter.Select(f => Anforderung.Anzeige(f, verzeichnis.Katalog)))</p>
                <ul class="vhs-baum">
                    @foreach (var o in treffer)
                    {
                        <li><a href="@($"orte?id={o.Id}")" class="@(ort?.Id == o.Id ? "on" : "")">@o.Anzeige</a> <span class="vhs-small vhs-muted">@verzeichnis.PfadAnzeige(o)</span></li>
                    }
                </ul>
            }
            else
            {
                <ul class="vhs-baum">
                    @foreach (var wurzel in verzeichnis.Alle.Where(o => o.ElternId is null).OrderBy(o => o.Art).ThenBy(o => o.Name))
                    {
                        @Knoten(wurzel)
                    }
                </ul>
            }
        }
    </section>

    <section class="vhs-card">
        @if (ort is null || verzeichnis is null)
        {
            <p class="vhs-muted">Ort links auswählen.</p>
        }
        else
        {
            <h2>@ort.Anzeige</h2>
            <p class="vhs-small vhs-muted" style="margin-top:-6px">@verzeichnis.PfadAnzeige(ort) · @OrtsartText(ort.Art)</p>

            @if (ort.Kapazitaeten.Count > 0)
            {
                <h3>Kapazität je Nutzungsart</h3>
                <div class="vhs-row">
                    @foreach (var k in ort.Kapazitaeten.OrderByDescending(k => k.Plaetze))
                    {
                        <StatusPille Stil="info">@NutzungsartAnzeige.Text(k.Nutzungsart): @k.Plaetze</StatusPille>
                    }
                </div>
            }

            <h3>Wirksame Merkmale am @tag.ToString("dd.MM.yyyy")</h3>
            <div class="vhs-row"><RadzenDatePicker TValue="DateOnly" @bind-Value="tag" DateFormat="dd.MM.yyyy" /> <span class="vhs-small vhs-muted">Stichtag ändern, z. B. für einen geplanten Kurs</span></div>
            <div class="vhs-tbl">
                <table>
                    <thead><tr><th>Merkmal</th><th>Wert / Nachweis</th><th>Herkunft</th><th>gültig bis</th></tr></thead>
                    <tbody>
                        @foreach (var w in verzeichnis.WirksameMerkmale(ort, tag, Uhr.GetLocalNow()).OrderBy(w => w.Merkmal.Gruppe))
                        {
                            var bald = w.GueltigBis is { } bis && bis <= tag.AddDays(60);
                            <tr>
                                <td>@w.Merkmal.Name <span class="vhs-small vhs-muted">(@w.Merkmal.Gruppe)</span></td>
                                <td class="vhs-small">@w.Merkmal.WertAnzeige(w.Eintrag.WertText)@if (w.Eintrag.Nachweis is { } nw) { <br /><span class="vhs-muted">Nachweis: @nw</span> }</td>
                                <td class="vhs-small">@(w.Geerbt ? $"geerbt von {w.Herkunft.Name}" : "eigenes")</td>
                                <td>@if (w.GueltigBis is { } b) { <StatusPille Stil="@(bald ? "warn" : "neutral")">@b.ToString("dd.MM.yyyy")</StatusPille> } else { <span class="vhs-muted">–</span> }</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <h3>Wegbeschreibung (automatisch)</h3>
            <pre class="vhs-code">@verzeichnis.Wegbeschreibung(ort)</pre>

            <details>
                <summary><b>Merkmal eintragen</b> <span class="vhs-small vhs-muted">– mit Nachweis und Gültigkeit, die bisherige Eintragung bleibt in der Historie</span></summary>
                <div class="vhs-fields">
                    <RadzenFormField Text="Merkmal" Variant="Variant.Outlined">
                        <RadzenDropDown TValue="string" @bind-Value="mSchluessel" @bind-Value:after="@(() => mWert = null)" Data="@verzeichnis.Katalog.Values.Where(k => k.Bezug == MerkmalBezug.Ort).OrderBy(k => k.Gruppe).ThenBy(k => k.Name)" TextProperty="Name" ValueProperty="Schluessel" />
                    </RadzenFormField>
                    <MerkmalWertEingabe Merkmal="@(mSchluessel is null ? null : verzeichnis.Katalog.GetValueOrDefault(mSchluessel))" @bind-Wert="mWert" />
                    <RadzenFormField Text="Nachweis" Variant="Variant.Outlined"><RadzenTextBox @bind-Value="mNachweis" Placeholder="z. B. BAMF-Schreiben vom …" /></RadzenFormField>
                    <RadzenFormField Text="gültig ab" Variant="Variant.Outlined"><RadzenDatePicker TValue="DateOnly" @bind-Value="mAb" DateFormat="dd.MM.yyyy" /></RadzenFormField>
                    <RadzenFormField Text="gültig bis (leer = unbefristet)" Variant="Variant.Outlined"><RadzenDatePicker TValue="DateOnly?" @bind-Value="mBis" DateFormat="dd.MM.yyyy" /></RadzenFormField>
                </div>
                <BegruendeterButton Text="Eintragen" Icon="save" Click="MerkmalSpeichernAsync" Freigabe="@MerkmalFreigabe" />
            </details>

            <h3>Nächste Belegungen</h3>
            <div class="vhs-list">
                @if (belegungen.Count == 0)
                {
                    <div class="vhs-small vhs-muted">In den nächsten 14 Tagen keine Veranstaltungen.</div>
                }
                @foreach (var b in belegungen)
                {
                    <div><span class="vhs-mono vhs-small vhs-zeit">@b.Termin.Beginn.ToString("ddd dd.MM. HH:mm")</span><span class="vhs-grow"><a href="@($"kurse/{b.Termin.KursId}")">@b.Kursnummer @b.Termin.Kurs</a></span></div>
                }
            </div>
        }
    </section>
</div>

<details class="vhs-card">
    <summary><b>Merkmalskatalog</b> <span class="vhs-small vhs-muted">– Werttyp je Merkmal (Ja/Nein, Auswahl, Ganzzahl, Text); vererbbare Merkmale gelten auch für Räume im Gebäude</span></summary>
    <MerkmalKatalogPflege Bezug="MerkmalBezug.Ort" Rolle="@rolle" Geaendert="LadenAsync" />
</details>

<details class="vhs-card">
    <summary><b>Kursarten: Anforderungen an Räume</b> <span class="vhs-small vhs-muted">– z. B. „mind. 12 PC-Arbeitsplätze“; die Raumauswahl nennt konkret, was fehlt</span></summary>
    <KursartOrtsbedingungen Rolle="@rolle" />
</details>

@code {
    [SupplyParameterFromQuery(Name = "id")]
    private Guid? OrtId { get; set; }

    private Ortsverzeichnis? verzeichnis;
    private Ort? ort;
    private DateOnly tag = DateOnly.FromDateTime(DateTime.Today);
    private IReadOnlyList<PlanTermin> belegungen = [];
    private IReadOnlyList<Aufgabe> aufgaben = [];
    private Rolle? rolle;
    private string? mSchluessel, mWert, mNachweis;

    /// <summary>Aktive Filter als Bedingungen („beamer“, „tafel=Smartboard“, „pc&gt;=12“).</summary>
    private readonly List<string> filter = [];

    private void Umschalten(string bedingung)
    {
        if (!filter.Remove(bedingung))
        {
            filter.Add(bedingung);
        }
    }

    private int? MindestAus(string schluessel)
        => filter.Select(Anforderung.Lesen).FirstOrDefault(b => b.Schluessel == schluessel && b.Vergleich == Vergleich.Mindestens) is { } b
           && int.TryParse(b.Wert, out var n) ? n : null;

    private void MindestSetzen(string schluessel, int? wert)
    {
        filter.RemoveAll(f => Anforderung.Lesen(f) is { Vergleich: Vergleich.Mindestens } b && b.Schluessel == schluessel);
        if (wert is { } n)
        {
            filter.Add(Anforderung.Mindestens(schluessel, n));
        }
    }

    /// <summary>Erfüllt der Ort am Stichtag alle Filterbedingungen (auch geerbte Merkmale zählen)?</summary>
    private bool Passt(Ort o)
    {
        var wirksam = verzeichnis!.WirksameMerkmale(o, tag, Uhr.GetLocalNow());
        return filter.All(f =>
        {
            var s = Anforderung.Basis(f);
            var w = wirksam.FirstOrDefault(x => x.Merkmal.Schluessel == s);
            return w is not null && Anforderung.Abweichung(f, w.Merkmal, w.Eintrag.WertText) is null;
        });
    }
    private DateOnly mAb = DateOnly.FromDateTime(DateTime.Today);
    private DateOnly? mBis;

    private Freigabe Pflegen => Freigabe.NurFuer(rolle, Rolle.Verwaltungsleitung, Rolle.Leitung, Rolle.Systemverwaltung, Rolle.IntegrationskursTeam);

    private Freigabe MerkmalFreigabe => Pflegen.Und(() => mSchluessel is null ? Freigabe.Nein("Bitte ein Merkmal wählen.")
        : verzeichnis!.Katalog[mSchluessel].NachweisPflicht && string.IsNullOrWhiteSpace(mNachweis) ? Freigabe.Nein("Für dieses Merkmal ist ein Nachweis Pflicht (z. B. Zulassungsschreiben).")
        : !ort!.Buchbar && ort.Art != Ortsart.Gebaeude && ort.Art != Ortsart.Liegenschaft ? Freigabe.Nein("Für diesen Ort können keine Merkmale gepflegt werden.")
        : Freigabe.Ja);


    protected override async Task OnParametersSetAsync()
    {
        rolle = (await Vorgang.BenutzerAsync()).Rolle;
        await LadenAsync();
    }

    private async Task LadenAsync()
    {
        await Vorgang.AusfuehrenAsync(async d =>
        {
            var p = d.GetRequiredService<IProgrammSpeicher>();
            verzeichnis = await p.OrtsverzeichnisAsync();
            aufgaben = (await d.GetRequiredService<VibeVHS.Application.Aufgaben.IAufgabenSpeicher>().OffeneAsync())
                .Where(a => a.Ziel?.StartsWith("orte", StringComparison.Ordinal) == true).OrderBy(a => a.Faellig).ToList();
            ort = OrtId is { } id ? verzeichnis.Finden(id) : null;
            if (ort is not null)
            {
                var ids = verzeichnis.Alle.Where(o => verzeichnis.Pfad(o).Any(x => x.Id == ort.Id)).Select(o => o.Id).ToHashSet();
                belegungen = (await p.TermineAsync(DateTime.Today, DateTime.Today.AddDays(14))).Where(t => t.Termin.OrtIds.Any(ids.Contains)).Take(20).ToList();
            }
        });
    }

    private RenderFragment Knoten(Ort o) => __builder =>
    {
        <li>
            <a href="@($"orte?id={o.Id}")" class="@(ort?.Id == o.Id ? "on" : "")">@o.Anzeige</a>
            <span class="vhs-small vhs-muted">@OrtsartText(o.Art)@(o.Stadt is null ? "" : $" · {o.Stadt}")</span>
            @if (verzeichnis!.Kinder(o.Id).Any())
            {
                <ul>
                    @foreach (var k in verzeichnis.Kinder(o.Id))
                    {
                        @Knoten(k)
                    }
                </ul>
            }
        </li>
    };

    private static string OrtsartText(Ortsart a) => a switch
    {
        Ortsart.Gebaeude => "Gebäude",
        Ortsart.AllgemeinerOrt => "Treffpunkt",
        Ortsart.VirtuellerRaum => "virtueller Raum",
        _ => a.ToString(),
    };

    private async Task MerkmalSpeichernAsync()
    {
        try
        {
            await Vorgang.AusfuehrenAsync(d => d.GetRequiredService<ProgrammDienst>().MerkmalSetzenAsync(ort!.Id, mSchluessel!, mWert, mNachweis, mAb, mBis));
            Hinweise.Notify(NotificationSeverity.Success, "Eingetragen", "Das Merkmal ist eingetragen und protokolliert.");
            mWert = mNachweis = null;
            mBis = null;
            await LadenAsync();
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException)
        {
            Hinweise.Notify(NotificationSeverity.Error, "Nicht möglich", ex.Message);
        }
    }

}
