@page "/anmelden"
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@layout LeeresLayout
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@using VibeVHS.Adapters.Mocks
@using VibeVHS.Application.Stammdaten
@using VibeVHS.Domain.Stammdaten
@inject NavigationManager Navigation
@inject Zugangsschutz Schutz
@inject IBenutzerkonten Konten
@inject IStammdaten Stammdaten
@inject ILogger<Anmelden> Log

<PageTitle>Anmelden · VibeVHS</PageTitle>

<div class="vhs-login">
    <div class="vhs-brand"><b>VibeVHS</b><span>@(einrichtung?.Name ?? "Volkshochschule")</span></div>
    <h1>Anmelden</h1>
    <div class="vhs-alert vhs-warn">
        <b>Testanmeldung.</b> Wählen Sie Ihr Konto. Haben Sie mehrere Rollen, wechseln Sie die aktive Rolle nach der
        Anmeldung oben rechts. Im Betrieb ersetzt die Anmeldung über die kommunale Benutzerverwaltung (OIDC/SAML) diese Seite.
    </div>

    @if (!Schutz.AnmeldungEingerichtet)
    {
        <div class="vhs-alert vhs-crit" role="alert">
            Die Anmeldung ist auf diesem System noch nicht eingerichtet: Es ist kein Zugangscode hinterlegt
            (Umgebungsvariable <code>Anmeldung__Zugangscode</code>).
        </div>
        return;
    }

    @if (Fehler is not null)
    {
        <div class="vhs-alert vhs-crit" role="alert">@Fehler</div>
    }

    @if (konten.Count == 0)
    {
        <div class="vhs-alert vhs-crit" role="alert">
            Es sind noch keine Benutzerkonten angelegt. Die Startdaten (<code>Startdaten:Datei</code>) wurden nicht gefunden.
        </div>
    }

    <form method="post" @formname="anmelden" @onsubmit="AnmeldenAsync">
        <AntiforgeryToken />
        @if (Schutz.ZugangscodeNoetig)
        {
            <div class="vhs-field" style="max-width:320px">
                <label class="vhs-lbl" for="zugangscode">Zugangscode für das Testsystem</label>
                <input id="zugangscode" name="Zugangscode" type="password" autocomplete="current-password" required class="vhs-input" />
            </div>
        }
        <div class="vhs-list">
            @foreach (var konto in konten)
            {
                <div>
                    <span class="vhs-grow">
                        <b>@konto.Name</b>@if (konto.Funktion is not null) { <span class="vhs-muted"> · @konto.Funktion</span> }
                        <br />
                        <span class="vhs-row" style="gap:4px;margin-top:4px">
                            @foreach (var rolle in konto.Rollen)
                            {
                                <StatusPille Stil="info">@rolle.Anzeigename()</StatusPille>
                            }
                            @foreach (var nr in konto.Fachbereiche)
                            {
                                <span class="vhs-pill vhs-p-neutral" title="@FachbereichName(nr)">FB @nr</span>
                            }
                        </span>
                        @if (konto.Fachbereiche.Count > 0)
                        {
                            <span class="vhs-small vhs-muted">@string.Join("; ", konto.Fachbereiche.Select(FachbereichName))</span>
                        }
                    </span>
                    <button type="submit" name="Login" value="@konto.Login" class="vhs-btn">Anmelden</button>
                </div>
            }
        </div>
    </form>
    <p class="vhs-small vhs-muted">
        Die Testkonten stammen von der öffentlichen Teamseite der vhs (nur Name und Zuständigkeit, keine Kontaktdaten).
        Die Rollenzuordnung ist abgeleitet und noch zu bestätigen.
    </p>
</div>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "anmelden")]
    private string? Login { get; set; }

    [SupplyParameterFromForm(FormName = "anmelden")]
    private string? Zugangscode { get; set; }

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    private string? Fehler { get; set; }

    private IReadOnlyList<Benutzerkonto> konten = [];
    private IReadOnlyList<Fachbereich> fachbereiche = [];
    private Einrichtung? einrichtung;

    protected override async Task OnInitializedAsync()
    {
        // Portal-Konten von Teilnehmenden (beim Anmeldelink angelegt) nicht in der Testanmeldung zeigen – nur das Demokonto.
        konten = (await Konten.AlleAsync()).Where(k => !(k.Rollen.Count == 1 && k.Rollen[0] == Rolle.Teilnehmende) || (k.Hinweis?.Contains("Demo", StringComparison.Ordinal) ?? false)).ToList();
        fachbereiche = await Stammdaten.FachbereicheAsync();
        einrichtung = await Stammdaten.EinrichtungAsync();
    }

    private string FachbereichName(int nr) => fachbereiche.FirstOrDefault(f => f.Nr == nr)?.Anzeige ?? $"FB {nr}";

    private async Task AnmeldenAsync()
    {
        if (!Schutz.ZugangscodePruefen(Zugangscode))
        {
            Log.LogWarning("Testanmeldung mit falschem Zugangscode abgelehnt");
            await Task.Delay(TimeSpan.FromSeconds(1));
            Fehler = "Der Zugangscode stimmt nicht.";
            return;
        }

        if (string.IsNullOrWhiteSpace(Login) || await Konten.FindenAsync(Login) is not { } konto)
        {
            Fehler = "Dieses Konto gibt es nicht.";
            return;
        }

        var principal = MockAnmeldung.Anmelden(konto.AlsBenutzer(), CookieAuthenticationDefaults.AuthenticationScheme);
        await HttpContext.SignInAsync(CookieAuthenticationDefaults.AuthenticationScheme, principal);
        Log.LogInformation("Testanmeldung: {Login}", konto.Login);
        Navigation.NavigateTo(SicheresZiel(ReturnUrl));
    }

    private static string SicheresZiel(string? ziel)
        => !string.IsNullOrEmpty(ziel) && ziel.StartsWith('/') && !ziel.StartsWith("//", StringComparison.Ordinal)
           && !ziel.StartsWith("/anmelden", StringComparison.OrdinalIgnoreCase)
            ? ziel.TrimStart('/')
            : "./";
}
