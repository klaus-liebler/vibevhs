@page "/personen/{Id:guid}/historie"
@using VibeVHS.Application.Personen
@using VibeVHS.Domain.Gemeinsam
@using VibeVHS.Domain.Personen
@inject Vorgang Vorgang
@inject TimeProvider Uhr
@inject NavigationManager Navigation
@inject NotificationService Hinweise

<PageTitle>Datenhistorie · VibeVHS</PageTitle>

@if (person is null)
{
    <h1>Person nicht gefunden</h1>
    <NaechsteSchritte Schritte="@([new NaechsterSchritt("Zur Personenliste", "personen", Hauptschritt: true)])" />
    return;
}

<div class="vhs-head">
    <div>
        <h1>Datenhistorie</h1>
        <p class="vhs-sub">@heute?.NameMitTitel · alle Stammdaten, neueste Erfassung oben. Nichts wird gelöscht oder überschrieben.</p>
    </div>
    <div class="vhs-row">
        <RadzenButton Text="Zurück zur Person" Icon="arrow_back" ButtonStyle="ButtonStyle.Light"
                      Click="@(() => Navigation.NavigateTo($"personen/{Id}"))" />
    </div>
</div>

<NaechsteSchritte Schritte="@folgeschritte" />

<section class="vhs-card" id="stand">
    <h2>Stichtag</h2>
    <p class="vhs-small vhs-muted" style="margin:-6px 0 0">
        Wie war der Stand am …, und was war dazu am … bekannt? So arbeitet z. B. der Nachdruck eines alten Briefs.
    </p>
    <div class="vhs-fields">
        <RadzenFormField Text="Wie war der Stand am" Variant="Variant.Outlined">
            <RadzenDatePicker TValue="DateOnly?" @bind-Value="stichtag" DateFormat="dd.MM.yyyy" />
        </RadzenFormField>
        <RadzenFormField Text="Was war bekannt am" Variant="Variant.Outlined">
            <RadzenDatePicker TValue="DateTime?" @bind-Value="wissensstand" DateFormat="dd.MM.yyyy HH:mm" ShowTime="true" />
        </RadzenFormField>
    </div>
    @if (StandAmStichtag is { } s)
    {
        @if (s.Name is null)
        {
            <div class="vhs-alert vhs-info">Zu diesem Stichtag und Wissensstand war die Person noch nicht erfasst.</div>
        }
        else
        {
            <StammdatenKompakt Stand="@s" />
        }
    }
</section>

<section class="vhs-card">
    <div class="vhs-head">
        <h2>Zeitleiste</h2>
        <label class="vhs-small"><input type="checkbox" @bind="ersetzteZeigen" /> ersetzte Erfassungen anzeigen</label>
    </div>
    <div class="vhs-chips" role="group" aria-label="Nach Datenart filtern">
        <button class="vhs-chip @(filter.Count == 0 ? "on" : "")" @onclick="@(() => filter.Clear())">Alle (@Sichtbar(alle: true).Count)</button>
        @foreach (var art in Datenhistorie.Datenarten)
        {
            var anzahl = eintraege.Count(e => e.Datenart == art && (ersetzteZeigen || !e.Ersetzt));
            <button class="vhs-chip @(filter.Contains(art) ? "on" : "")" disabled="@(anzahl == 0)"
                    title="@(anzahl == 0 ? $"Keine Einträge zu {art}" : null)"
                    @onclick="@(() => Umschalten(art))">@art (@anzahl)</button>
        }
    </div>

    <ol class="vhs-timeline">
        @foreach (var e in Sichtbar())
        {
            <li class="@(e.Ersetzt ? "vhs-tl-ersetzt" : "")">
                <div class="vhs-tl-kopf">
                    <span class="vhs-mono vhs-small">@e.ErfasstAm.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
                    <span class="vhs-pill vhs-p-neutral">@e.Feld</span>
                    <StatusPille Stil="@ArtStil(e.Art)">@e.ArtAnzeige</StatusPille>
                    @if (e.Ersetzt)
                    {
                        <span class="vhs-small vhs-muted vhs-why" tabindex="0"
                              data-why="Diese Erfassung wurde später ersetzt (z. B. durch eine Korrektur). Sie bleibt sichtbar, damit alte Ausdrucke nachvollziehbar sind.">ersetzt am @e.ErsetztAm!.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
                    }
                </div>
                <div class="vhs-tl-wert">
                    @if (e.AlterWert is not null)
                    {
                        <span class="vhs-alt">@Anzeige(e, e.AlterWert)</span>
                        <span aria-label="wird zu"> → </span>
                    }
                    <b>@Anzeige(e, e.NeuerWert)</b>
                </div>
                <div class="vhs-row" style="justify-content:space-between">
                    <span class="vhs-small vhs-muted">gültig @Zeitraum(e.GueltigVon, e.GueltigBis) · erfasst von @e.ErfasstVon · @e.Grund</span>
                    <BegruendeterButton Text="Datum korrigieren" Icon="edit_calendar" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light"
                                        Freigabe="@KorrekturFreigabe(e)" Click="@(() => KorrekturOeffnen(e))" />
                </div>
                @if (korrekturFuer == e)
                {
                    <div class="vhs-card vhs-einschub" aria-label="Datum korrigieren">
                        <b>Datum korrigieren: @e.Feld</b>
                        <p class="vhs-small vhs-muted" style="margin:4px 0">
                            Das Datum war falsch erfasst. Die bisherigen Angaben bleiben als ersetzt sichtbar; @(e.Korrektur == Stammdatenaenderung.Datumskorrektur.Umzug
                                ? "die vorherige Adresse und das Kennzeichen „üblicher Aufenthaltsort“ werden mit korrigiert."
                                : "die angrenzende Angabe wird mit verschoben.")
                        </p>
                        @if (e.Korrektur != Stammdatenaenderung.Datumskorrektur.Umzug && e.GueltigBis is not null)
                        {
                            <div class="vhs-row">
                                <label class="vhs-small"><input type="radio" name="grenze" checked="@(!korrekturEnde)" @onchange="@(() => { korrekturEnde = false; korrekturNeu = e.GueltigVon; })" /> Beginn (gültig ab @e.GueltigVon.ToString("dd.MM.yyyy"))</label>
                                <label class="vhs-small"><input type="radio" name="grenze" checked="@korrekturEnde" @onchange="@(() => { korrekturEnde = true; korrekturNeu = e.GueltigBis!.Value.AddDays(-1); })" /> Ende (gültig bis @e.GueltigBis.Value.AddDays(-1).ToString("dd.MM.yyyy"))</label>
                            </div>
                        }
                        <div class="vhs-fields">
                            <RadzenFormField Text="@(korrekturEnde ? "Richtig: gültig bis (einschließlich)" : "Richtig: gültig ab")" Variant="Variant.Outlined">
                                <RadzenDatePicker TValue="DateOnly" @bind-Value="korrekturNeu" DateFormat="dd.MM.yyyy" />
                            </RadzenFormField>
                            <RadzenFormField Text="Grund bzw. Nachweis *" Variant="Variant.Outlined" Style="flex:1 1 320px">
                                <RadzenTextBox @bind-Value="korrekturGrund" @bind-Value:event="oninput" Placeholder="z. B. Meldebescheinigung vom 20.09." />
                            </RadzenFormField>
                        </div>
                        <div class="vhs-row">
                            <BegruendeterButton Text="Korrektur speichern" Icon="save" Click="@(() => KorrigierenAsync(e))" Freigabe="@KorrekturSpeichernFreigabe(e)" IsBusy="@korrigiert" />
                            <RadzenButton Text="Abbrechen" ButtonStyle="ButtonStyle.Light" Click="@(() => korrekturFuer = null)" />
                        </div>
                        @if (korrekturFehler is not null)
                        {
                            <div class="vhs-alert vhs-crit">@korrekturFehler</div>
                        }
                    </div>
                }
            </li>
        }
    </ol>
</section>

@code {
    [Parameter]
    public Guid Id { get; set; }

    [SupplyParameterFromQuery(Name = "art")]
    private string? ArtAusAdresse { get; set; }

    private Person? person;
    private PersonenStand? heute;
    private IReadOnlyList<HistorienEintrag> eintraege = [];
    private readonly HashSet<string> filter = [];
    private VibeVHS.Application.Sicherheit.Rolle? rolle;
    private HistorienEintrag? korrekturFuer;
    private bool korrekturEnde, korrigiert;
    private DateOnly korrekturNeu;
    private string? korrekturGrund, korrekturFehler;
    private IReadOnlyList<NaechsterSchritt> folgeschritte = [];

    private Freigabe KorrekturFreigabe(HistorienEintrag e)
        => rolle is not { } r || !Stammdatenaenderung.DatumKorrigierenRollen.Contains(r)
            ? Freigabe.Nein("Daten korrigieren dürfen Teilnehmerservice, Integrationskurs-Team, Verwaltungs- und Fachbereichsleitung sowie Leitung.")
            : person?.Datenschutz != VibeVHS.Domain.Datenschutz.Datenschutzstatus.Aktiv
                ? Freigabe.Nein("Die Person ist gesperrt oder anonymisiert; Stammdaten sind schreibgeschützt.")
                : e.Ersetzt
                    ? Freigabe.Nein("Diese Erfassung ist bereits ersetzt. Korrigiert wird immer der aktuelle Stand (nicht blass dargestellte Einträge).")
                    : e.Art == Erfassungsart.Beendet
                        ? Freigabe.Nein("Das ist das Ende einer Angabe. Bitte beim Eintrag davor „Ende“ korrigieren.")
                        : e.Korrektur is null
                            ? Freigabe.Nein("Für diese Angabe gibt es keine Datumskorrektur (nur Name, Angaben, Adressen und Adresskennzeichen).")
                            : e.Korrektur == Stammdatenaenderung.Datumskorrektur.Umzug && e.Art == Erfassungsart.Ersterfassung
                                ? Freigabe.Nein("Diese Adresse ist die erste erfasste Adresse; ihr Beginn ist kein Umzugsdatum. Bitte als Korrektur der Adresse erfassen.")
                                : Freigabe.Ja;

    private Freigabe KorrekturSpeichernFreigabe(HistorienEintrag e)
        => string.IsNullOrWhiteSpace(korrekturGrund)
            ? Freigabe.Nein("Bitte einen Grund bzw. Nachweis angeben (steht in der Datenhistorie).")
            : NeueGrenze(e) == BisherigeGrenze(e)
                ? Freigabe.Nein("Das neue Datum ist dasselbe wie bisher.")
                : Freigabe.Ja;

    private DateOnly BisherigeGrenze(HistorienEintrag e) => korrekturEnde ? e.GueltigBis!.Value : e.GueltigVon;

    // Ende wird einschließlich eingegeben, gespeichert ist es ausschließlich (Tag danach).
    private DateOnly NeueGrenze(HistorienEintrag e) => korrekturEnde ? korrekturNeu.AddDays(1) : korrekturNeu;

    private void KorrekturOeffnen(HistorienEintrag e)
    {
        korrekturFuer = e;
        korrekturEnde = false;
        korrekturNeu = e.GueltigVon;
        korrekturGrund = null;
        korrekturFehler = null;
    }

    private async Task KorrigierenAsync(HistorienEintrag e)
    {
        korrigiert = true;
        korrekturFehler = null;
        try
        {
            await Vorgang.AusfuehrenAsync(d => d.GetRequiredService<Stammdatenaenderung>()
                .DatumKorrigierenAsync(Id, e.Korrektur!.Value, e.KorrekturBezug, BisherigeGrenze(e), NeueGrenze(e), korrekturGrund!));
            Hinweise.Notify(NotificationSeverity.Success, "Datum korrigiert", $"{e.Feld}: {(korrekturEnde ? "Ende" : "Beginn")} jetzt {korrekturNeu:dd.MM.yyyy}.");
            korrekturFuer = null;
            folgeschritte = [new NaechsterSchritt("Stand zum neuen Datum prüfen", $"personen/{Id}/historie#stand", "Wert am Stichtag mit dem korrigierten Datum ansehen", Hauptschritt: true),
                new NaechsterSchritt("Zur Person", $"personen/{Id}")];
            await OnParametersSetAsync();
        }
        catch (InvalidOperationException ex)
        {
            korrekturFehler = ex.Message;
        }
        finally
        {
            korrigiert = false;
        }
    }
    private bool ersetzteZeigen = true;
    private DateOnly? stichtag;
    private DateTime? wissensstand;

    private PersonenStand? StandAmStichtag
    {
        get
        {
            if (person is null || stichtag is null || wissensstand is null)
            {
                return null;
            }

            var bekannt = new DateTimeOffset(wissensstand.Value, TimeZoneInfo.Local.GetUtcOffset(wissensstand.Value));
            return person.StandAm(stichtag.Value, bekannt);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        rolle ??= (await Vorgang.BenutzerAsync()).Rolle;
        person = await Vorgang.AusfuehrenAsync(d => d.GetRequiredService<IPersonenSpeicher>().LadenAsync(Id));
        var jetzt = Uhr.GetLocalNow();
        if (person is not null)
        {
            heute = person.StandAm(DateOnly.FromDateTime(jetzt.Date), jetzt);
            eintraege = Datenhistorie.Erstellen(person);
        }

        stichtag ??= DateOnly.FromDateTime(jetzt.Date);
        wissensstand ??= jetzt.DateTime;
        filter.Clear();
        if (!string.IsNullOrEmpty(ArtAusAdresse) && Datenhistorie.Datenarten.Contains(ArtAusAdresse))
        {
            filter.Add(ArtAusAdresse);
        }
    }

    private List<HistorienEintrag> Sichtbar(bool alle = false)
        => eintraege.Where(e => (ersetzteZeigen || !e.Ersetzt) && (alle || filter.Count == 0 || filter.Contains(e.Datenart))).ToList();

    private void Umschalten(string art)
    {
        if (!filter.Remove(art))
        {
            filter.Add(art);
        }
    }

    private static string Zeitraum(DateOnly von, DateOnly? bis)
    {
        var ab = von == DateOnly.MinValue ? "immer" : $"ab {von:dd.MM.yyyy}";
        return bis is { } b ? $"{ab} bis {b.AddDays(-1):dd.MM.yyyy}" : ab;
    }

    private static string? Anzeige(HistorienEintrag e, string? wert)
        => e.Datenart == "Sprache" && wert is { Length: <= 3 } ? Sprachen.Name(wert) : wert;

    private static string ArtStil(Erfassungsart art) => art switch
    {
        Erfassungsart.Korrektur => "warn",
        Erfassungsart.Beendet => "neutral",
        Erfassungsart.Ersterfassung => "gut",
        _ => "info",
    };
}
