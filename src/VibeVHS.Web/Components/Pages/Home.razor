@page "/"
@using VibeVHS.Application.Aufgaben
@using VibeVHS.Application.Personen
@using VibeVHS.Application.Postausgang
@using VibeVHS.Application.Protokoll
@using VibeVHS.Application.Stammdaten
@using VibeVHS.Domain.Stammdaten
@inject Vorgang Vorgang
@inject TimeProvider Uhr
@inject NavigationManager Navigation
@inject VibeVHS.Application.Betrieb.Startabgleich Abgleich
@using VibeVHS.Application.Betrieb
@implements IDisposable

<PageTitle>Start · VibeVHS</PageTitle>

<div class="vhs-head">
    <div>
        <h1>Guten Tag@(Anrede is null ? "" : ", " + Anrede)</h1>
        <p class="vhs-sub">@Uhr.GetLocalNow().ToString("dddd, d. MMMM yyyy")@if (einrichtung is not null) { <span> · @einrichtung.Name · @einrichtung.OrteAnzeige</span> }</p>
        @if (eigeneFachbereiche.Count > 0)
        {
            <p class="vhs-small vhs-muted" style="margin:4px 0 0">Ihre Fachbereiche: @string.Join("; ", eigeneFachbereiche.Select(f => f.Anzeige))</p>
        }
    </div>
    <div class="vhs-row">
        <BegruendeterButton Text="Person anlegen" Icon="person_add" Click="@(() => Navigation.NavigateTo("personen?neu=1"))" />
        <BegruendeterButton Text="Kurs anlegen" Icon="add" ButtonStyle="ButtonStyle.Light"
                            Freigabe="@KursAnlegen" Click="@(() => Navigation.NavigateTo("kurse/neu"))" />
    </div>
</div>

<h2 style="margin:8px 0 0">Was steht an?</h2>

@if (Abgleich.Laeuft)
{
    var schritte = Abgleich.Schritte;
    <div class="vhs-alert vhs-info" role="status" aria-live="polite">
        <b>Abgleich nach dem Serverstart läuft</b> – Aufgaben, Eskalationen und Prüfungen können sich in den nächsten Sekunden noch ändern.
        Die Übersicht aktualisiert sich von selbst.
        <span class="vhs-small">(@schritte.Count(s => s.Zustand is Schrittzustand.Fertig or Schrittzustand.Fehler) von @schritte.Count@(schritte.FirstOrDefault(s => s.Zustand == Schrittzustand.Laeuft) is { } l ? $" · gerade: {l.Anzeige}" : ""))</span>
    </div>
}

@if (uebersicht is { } u)
{
    @if (u.UeberfaelligJeGruppe.Count > 0 || u.Eskaliert.Count > 0)
    {
        <section class="vhs-card" aria-labelledby="h-leitung">
            <div class="vhs-head"><h2 id="h-leitung">Überfällig in den Körben <span class="vhs-zahl">@u.UeberfaelligJeGruppe.Sum(g => g.Ueberfaellig)</span></h2>
                <span class="vhs-small vhs-muted">Überblick für die Leitung; eskalierte Aufgaben kann die Leitung übernehmen oder zuweisen</span></div>
            <div class="vhs-list">
                @foreach (var g in u.UeberfaelligJeGruppe)
                {
                    <div><span class="vhs-grow">@KorbAnzeige(g)</span><StatusPille Stil="krit">@g.Ueberfaellig überfällig</StatusPille>
                        @if (g.Eskaliert > 0) { <StatusPille Stil="warn">@g.Eskaliert eskaliert</StatusPille> }
                        <span class="vhs-small vhs-muted">@g.Offen offen</span></div>
                }
            </div>
            @if (u.Eskaliert.Count > 0)
            {
                <h3 style="margin:4px 0 0">Eskaliert</h3>
                <AufgabenListe Aufgaben="@u.Eskaliert" Benutzer="@benutzer" Geaendert="LadenAsync" />
            }
        </section>
    }

    @if (u.EigeneAbwesenheit is { } ea)
    {
        <div class="vhs-alert vhs-info">Sie sind @(ea.Von <= DateOnly.FromDateTime(DateTime.Today) ? "abwesend gemeldet" : "ab " + ea.Von.ToString("dd.MM.") + " abwesend gemeldet") bis @ea.Bis.ToString("dd.MM.yyyy")
            · Vertretung: @(ea.VertretungName ?? "keine") · <a href="aufgaben?ansicht=abwesenheit">ändern</a></div>
    }
    @if (u.InVertretung is { Count: > 0 } iv)
    {
        <section class="vhs-card" aria-labelledby="h-vertretung">
            <div class="vhs-head"><h2 id="h-vertretung">In Vertretung <span class="vhs-zahl">@iv.Count</span></h2>
                <span class="vhs-small vhs-muted">Aufgaben abwesender Kolleg:innen, die Sie vertreten</span></div>
            <AufgabenListe Aufgaben="@iv" Benutzer="@benutzer" Geaendert="LadenAsync" />
        </section>
    }

    <div class="vhs-wsa">
        <section class="vhs-card" aria-labelledby="h-meine">
            <div class="vhs-head"><h2 id="h-meine">Meine Aufgaben <span class="vhs-zahl">@u.Meine.Count</span></h2></div>
            <AufgabenListe Aufgaben="@u.Meine" Benutzer="@benutzer" Geaendert="LadenAsync"
                           Leertext="Keine Aufgaben in Ihrer Liste. Übernehmen Sie eine aus dem Gruppenkorb." />
        </section>
        <section class="vhs-card" aria-labelledby="h-korb">
            <div class="vhs-head"><h2 id="h-korb">Gruppenkorb <span class="vhs-zahl">@u.Gruppenkorb.Count</span></h2>
                <span class="vhs-small vhs-muted vhs-why" tabindex="0" data-why="Aufgaben der aktiven Rolle (bei Fachbereichsleitungen nur der eigenen Fachbereiche), die noch niemand übernommen hat. Rolle oben rechts wechseln, um andere Körbe zu sehen.">@u.Korbname</span></div>
            <AufgabenListe Aufgaben="@u.Gruppenkorb" Benutzer="@benutzer" Geaendert="LadenAsync" Leertext="Der Korb ist leer." />
        </section>
        <section class="vhs-card" aria-labelledby="h-kollegen">
            <div class="vhs-head"><h2 id="h-kollegen">Bei Kolleg:innen <span class="vhs-zahl">@u.BeiKollegen.Count</span></h2>
                <span class="vhs-small vhs-muted">übernommen oder zugewiesen</span></div>
            <AufgabenListe Aufgaben="@u.BeiKollegen" Benutzer="@benutzer" Geaendert="LadenAsync" Leertext="Niemand aus Ihrem Korb bearbeitet gerade etwas." />
        </section>
    </div>
    <section class="vhs-card" aria-labelledby="h-auto">
        <div class="vhs-head"><h2 id="h-auto">Heute automatisch erledigt <span class="vhs-zahl">@(u.HeuteGeschlossen.Count + u.HeuteAutomatisch.Count)</span></h2>
            <span class="vhs-small vhs-muted">gleichartige Schritte zusammengefasst</span></div>
        @if (u.HeuteGeschlossen.Count + u.HeuteAutomatisch.Count == 0)
        {
            <div class="vhs-small vhs-muted">Heute hat die Automatik noch nichts erledigt.</div>
        }
        <div class="vhs-list">
            @foreach (var z in AutomatikZeilen(u).Take(5))
            {
                <div><span class="vhs-mono vhs-small vhs-muted vhs-zeit">@z.Zuletzt.ToLocalTime().ToString("HH:mm")</span>
                    <span class="vhs-grow">@z.Titel @if (z.Anzahl > 1) { <span class="vhs-zahl">@z.Anzahl</span> }<br /><span class="vhs-small vhs-muted">@(z.Anzahl > 1 ? "zuletzt: " : "")@z.Beispiel</span></span>
                    <StatusPille Stil="@(z.Fehler ? "warn" : "gut")">@(z.Fehler ? "Prüfung nötig" : z.Geschlossen ? "geschlossen" : "erledigt")</StatusPille></div>
            }
        </div>
        @if (AutomatikZeilen(u).Count > 5)
        {
            <div><a class="vhs-small" href="protokoll?wer=automatik&seit=heute">Alle @(u.HeuteGeschlossen.Count + u.HeuteAutomatisch.Count) Einträge im Protokoll anzeigen</a></div>
        }
    </section>
}

<div class="vhs-kpis">
    <div class="vhs-kpi"><div class="vhs-kpi-lbl">Personen</div><div class="vhs-kpi-val">@anzahlPersonen</div><div class="vhs-kpi-note">in der Datenbank</div></div>
    <div class="vhs-kpi"><div class="vhs-kpi-lbl">Postausgang wartend</div><div class="vhs-kpi-val">@wartend</div><div class="vhs-kpi-note">wird alle 15 s zugestellt</div></div>
    <div class="vhs-kpi"><div class="vhs-kpi-lbl">Zugestellt (simuliert)</div><div class="vhs-kpi-val">@zugestellt</div><div class="vhs-kpi-note">Mails und Schnittstellen</div></div>
    <div class="vhs-kpi"><div class="vhs-kpi-lbl">Fehlgeschlagen</div><div class="vhs-kpi-val">@fehlgeschlagen</div><div class="vhs-kpi-note">brauchen Prüfung</div></div>
</div>

<NaechsteSchritte Titel="Schnellzugriff" Schritte="@Schritte" />

<section class="vhs-card">
    <div class="vhs-head">
        <h2>Letzte Aktivitäten</h2>
        <span class="vhs-small vhs-muted">jeder Schritt, auch automatische, wird protokolliert</span>
    </div>
    <div class="vhs-list">
        @if (letzte.Count == 0)
        {
            <div class="vhs-small vhs-muted">Noch keine Einträge.</div>
        }
        @foreach (var e in letzte)
        {
            <div>
                <span class="vhs-mono vhs-small vhs-muted vhs-zeit">@e.Zeitpunkt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
                <span class="vhs-grow">@e.Beschreibung<br /><span class="vhs-small vhs-muted">@e.Benutzer@(e.Rolle is null ? "" : $" ({e.Rolle})")</span></span>
                @if (e.Erfolgreich)
                {
                    <StatusPille Stil="gut">erledigt</StatusPille>
                }
                else
                {
                    <StatusPille Stil="warn">Prüfung nötig</StatusPille>
                }
            </div>
        }
    </div>
    <div><RadzenButton Text="Ganzes Protokoll" Variant="Variant.Text" Icon="history" Click="@(() => Navigation.NavigateTo("protokoll"))" /></div>
</section>

@code {
    private string? Anrede;
    private int anzahlPersonen, wartend, zugestellt, fehlgeschlagen;
    private IReadOnlyList<AuditEintrag> letzte = [];
    private IReadOnlyList<NaechsterSchritt> Schritte = [];
    private Rolle? rolle;
    private Benutzer benutzer = Benutzer.Automatik;
    private Einrichtung? einrichtung;
    private Aufgabenuebersicht? uebersicht;
    private IReadOnlyList<Fachbereich> fachbereiche = [];
    private IReadOnlyList<Fachbereich> eigeneFachbereiche = [];

    // Gleiche Regel wie auf der Kursseite: Kurse planen Fachbereichsleitung und Leitung.
    private Freigabe KursAnlegen => Freigabe.NurFuer(rolle, Rolle.Fachbereichsleitung, Rolle.Leitung);

    [CascadingParameter]
    private Task<AuthenticationState>? Anmeldung { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (Anmeldung is not null)
        {
            var zustand = await Anmeldung;
            Anrede = zustand.User.FindFirst(VibeVHS.Adapters.Mocks.MockAnmeldung.AnredeClaim)?.Value;
        }

        benutzer = await Vorgang.BenutzerAsync();
        rolle = benutzer.Rolle;
        if (Abgleich.Laeuft)
        {
            Abgleich.Geaendert += AbgleichGeaendert;
        }

        await LadenAsync();
        Schritte = WasStehtAn.Fuer(benutzer, fachbereiche, new WasStehtAn.Lage(fehlgeschlagen));
        eigeneFachbereiche = benutzer.Rolle == Rolle.Fachbereichsleitung ? WasStehtAn.EigeneFachbereiche(benutzer, fachbereiche) : [];
    }

    private async Task LadenAsync()
    {
        await Vorgang.AusfuehrenAsync(async d =>
        {
            var post = d.GetRequiredService<INachrichtenSpeicher>();
            anzahlPersonen = await d.GetRequiredService<IPersonenSpeicher>().AnzahlAsync();
            wartend = await post.AnzahlAsync(NachrichtenStatus.Wartend);
            zugestellt = await post.AnzahlAsync(NachrichtenStatus.Zugestellt);
            fehlgeschlagen = await post.AnzahlAsync(NachrichtenStatus.Fehlgeschlagen);
            letzte = await d.GetRequiredService<IAuditProtokoll>().NeuesteAsync(8);
            var stammdaten = d.GetRequiredService<IStammdaten>();
            einrichtung = await stammdaten.EinrichtungAsync();
            fachbereiche = await stammdaten.FachbereicheAsync();
            uebersicht = await d.GetRequiredService<AufgabenDienst>().UebersichtAsync();
        });
    }

    // Nach jedem Schritt des Startabgleichs neu laden, damit Körbe, Eskalationen und Zähler stimmen.
    private void AbgleichGeaendert() => _ = InvokeAsync(async () =>
    {
        await LadenAsync();
        StateHasChanged();
    });

    public void Dispose() => Abgleich.Geaendert -= AbgleichGeaendert;

    private sealed record AutomatikZeile(string Titel, int Anzahl, DateTimeOffset Zuletzt, string Beispiel, bool Fehler, bool Geschlossen);

    private IReadOnlyList<AutomatikZeile>? automatikZeilen;
    private Aufgabenuebersicht? automatikFuer;

    /// <summary>Gleichartige automatische Schritte zusammengefasst (z. B. „Belege festgeschrieben 120“), neueste zuerst.</summary>
    private IReadOnlyList<AutomatikZeile> AutomatikZeilen(Aufgabenuebersicht u)
    {
        if (automatikZeilen is not null && ReferenceEquals(automatikFuer, u))
        {
            return automatikZeilen;
        }

        var aufgaben = u.HeuteGeschlossen.GroupBy(a => a.Typ)
            .Select(g => new AutomatikZeile(g.Count() > 1 ? $"Aufgaben geschlossen: {g.First().Titel.Split(':')[0]}" : g.First().Titel, g.Count(),
                g.Max(a => a.ErledigtAm) ?? DateTimeOffset.MinValue, g.OrderByDescending(a => a.ErledigtAm).First().Vermerk ?? "", false, true));
        var protokoll = u.HeuteAutomatisch.GroupBy(e => e.Aktion.StartsWith("Demodaten.", StringComparison.Ordinal) ? "Demodaten" : e.Aktion)
            .Select(g =>
            {
                var neuester = g.OrderByDescending(e => e.Zeitpunkt).First();
                return new AutomatikZeile(g.Count() > 1 ? Sammeltitel(g.Key) : neuester.Beschreibung, g.Count(), neuester.Zeitpunkt,
                    g.Count() > 1 ? neuester.Beschreibung : "", g.Any(e => !e.Erfolgreich), false);
            });
        automatikFuer = u;
        return automatikZeilen = aufgaben.Concat(protokoll).OrderByDescending(z => z.Fehler).ThenByDescending(z => z.Zuletzt).ToList();
    }

    private static string Sammeltitel(string aktion) => aktion switch
    {
        "Finanzen.Beleg" => "Belege festgeschrieben",
        "Dokument.Erstellt" => "Dokumente erstellt (Briefe, Bescheinigungen, Rechnungen)",
        "Finanzen.Mandat" => "SEPA-Mandate erfasst",
        "Finanzen.Honorarvertrag" => "Honorarverträge angelegt",
        "Finanzen.Bankverbindung" => "Bankverbindungen erfasst",
        "Finanzen.Mahnvorschlag" => "Mahnvorschläge erstellt",
        "Integration.Berechtigung" => "Teilnahmeberechtigungen erfasst",
        "Integration.Ausweis" => "Ausweisprüfungen erfasst",
        "Integration.Lichtbild" => "Lichtbilder gespeichert",
        "Integration.Kursdaten" => "Integrationskursdaten erfasst",
        "Demodaten" => "Demodaten angelegt",
        _ => aktion,
    };

    private string KorbAnzeige(UeberfaelligeGruppe g)
    {
        var rolleText = RollenExtensions.TryParse(g.Gruppe, out var r) ? r.Anzeigename() : g.Gruppe;
        return g.Fachbereich is { } nr ? $"{rolleText} · {fachbereiche.FirstOrDefault(f => f.Nr == nr)?.Anzeige ?? "FB " + nr}" : rolleText;
    }
}
