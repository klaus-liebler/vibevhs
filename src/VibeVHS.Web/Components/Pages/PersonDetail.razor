@page "/personen/{Id:guid}"
@using VibeVHS.Application.Personen
@using VibeVHS.Application.Postausgang
@using VibeVHS.Domain.Personen
@using VibeVHS.Domain.Datenschutz
@using VibeVHS.Application.Datenschutz
@inject Vorgang Vorgang
@inject TimeProvider Uhr
@inject NotificationService Hinweise
@inject NavigationManager Navigation

<PageTitle>@(stand?.NameMitTitel ?? "Person") · VibeVHS</PageTitle>

@if (person is null || stand is null)
{
    <h1>Person nicht gefunden</h1>
    <NaechsteSchritte Schritte="@([new NaechsterSchritt("Zur Personenliste", "personen", Hauptschritt: true)])" />
    return;
}

@if (person.Datenschutz == Datenschutzstatus.Gesperrt && !sperrzugriff)
{
    <h1>Gesperrter Datensatz</h1>
    <div class="vhs-alert vhs-warn" role="alert">
        Die Daten dieser Person sind nach Art. 18 DSGVO gesperrt (Aufbewahrungsfrist bis @person.GesperrtBis?.ToString("dd.MM.yyyy")).
        Einsehen dürfen sie nur Buchhaltung und Integrationskurs-Team; jeder Zugriff wird protokolliert. Ihre Rolle: @rolle?.Anzeigename().
    </div>
    <NaechsteSchritte Schritte="@([new NaechsterSchritt("Zur Personenliste", "personen", Hauptschritt: true)])" />
    return;
}

@if (person.IstAnonymisiert)
{
    <div class="vhs-alert vhs-info">Dieser Datensatz wurde am @person.AnonymisiertAm?.ToLocalTime().ToString("dd.MM.yyyy") anonymisiert. Erhalten sind nur Rollen und Statistikmerkmale (Altersgruppe @person.StatistikAltersgruppe, @person.StatistikGebiet), damit alte Kurse und Statistiken stimmen.</div>
}
else if (person.Datenschutz == Datenschutzstatus.Gesperrt)
{
    <div class="vhs-alert vhs-warn">Gesperrt bis @person.GesperrtBis?.ToString("dd.MM.yyyy") – Ihr Zugriff wurde protokolliert. Grund: @person.Sperrgrund</div>
}
else if (person.Datenschutz == Datenschutzstatus.Archiviert)
{
    <div class="vhs-alert vhs-info">Archiviert am @person.ArchiviertAm?.ToLocalTime().ToString("dd.MM.yyyy"): in Listen ausgeblendet. Zum Weiterarbeiten unten im Bereich „Datenschutz“ reaktivieren.</div>
}

@if (person.ZusammengefuehrtIn is { } zielId)
{
    <div class="vhs-alert vhs-warn" role="alert">
        Dieser Datensatz ist eine <b>zusammengeführte Dublette</b>. Er bleibt mit seiner Historie erhalten, gepflegt wird aber
        <a href="@($"personen/{zielId}")">der zusammengeführte Datensatz</a>.
    </div>
}
else if (dubletten.Count > 0)
{
    <div class="vhs-alert vhs-warn" role="alert">
        <b>Mögliche Dublette:</b>
        @foreach (var k in dubletten)
        {
            <span> <a href="@($"personen/dubletten?a={Id}&b={k.Id}")">@k.Anzeigename vergleichen</a> (@k.Grund)</span>
        }
    </div>
}

<div class="vhs-head">
    <div>
        <h1>@stand.NameMitTitel</h1>
        <p class="vhs-sub">@PersonMerkmal.RollenAnzeige(stand.Rollen) · @PersonenstatusAnzeige.Text(person.Status) · Korrespondenz auf @Sprachen.Name(stand.Sprache ?? "de")@(person.Fachbereiche.Count > 0 ? $" · FB {string.Join(", ", person.Fachbereiche)}" : "")</p>
    </div>
    <div class="vhs-row">
        <RadzenButton Text="Datenhistorie" Icon="history" ButtonStyle="ButtonStyle.Light"
                      Click="@(() => Navigation.NavigateTo($"personen/{Id}/historie"))" />
        <BegruendeterButton Text="Testmail" Icon="mail" ButtonStyle="ButtonStyle.Light"
                            Freigabe="@MailFreigabe" Click="TestmailAsync" />
        <BegruendeterButton Text="Bescheinigung drucken" Icon="print" ButtonStyle="ButtonStyle.Light"
                            Freigabe="@(Freigabe.Geplant("Der Druck von Bescheinigungen (mit QR-Code „Translate this letter“)"))" />
    </div>
</div>

<section class="vhs-card">
    <div class="vhs-head">
        <h2>Stammdaten</h2>
        <span class="vhs-small vhs-muted">Stand heute · <span class="vhs-why" tabindex="0"
            data-why="Die ID vergibt das System; sie ändert sich nie. Der Erfassungszeitpunkt ist Teil der Nachvollziehbarkeit.">angelegt
            @person.AngelegtAm.ToLocalTime().ToString("dd.MM.yyyy") · ID @person.Id.ToString()[..8]…</span></span>
    </div>
    <StammdatenKompakt Stand="@stand" PersonId="@Id" Widerrufen="@VollmachtWiderrufenAsync" />
</section>

@if (stand.Rollen.HasFlag(Personenrolle.Dozierende) || stand.Qualifikationen is { Count: > 0 } || stand.Beschaeftigung is not null)
{
    var heuteQ = DateOnly.FromDateTime(Uhr.GetLocalNow().Date);
    <section class="vhs-card">
        <div class="vhs-head">
            <h2>Qualifikationen</h2>
            <span class="vhs-small vhs-muted">Beschäftigung: <b>@(stand.Beschaeftigung is { } ba ? $"{BeschaeftigungAnzeige.Text(ba)} ({BeschaeftigungAnzeige.Erklaerung(ba)})" : "nicht erfasst")</b> · Verlauf in der <a href="@($"personen/{Id}/historie")">Datenhistorie</a></span>
        </div>
        @if (stand.Qualifikationen is not { Count: > 0 })
        {
            <p class="vhs-muted">Keine gültigen Qualifikationen erfasst.</p>
        }
        else
        {
            <div class="vhs-list">
                @foreach (var q in stand.Qualifikationen.OrderBy(q => q.Bezeichnung))
                {
                    var merkmal = personenmerkmale.FirstOrDefault(m => m.Schluessel == q.Schluessel);
                    var bald = q.GueltigBisEinschliesslich is { } b && b <= heuteQ.AddDays(merkmal?.VorlaufTage ?? 60);
                    <div>
                        <span class="vhs-grow"><b>@q.Bezeichnung</b>@(q.WertText is null ? "" : $" · {q.WertText}")@(merkmal?.Gesetzlich == true ? " · gesetzlich" : "")
                            <br /><span class="vhs-small vhs-muted">@(q.Nachweis is null ? "Nachweis fehlt" : $"Nachweis: {q.Nachweis}")@(q.AusstellendeStelle is null ? "" : $" · {q.AusstellendeStelle}") · gültig ab @q.GueltigVon.ToString("dd.MM.yyyy")</span>
                        </span>
                        @if (q.GueltigBisEinschliesslich is { } bis)
                        {
                            <StatusPille Stil="@(bald ? "warn" : "neutral")">bis @bis.ToString("dd.MM.yyyy")@(bald ? $" · noch {bis.DayNumber - heuteQ.DayNumber} Tage" : "")</StatusPille>
                        }
                        else
                        {
                            <StatusPille Stil="gut">unbefristet</StatusPille>
                        }
                        @if (q.Nachweis is null && merkmal?.NachweisPflicht == true) { <StatusPille Stil="krit">Nachweis fehlt</StatusPille> }
                    </div>
                }
            </div>
        }
        <details>
            <summary class="vhs-small">Qualifikation eintragen oder erneuern</summary>
            <div class="vhs-fields" style="margin-top:8px">
                <RadzenFormField Text="Merkmal" Variant="Variant.Outlined"><RadzenDropDown TValue="string" @bind-Value="qSchluessel" Data="@personenmerkmale" TextProperty="Name" ValueProperty="Schluessel" /></RadzenFormField>
                @if (personenmerkmale.FirstOrDefault(m => m.Schluessel == qSchluessel) is { Werte.Count: > 0 } mw)
                {
                    <RadzenFormField Text="Art / Wert" Variant="Variant.Outlined"><RadzenDropDown TValue="string" @bind-Value="qWert" Data="@mw.Werte" /></RadzenFormField>
                }
                <RadzenFormField Text="Nachweis (Dokument, Aktenzeichen)" Variant="Variant.Outlined"><RadzenTextBox @bind-Value="qNachweis" /></RadzenFormField>
                <RadzenFormField Text="Ausstellende Stelle" Variant="Variant.Outlined"><RadzenTextBox @bind-Value="qStelle" /></RadzenFormField>
                <RadzenFormField Text="Gültig ab" Variant="Variant.Outlined"><RadzenDatePicker TValue="DateOnly?" @bind-Value="qAb" DateFormat="dd.MM.yyyy" /></RadzenFormField>
                <RadzenFormField Text="Gültig bis (leer = unbefristet)" Variant="Variant.Outlined"><RadzenDatePicker TValue="DateOnly?" @bind-Value="qBis" DateFormat="dd.MM.yyyy" /></RadzenFormField>
            </div>
            <BegruendeterButton Text="Qualifikation speichern" Icon="verified" Size="ButtonSize.Small" Click="QualifikationAsync" Freigabe="@QualifikationFreigabe" />
        </details>
        <details>
            <summary class="vhs-small">Beschäftigungsart ändern (ab Datum)</summary>
            <div class="vhs-fields" style="margin-top:8px">
                <RadzenFormField Text="Beschäftigungsart" Variant="Variant.Outlined">
                    <RadzenDropDown TValue="Beschaeftigungsart" @bind-Value="bArt" Data="@(Enum.GetValues<Beschaeftigungsart>())">
                        <Template Context="x">@BeschaeftigungAnzeige.Text((Beschaeftigungsart)x)</Template>
                        <ValueTemplate Context="x">@BeschaeftigungAnzeige.Text((Beschaeftigungsart)x)</ValueTemplate>
                    </RadzenDropDown>
                </RadzenFormField>
                <RadzenFormField Text="Gilt ab" Variant="Variant.Outlined"><RadzenDatePicker TValue="DateOnly?" @bind-Value="bAb" DateFormat="dd.MM.yyyy" /></RadzenFormField>
                <RadzenFormField Text="Grund (z. B. Arbeitsvertrag vom …)" Variant="Variant.Outlined"><RadzenTextBox @bind-Value="bGrund" /></RadzenFormField>
            </div>
            <p class="vhs-small vhs-muted">Frühere Einsätze und Abrechnungen behalten die damalige Beschäftigungsart.</p>
            <BegruendeterButton Text="Beschäftigungsart speichern" Icon="work" Size="ButtonSize.Small" Click="BeschaeftigungAsync"
                                Freigabe="@(Schreibschutz.Und(() => Freigabe.NurFuer(rolle, VibeVHS.Application.Programm.QualifikationsDienst.PflegeRollen)).Und(() => bAb is null || string.IsNullOrWhiteSpace(bGrund) ? Freigabe.Nein("Bitte Datum und Grund angeben.") : Freigabe.Ja))" />
        </details>
    </section>
}

<section class="vhs-card">
    <div class="vhs-head">
        <h2>Kurse und Anmeldungen</h2>
        <BegruendeterButton Text="Neue Anmeldung" Icon="add" Size="ButtonSize.Small" Click="@(() => Navigation.NavigateTo($"anmeldung?person={Id}"))"
                            Freigabe="@(Schreibschutz.Und(() => Freigabe.NurFuer(rolle, VibeVHS.Application.Anmeldung.AnmeldungDienst.BuchungsRollen)))" />
    </div>
    @if (belegungen.Count == 0)
    {
        <p class="vhs-muted">Noch keine Anmeldungen.</p>
    }
    else
    {
        <div class="vhs-list">
            @foreach (var pb in belegungen)
            {
                var bl = pb.Belegung;
                <div>
                    <span class="vhs-grow"><a href="@($"belegungen/{bl.Id}")"><b>@bl.Kursnummer</b> @pb.Kurstitel</a>
                        <br /><span class="vhs-small vhs-muted">@(pb.Beginn is { } bg ? $"ab {bg:dd.MM.yyyy}" : "") · gebucht @bl.GebuchtAm.ToLocalTime().ToString("dd.MM.yyyy") (@VibeVHS.Domain.Anmeldung.BelegungAnzeige.Weg(bl.Weg)) · @bl.Entgelt@(bl.IstKontingent && bl.KontingentAnzahl is not null ? $" · Kontingent: {bl.Kontingent.Verbleibend} von {bl.Kontingent.Anzahl} übrig" : "")</span>
                    </span>
                    @if (pb.KursAbgesagt && bl.Offen) { <StatusPille Stil="krit">Kurs abgesagt</StatusPille> }
                    <StatusPille Stil="@(bl.Status == VibeVHS.Domain.Anmeldung.Belegungsstatus.Angemeldet ? "gut" : bl.Offen ? "warn" : "neutral")">@VibeVHS.Domain.Anmeldung.BelegungAnzeige.Status(bl.Status)</StatusPille>
                </div>
            }
        </div>
    }
    @if (ermaessigungen.Count > 0)
    {
        <p class="vhs-small">Ermäßigungen: @string.Join("; ", ermaessigungen.Select(e => $"{e.Art} ({e.GueltigVon:dd.MM.yyyy}–{e.GueltigBis:dd.MM.yyyy}, Nachweis: {e.Nachweis})"))</p>
    }
</section>

<VibeVHS.Web.Components.Finanzen.PersonFinanzen @key="@Id" PersonId="@Id" Dozierend="@(stand.Rollen.HasFlag(Personenrolle.Dozierende) || stand.Beschaeftigung is not null)" Name="@stand.NameMitTitel" />

<section class="vhs-card">
    <div class="vhs-head">
        <h2>Dokumente</h2>
        <div class="vhs-row">
            <BegruendeterButton Text="Teilnehmerausweis drucken" Icon="badge" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="AusweisAsync"
                                Freigabe="@(Schreibschutz.Und(() => Freigabe.NurFuer(rolle, VibeVHS.Application.Dokumente.DokumentDienst.AusstellRollen)))" />
        </div>
    </div>
    <p class="vhs-small vhs-muted" style="margin-top:-6px">Archiv: Jedes Dokument ist mit PDF, eingefrorenem Datenstand und SHA-256-Prüfsumme gespeichert. Ein Nachdruck liefert immer das Original.</p>
    @if (dokumente.Count == 0)
    {
        <p class="vhs-muted">Noch keine Dokumente.</p>
    }
    else
    {
        <div class="vhs-list">
            @foreach (var dok in dokumente)
            {
                <div>
                    <span class="vhs-grow"><b>@dok.Titel</b><br />
                        <span class="vhs-small vhs-muted">@dok.ErstelltAm.ToLocalTime().ToString("dd.MM.yyyy HH:mm") · @dok.ErstelltVon@(dok.IstAnonymisiert ? " · Inhalt gelöscht (anonymisiert)" : $" · SHA-256 {dok.Sha256[..16]}…")@(dok.NeuausstellungGrund is { } g ? $" · Neuausstellung: {g}" : "")</span>
                    </span>
                    @if (dok.ErsetztDurch is not null) { <StatusPille Stil="neutral">ersetzt</StatusPille> }
                    @if (dok.BelegungId is { } bid) { <a class="vhs-small" href="@($"belegungen/{bid}")">Belegung</a> }
                    <BegruendeterButton Text="Nachdruck" Icon="print" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@(() => Navigation.NavigateTo($"dokumente/{dok.Id}.pdf", true))"
                                        Freigabe="@(dok.IstAnonymisiert ? Freigabe.Nein("Der Inhalt wurde bei der Anonymisierung gelöscht.") : rolle is null or Rolle.Dozierende ? Freigabe.Nein("Archivdokumente drucken Verwaltung und Leitung.") : Freigabe.Ja)" />
                </div>
            }
        </div>
    }
</section>

<details class="vhs-card">
    <summary><b>Einwilligung ändern</b> <span class="vhs-small vhs-muted">– je Kanal und Zweck, mit Nachweis; die bisherige bleibt in der Historie</span></summary>
    <div class="vhs-fields">
        <RadzenFormField Text="Kanal" Variant="Variant.Outlined">
            <RadzenDropDown TValue="Kontaktkanal" @bind-Value="ewKanal" Data="@(Enum.GetValues<Kontaktkanal>())" />
        </RadzenFormField>
        <RadzenFormField Text="Zweck" Variant="Variant.Outlined">
            <RadzenDropDown TValue="Kontaktzweck" @bind-Value="ewZweck" Data="@(Enum.GetValues<Kontaktzweck>())" />
        </RadzenFormField>
        <RadzenFormField Text="Gültig ab" Variant="Variant.Outlined">
            <RadzenDatePicker TValue="DateOnly?" @bind-Value="ewAb" DateFormat="dd.MM.yyyy" />
        </RadzenFormField>
        <RadzenFormField Text="Nachweis *" Variant="Variant.Outlined">
            <RadzenTextBox @bind-Value="ewNachweis" Placeholder="z. B. Anmeldeformular vom …, telefonisch" />
        </RadzenFormField>
    </div>
    <div class="vhs-row">
        <label><RadzenSwitch @bind-Value="ewErteilt" /> Einwilligung erteilt</label>
        <BegruendeterButton Text="Einwilligung speichern" Icon="save" Click="EinwilligungSpeichernAsync"
                            Freigabe="@(string.IsNullOrWhiteSpace(ewNachweis) || ewAb is null ? Freigabe.Nein("Bitte Datum und Nachweis angeben (DSGVO: Einwilligungen müssen nachweisbar sein).") : Freigabe.Ja)" />
    </div>
</details>

<details class="vhs-card">
    <summary><b>Buchungsvollmacht erteilen</b> <span class="vhs-small vhs-muted">– eine andere Person oder eine Organisation darf diese Person anmelden</span></summary>
    <RadzenRadioButtonList TValue="Bevollmaechtigtenart" @bind-Value="vmArt" Orientation="Orientation.Horizontal">
        <Items>
            <RadzenRadioButtonListItem Text="Person (z. B. Elternteil, Betreuung)" Value="Bevollmaechtigtenart.Person" />
            <RadzenRadioButtonListItem Text="Organisation (z. B. Arbeitgeber, Jobcenter)" Value="Bevollmaechtigtenart.Organisation" />
        </Items>
    </RadzenRadioButtonList>
    @if (vmArt == Bevollmaechtigtenart.Person)
    {
        <RadzenFormField Text="Bevollmächtigte Person suchen" Variant="Variant.Outlined" Style="width:100%">
            <RadzenTextBox @bind-Value="vmSuche" @bind-Value:after="VollmachtSucheAsync" Placeholder="Name eingeben, Enter" />
        </RadzenFormField>
        <div class="vhs-row">
            @foreach (var t in vmTreffer)
            {
                <button class="vhs-chip @(vmPersonId == t.Id ? "on" : "")" @onclick="@(() => { vmPersonId = t.Id; vmPersonName = t.Anzeigename; })">
                    @t.Anzeigename @(t.Geburtsdatum is { } g ? $"({g:dd.MM.yyyy})" : "")
                </button>
            }
        </div>
    }
    else
    {
        <RadzenFormField Text="Organisation" Variant="Variant.Outlined" Style="width:100%">
            <RadzenDropDown TValue="Guid?" @bind-Value="vmOrganisationId" Data="@organisationen" TextProperty="Name" ValueProperty="Id" AllowClear="true" />
        </RadzenFormField>
    }
    <div class="vhs-fields">
        <RadzenFormField Text="Gültig ab *" Variant="Variant.Outlined"><RadzenDatePicker TValue="DateOnly?" @bind-Value="vmVon" DateFormat="dd.MM.yyyy" /></RadzenFormField>
        <RadzenFormField Text="Gültig bis einschließlich" Variant="Variant.Outlined"><RadzenDatePicker TValue="DateOnly?" @bind-Value="vmBis" DateFormat="dd.MM.yyyy" /></RadzenFormField>
        <RadzenFormField Text="Nachweis *" Variant="Variant.Outlined"><RadzenTextBox @bind-Value="vmNachweis" Placeholder="z. B. Sorgerecht (Geburtsurkunde), Betreuerausweis" /></RadzenFormField>
    </div>
    <div class="vhs-row">
        <BegruendeterButton Text="Vollmacht erteilen" Icon="how_to_reg" Click="VollmachtErteilenAsync" Freigabe="@VollmachtFreigabe" />
    </div>
</details>

<details class="vhs-card" open="@nameOffen">
    <summary><b>Namen ändern</b> <span class="vhs-small vhs-muted">– Namen werden nie überschrieben, ältere Dokumente behalten den damals gültigen Namen</span></summary>
    <RadzenRadioButtonList TValue="bool" @bind-Value="istKorrektur" Orientation="Orientation.Vertical">
        <Items>
            <RadzenRadioButtonListItem Text="Änderung ab einem Datum (z. B. Heirat): ältere Dokumente behalten den alten Namen" Value="false" />
            <RadzenRadioButtonListItem Text="Korrektur (Tippfehler): der Name war schon immer falsch erfasst" Value="true" />
        </Items>
    </RadzenRadioButtonList>
    <div class="vhs-fields">
        <RadzenFormField Text="Vorname *" Variant="Variant.Outlined"><RadzenTextBox @bind-Value="neuVorname" /></RadzenFormField>
        <RadzenFormField Text="Nachname *" Variant="Variant.Outlined"><RadzenTextBox @bind-Value="neuNachname" /></RadzenFormField>
        <RadzenFormField Text="@(istKorrektur ? "Betroffene Version gültig am *" : "Gültig ab *")" Variant="Variant.Outlined">
            <RadzenDatePicker TValue="DateOnly?" @bind-Value="aenderungsdatum" DateFormat="dd.MM.yyyy" />
        </RadzenFormField>
        <RadzenFormField Text="Grund / Nachweis *" Variant="Variant.Outlined">
            <RadzenTextBox @bind-Value="grund" Placeholder="z. B. Heirat, Nachweis: Heiratsurkunde" />
        </RadzenFormField>
    </div>
    @if (fehler is not null)
    {
        <div class="vhs-alert vhs-crit" role="alert">@fehler</div>
    }
    <div class="vhs-row">
        <BegruendeterButton Text="@(istKorrektur ? "Korrektur speichern" : "Änderung speichern")" Icon="save"
                            Freigabe="@AenderungFreigabe" Click="NameSpeichernAsync" IsBusy="@speichert" />
    </div>
</details>

<details class="vhs-card" open="@dsOffen">
    <summary><b>Datenschutz</b> <span class="vhs-small vhs-muted">– Status @DatenschutzAnzeige.Text(person.Datenschutz) · Auskunft, Check-in-Zugänge, Archivieren, Löschverlangen</span></summary>
    <div>
        <b class="vhs-small">Check-in-Zugänge</b> <span class="vhs-small vhs-muted">(persönlicher Link aus der Bestätigungsmail, gemerkte Geräte, Teilnehmerausweise; gespeichert ist nur ein Hash)</span>
        @if (zugaenge.Count == 0)
        {
            <p class="vhs-small vhs-muted" style="margin:4px 0">Keine.</p>
        }
        else
        {
            <div class="vhs-list">
                @foreach (var z in zugaenge)
                {
                    <div>
                        <span class="vhs-grow vhs-small">@VibeVHS.Domain.Durchfuehrung.TokenAnzeige.Art(z.Art) · erstellt @z.ErstelltAm.ToLocalTime().ToString("dd.MM.yyyy")@(z.ZuletztGenutzt is { } g ? $" · zuletzt genutzt {g.ToLocalTime():dd.MM.yyyy HH:mm}" : "")</span>
                        @if (z.Gueltig)
                        {
                            <BegruendeterButton Text="Sperren" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Freigabe="@VerwaltenFreigabe" Click="@(() => ZugangSperrenAsync(z.Id))" />
                        }
                        else
                        {
                            <StatusPille Stil="neutral">gesperrt @z.WiderrufenAm?.ToLocalTime().ToString("dd.MM.yyyy")</StatusPille>
                        }
                    </div>
                }
            </div>
            <BegruendeterButton Text="Alle Zugänge sperren" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="AlleZugaengeSperrenAsync"
                                Freigabe="@(VerwaltenFreigabe.Und(() => zugaenge.Any(z => z.Gueltig) ? Freigabe.Ja : Freigabe.Nein("Es gibt keine gültigen Zugänge.")))" />
        }
    </div>
    <div class="vhs-row">
        @if (AuskunftFreigabe.Erlaubt)
        {
            <a class="rz-button rz-button-sm rz-variant-filled rz-light rz-shade-default" href="@($"personen/{Id}/auskunft.pdf")" download><span class="rz-button-box"><span class="rz-button-text">Auskunft Art. 15 (PDF)</span></span></a>
            <a class="rz-button rz-button-sm rz-variant-filled rz-light rz-shade-default" href="@($"personen/{Id}/auskunft.json")" download><span class="rz-button-box"><span class="rz-button-text">Auskunft (JSON)</span></span></a>
        }
        else
        {
            <BegruendeterButton Text="Auskunft Art. 15" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Freigabe="@AuskunftFreigabe" />
        }
        @if (person.Datenschutz == Datenschutzstatus.Aktiv)
        {
            <BegruendeterButton Text="Archivieren" Icon="inventory_2" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Freigabe="@VerwaltenFreigabe" Click="ArchivierenAsync" />
        }
        else if (!person.IstAnonymisiert)
        {
            <BegruendeterButton Text="Reaktivieren" Icon="unarchive" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Freigabe="@VerwaltenFreigabe" Click="ReaktivierenAsync" />
        }
        <BegruendeterButton Text="Löschverlangen prüfen" Icon="delete_sweep" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light"
                            Freigabe="@(person.IstAnonymisiert ? Freigabe.Nein("Die Person ist bereits anonymisiert.") : VerwaltenFreigabe)" Click="LoeschpruefungAsync" />
    </div>
    @if (pruefung is { } pr)
    {
        <div class="vhs-alert @(pr.Entscheidung.Aktion == Loeschaktion.Anonymisieren ? "vhs-info" : "vhs-warn")">
            @if (pr.Entscheidung.Aktion == Loeschaktion.Anonymisieren)
            {
                <b>Keine Aufbewahrungspflicht:</b> <span>Die Person wird vollständig anonymisiert (Platzhalter, alle Versionen, Kontaktdaten, Postausgang, Suchindex).</span>
            }
            else
            {
                <b>Aufbewahrungspflicht bis @pr.Entscheidung.GesperrtBis?.ToString("dd.MM.yyyy"):</b>
                <span>Telefon, E-Mail, Vollmachten und Einwilligungsnachweise werden sofort gelöscht, der Rest wird gesperrt.</span>
                <ul class="vhs-kompakt">@foreach (var g in pr.Entscheidung.Gruende) { <li>@g</li> }</ul>
            }
            @(person.EMail is null ? "Es ist keine E-Mail-Adresse hinterlegt; das Antwortschreiben bitte per Post." : "Ein Antwortschreiben geht in den Postausgang.")
        </div>
        <BegruendeterButton Text="Löschverlangen jetzt ausführen" Icon="delete_forever" ButtonStyle="ButtonStyle.Danger" Freigabe="@VerwaltenFreigabe"
                            Click="LoeschverlangenAsync" IsBusy="@speichert" />
    }
</details>

<NaechsteSchritte Schritte="@folgeschritte" />

@code {
    private bool sperrzugriff, dsOffen;
    private IReadOnlyList<VibeVHS.Application.Anmeldung.PersonBelegung> belegungen = [];
    private IReadOnlyList<VibeVHS.Domain.Anmeldung.Ermaessigung> ermaessigungen = [];
    private IReadOnlyList<VibeVHS.Domain.Programm.Merkmal> personenmerkmale = [];
    private IReadOnlyList<VibeVHS.Domain.Dokumente.Dokument> dokumente = [];
    private IReadOnlyList<VibeVHS.Domain.Durchfuehrung.Zugangstoken> zugaenge = [];

    private async Task ZugangSperrenAsync(Guid tokenId)
    {
        await Vorgang.AusfuehrenAsync(d => d.GetRequiredService<VibeVHS.Application.Durchfuehrung.CheckinZugang>().WiderrufenAsync(tokenId, "auf Wunsch / Gerät verloren"));
        Hinweise.Notify(NotificationSeverity.Info, "Gesperrt", "Der Zugang ist gesperrt und protokolliert.");
        await LadenAsync();
    }

    private async Task AlleZugaengeSperrenAsync()
    {
        var n = await Vorgang.AusfuehrenAsync(d => d.GetRequiredService<VibeVHS.Application.Durchfuehrung.CheckinZugang>().AlleWiderrufenAsync(Id, "alle Zugänge gesperrt"));
        Hinweise.Notify(NotificationSeverity.Info, "Gesperrt", $"{n} Zugänge gesperrt.");
        await LadenAsync();
    }

    private async Task AusweisAsync()
    {
        try
        {
            var dok = await Vorgang.AusfuehrenAsync(d => d.GetRequiredService<VibeVHS.Application.Dokumente.DokumentDienst>().TeilnehmerausweisAsync(Id));
            Hinweise.Notify(NotificationSeverity.Success, "Archiviert", "Teilnehmerausweis erstellt.");
            await LadenAsync();
            Navigation.NavigateTo($"dokumente/{dok.Id}.pdf", true);
        }
        catch (InvalidOperationException ex)
        {
            Hinweise.Notify(NotificationSeverity.Error, "Nicht möglich", ex.Message);
        }
    }
    private string? qSchluessel, qWert, qNachweis, qStelle, bGrund;
    private DateOnly? qAb, qBis, bAb;
    private Beschaeftigungsart bArt = Beschaeftigungsart.Freiberuflich;

    private Freigabe QualifikationFreigabe => Schreibschutz
        .Und(() => Freigabe.NurFuer(rolle, VibeVHS.Application.Programm.QualifikationsDienst.PflegeRollen))
        .Und(() => qSchluessel is null || qAb is null ? Freigabe.Nein("Bitte Merkmal und Beginn der Gültigkeit angeben.")
            : personenmerkmale.FirstOrDefault(m => m.Schluessel == qSchluessel) is { NachweisPflicht: true } && string.IsNullOrWhiteSpace(qNachweis)
                ? Freigabe.Nein("Für dieses Merkmal ist ein Nachweis Pflicht (Dokument oder Aktenzeichen).")
                : personenmerkmale.FirstOrDefault(m => m.Schluessel == qSchluessel) is { Werte.Count: > 0 } && qWert is null
                    ? Freigabe.Nein("Bitte die Art auswählen (z. B. Zulassungsart).") : Freigabe.Ja);

    private async Task QualifikationAsync()
    {
        try
        {
            await Vorgang.AusfuehrenAsync(d => d.GetRequiredService<VibeVHS.Application.Programm.QualifikationsDienst>()
                .QualifikationSetzenAsync(Id, qSchluessel!, qWert, qNachweis, qStelle, qAb!.Value, qBis));
            Hinweise.Notify(NotificationSeverity.Success, "Gespeichert", "Qualifikation eingetragen; der Verlauf steht in der Datenhistorie.");
            qSchluessel = qWert = qNachweis = qStelle = null;
            qBis = null;
            await LadenAsync();
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException)
        {
            Hinweise.Notify(NotificationSeverity.Error, "Nicht möglich", ex.Message);
        }
    }

    private async Task BeschaeftigungAsync()
    {
        try
        {
            await Vorgang.AusfuehrenAsync(d => d.GetRequiredService<VibeVHS.Application.Programm.QualifikationsDienst>()
                .BeschaeftigungAendernAsync(Id, bArt, bAb!.Value, bGrund!));
            Hinweise.Notify(NotificationSeverity.Success, "Gespeichert", $"Beschäftigungsart ab {bAb:dd.MM.yyyy}: {BeschaeftigungAnzeige.Text(bArt)}.");
            bGrund = null;
            await LadenAsync();
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException)
        {
            Hinweise.Notify(NotificationSeverity.Error, "Nicht möglich", ex.Message);
        }
    }
    private Rolle? rolle;
    private Loeschpruefung? pruefung;

    private Freigabe VerwaltenFreigabe => Freigabe.NurFuer(rolle, Rolle.Teilnehmerservice, Rolle.Verwaltungsleitung, Rolle.Leitung);

    private Freigabe AuskunftFreigabe => rolle is null or Rolle.Fachbereichsleitung
        ? Freigabe.Nein("Auskünfte nach Art. 15 erstellen Teilnehmerservice, Verwaltung und Leitung.")
        : Freigabe.Ja;

    private async Task ArchivierenAsync()
    {
        await Vorgang.AusfuehrenAsync(d => d.GetRequiredService<DatenschutzDienst>().ArchivierenAsync(Id));
        Hinweise.Notify(NotificationSeverity.Info, "Archiviert", "Die Person ist archiviert und in Listen ausgeblendet.");
        await LadenAsync();
    }

    private async Task ReaktivierenAsync()
    {
        await Vorgang.AusfuehrenAsync(d => d.GetRequiredService<DatenschutzDienst>().ReaktivierenAsync(Id));
        Hinweise.Notify(NotificationSeverity.Success, "Reaktiviert", "Die Person ist wieder aktiv.");
        await LadenAsync();
    }

    private async Task LoeschpruefungAsync()
    {
        dsOffen = true;
        pruefung = await Vorgang.AusfuehrenAsync(d => d.GetRequiredService<DatenschutzDienst>().PruefenAsync(Id));
    }

    private async Task LoeschverlangenAsync()
    {
        speichert = true;
        try
        {
            var ergebnis = await Vorgang.AusfuehrenAsync(d => d.GetRequiredService<DatenschutzDienst>().LoeschverlangenAsync(Id));
            Hinweise.Notify(NotificationSeverity.Success, "Löschverlangen bearbeitet",
                ergebnis.Entscheidung.Aktion == Loeschaktion.Anonymisieren ? "Die Person wurde anonymisiert." : $"Kontaktdaten gelöscht, Rest gesperrt bis {ergebnis.Entscheidung.GesperrtBis:dd.MM.yyyy}.");
            pruefung = null;
            folgeschritte = ergebnis.AntwortEingereiht
                ? [new("Antwortschreiben im Postausgang ansehen", "postausgang", Hauptschritt: true), new("Protokoll ansehen", "protokoll")]
                : [new("Antwort per Brief", "#", Freigabe: Freigabe.Geplant("Der Briefdruck", "I4"), Hauptschritt: true), new("Protokoll ansehen", "protokoll")];
            sperrzugriff = true;
            await LadenAsync();
        }
        finally
        {
            speichert = false;
        }
    }

    [Parameter]
    public Guid Id { get; set; }

    private Person? person;
    private PersonenStand? stand;

    private bool istKorrektur, speichert, nameOffen;
    private string? neuVorname, neuNachname, grund, fehler;
    private DateOnly? aenderungsdatum;
    private IReadOnlyList<NaechsterSchritt> folgeschritte = [];

    // Dubletten, Einwilligungen, Vollmachten
    private IReadOnlyList<DublettenKandidat> dubletten = [];
    private Kontaktkanal ewKanal = Kontaktkanal.EMail;
    private Kontaktzweck ewZweck = Kontaktzweck.Werbung;
    private bool ewErteilt = true;
    private DateOnly? ewAb;
    private string? ewNachweis;
    private Bevollmaechtigtenart vmArt = Bevollmaechtigtenart.Person;
    private string? vmSuche, vmPersonName, vmNachweis;
    private Guid? vmPersonId, vmOrganisationId;
    private DateOnly? vmVon, vmBis;
    private IReadOnlyList<PersonZeile> vmTreffer = [];
    private IReadOnlyList<Organisation> organisationen = [];

    private Freigabe VollmachtFreigabe => !Schreibschutz.Erlaubt ? Schreibschutz :
        (vmArt == Bevollmaechtigtenart.Person ? vmPersonId : vmOrganisationId) is null
            ? Freigabe.Nein(vmArt == Bevollmaechtigtenart.Person ? "Bitte die bevollmächtigte Person suchen und auswählen." : "Bitte eine Organisation auswählen.")
            : vmVon is null || string.IsNullOrWhiteSpace(vmNachweis)
                ? Freigabe.Nein("Bitte Beginn und Nachweis angeben. Ohne Nachweis keine Vollmacht.")
                : vmBis is { } b && b < vmVon
                    ? Freigabe.Nein("Das Ende liegt vor dem Beginn.")
                    : Freigabe.Ja;

    private Freigabe MailFreigabe => string.IsNullOrWhiteSpace(person?.EMail)
        ? Freigabe.Nein("Für diese Person ist keine E-Mail-Adresse hinterlegt.")
        : Freigabe.Ja;

    private Freigabe Schreibschutz => person is { Datenschutz: not Datenschutzstatus.Aktiv } p
        ? Freigabe.Nein($"Der Datensatz ist {DatenschutzAnzeige.Text(p.Datenschutz)} und daher schreibgeschützt.")
        : Freigabe.Ja;

    private Freigabe AenderungFreigabe => !Schreibschutz.Erlaubt ? Schreibschutz :
        string.IsNullOrWhiteSpace(neuVorname) || string.IsNullOrWhiteSpace(neuNachname)
            ? Freigabe.Nein("Bitte Vor- und Nachnamen eintragen.")
            : aenderungsdatum is null
                ? Freigabe.Nein(istKorrektur ? "Bitte angeben, für welchen Tag die zu korrigierende Version gilt." : "Bitte das Datum angeben, ab dem der neue Name gilt.")
                : string.IsNullOrWhiteSpace(grund)
                    ? Freigabe.Nein("Ein Grund ist Pflicht, damit die Änderung später nachvollziehbar ist.")
                    : Freigabe.Ja;

    protected override async Task OnParametersSetAsync()
    {
        await LadenAsync();
        aenderungsdatum ??= DateOnly.FromDateTime(Uhr.GetLocalNow().Date);
        ewAb ??= DateOnly.FromDateTime(Uhr.GetLocalNow().Date);
        vmVon ??= DateOnly.FromDateTime(Uhr.GetLocalNow().Date);
        qAb ??= DateOnly.FromDateTime(Uhr.GetLocalNow().Date);
        bAb ??= DateOnly.FromDateTime(Uhr.GetLocalNow().Date);
        organisationen = await Vorgang.AusfuehrenAsync(d => d.GetRequiredService<IOrganisationen>().AlleAsync());
        folgeschritte = [new("Datenhistorie ansehen", $"personen/{Id}/historie"), new("Zur Personenliste", "personen")];
    }

    private async Task LadenAsync()
    {
        person = await Vorgang.AusfuehrenAsync(d => d.GetRequiredService<IPersonenSpeicher>().LadenAsync(Id));
        rolle ??= (await Vorgang.BenutzerAsync()).Rolle;
        if (person?.Datenschutz == Datenschutzstatus.Gesperrt && !sperrzugriff)
        {
            sperrzugriff = await Vorgang.AusfuehrenAsync(d => d.GetRequiredService<DatenschutzDienst>().SperrzugriffAsync(Id));
        }
        var jetzt = Uhr.GetLocalNow();
        stand = person?.StandAm(DateOnly.FromDateTime(jetzt.Date), jetzt);
        if (person is not null && (person.Datenschutz != Datenschutzstatus.Gesperrt || sperrzugriff))
        {
            await Vorgang.AusfuehrenAsync(async d =>
            {
                var anmeldung = d.GetRequiredService<VibeVHS.Application.Anmeldung.AnmeldungDienst>();
                belegungen = await anmeldung.BelegungenDerPersonAsync(Id);
                ermaessigungen = await anmeldung.ErmaessigungenAsync(Id);
                personenmerkmale = await d.GetRequiredService<VibeVHS.Application.Programm.QualifikationsDienst>().PersonenmerkmaleAsync();
                dokumente = await d.GetRequiredService<VibeVHS.Application.Dokumente.DokumentDienst>().DerPersonAsync(Id);
                zugaenge = await d.GetRequiredService<VibeVHS.Application.Durchfuehrung.CheckinZugang>().DerPersonAsync(Id);
            });
        }
        if (stand?.Name is { } name)
        {
            neuVorname ??= name.Vorname;
            neuNachname ??= name.Nachname;
            dubletten = person!.Status == Personenstatus.Zusammengefuehrt
                ? []
                : await Vorgang.AusfuehrenAsync(d => d.GetRequiredService<IDublettenSuche>()
                    .KandidatenAsync(name.Vorname, name.Nachname, person.Geburtsdatum, Id));
        }
    }

    private async Task NameSpeichernAsync()
    {
        fehler = null;
        speichert = true;
        try
        {
            var dienst = (IServiceProvider d) => d.GetRequiredService<PersonenDienst>();
            var neu = istKorrektur
                ? await Vorgang.AusfuehrenAsync(d => dienst(d).NameKorrigierenAsync(Id, neuVorname!, neuNachname!, aenderungsdatum!.Value, grund!))
                : await Vorgang.AusfuehrenAsync(d => dienst(d).NameAendernAbAsync(Id, neuVorname!, neuNachname!, aenderungsdatum!.Value, grund!));
            Hinweise.Notify(NotificationSeverity.Success, "Gespeichert",
                istKorrektur ? $"Name korrigiert in {neu.Anzeige}." : $"{neu.Anzeige} gilt ab {neu.GueltigVon:dd.MM.yyyy}.");
            grund = null;
            nameOffen = false;
            await LadenAsync();
            folgeschritte =
            [
                new("Änderung in der Datenhistorie ansehen", $"personen/{Id}/historie?art=Name", Hauptschritt: true),
                new("Bescheinigungen neu drucken", "#", Freigabe: Freigabe.Geplant("Der Druck von Bescheinigungen")),
                new("Zur Personenliste", "personen"),
            ];
        }
        catch (Exception ex) when (ex is InvalidOperationException or ArgumentException)
        {
            fehler = ex.Message;
            nameOffen = true;
        }
        finally
        {
            speichert = false;
        }
    }

    private async Task EinwilligungSpeichernAsync()
    {
        await Vorgang.AusfuehrenAsync(d => d.GetRequiredService<PersonenDienst>()
            .EinwilligungSetzenAsync(Id, ewKanal, ewZweck, ewErteilt, ewAb!.Value, ewNachweis!));
        Hinweise.Notify(NotificationSeverity.Success, "Gespeichert", $"Einwilligung {Einwilligung.KanalAnzeige(ewKanal)} · {Einwilligung.ZweckAnzeige(ewZweck)} gespeichert.");
        ewNachweis = null;
        await LadenAsync();
        folgeschritte = [new("Änderung in der Datenhistorie ansehen", $"personen/{Id}/historie?art=Einwilligungen", Hauptschritt: true), new("Zur Personenliste", "personen")];
    }

    private async Task VollmachtSucheAsync()
    {
        vmTreffer = string.IsNullOrWhiteSpace(vmSuche)
            ? []
            : (await Vorgang.AusfuehrenAsync(d => d.GetRequiredService<IPersonenAbfrage>().SeiteAsync(new PersonenFilter(vmSuche), null, 8)))
                .Where(t => t.Id != Id).ToList();
    }

    private async Task VollmachtErteilenAsync()
    {
        var (bevId, bevName) = vmArt == Bevollmaechtigtenart.Person
            ? (vmPersonId!.Value, vmPersonName!)
            : (vmOrganisationId!.Value, organisationen.First(o => o.Id == vmOrganisationId).Name);
        try
        {
            await Vorgang.AusfuehrenAsync(d => d.GetRequiredService<PersonenDienst>()
                .VollmachtErteilenAsync(Id, vmArt, bevId, bevName, vmNachweis!, vmVon!.Value, vmBis?.AddDays(1)));
            Hinweise.Notify(NotificationSeverity.Success, "Gespeichert", $"{bevName} darf {stand?.NameMitTitel} jetzt buchen.");
            vmNachweis = vmSuche = null;
            vmPersonId = vmOrganisationId = null;
            vmTreffer = [];
            await LadenAsync();
            folgeschritte = [new("Vollmacht in der Datenhistorie ansehen", $"personen/{Id}/historie?art=Vollmachten", Hauptschritt: true)];
        }
        catch (InvalidOperationException ex)
        {
            Hinweise.Notify(NotificationSeverity.Error, "Nicht möglich", ex.Message);
        }
    }

    private async Task VollmachtWiderrufenAsync(Guid vollmachtId)
    {
        var heute = DateOnly.FromDateTime(Uhr.GetLocalNow().Date);
        await Vorgang.AusfuehrenAsync(d => d.GetRequiredService<PersonenDienst>()
            .VollmachtWiderrufenAsync(Id, vollmachtId, heute, "Widerruf"));
        Hinweise.Notify(NotificationSeverity.Info, "Widerrufen", "Die Vollmacht gilt ab heute nicht mehr; sie bleibt in der Historie.");
        await LadenAsync();
    }
    private async Task TestmailAsync()
    {
        if (person?.EMail is null || stand is null)
        {
            return;
        }

        await Vorgang.AusfuehrenAsync(async d =>
        {
            await d.GetRequiredService<PostausgangDienst>().KundenmailEinreihenAsync(person.EMail, stand.NameMitTitel,
                "Testnachricht Ihrer Volkshochschule",
                $"Guten Tag {stand.NameMitTitel},\n\ndies ist eine Testnachricht aus VibeVHS.\n\nIhre Volkshochschule",
                person.Sprache, person.Id);
            await d.GetRequiredService<INachrichtenSpeicher>().SpeichernAsync();
        });
        Hinweise.Notify(NotificationSeverity.Info, "Im Postausgang", "Die Testmail liegt im Postausgang und wird simuliert zugestellt.");
        folgeschritte = [new("Postausgang ansehen", "postausgang", Hauptschritt: true), new("Zur Personenliste", "personen")];
    }
}
