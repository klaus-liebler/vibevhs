@page "/personen/{Id:guid}"
@using VibeVHS.Application.Personen
@using VibeVHS.Application.Postausgang
@using VibeVHS.Domain.Personen
@inject Vorgang Vorgang
@inject TimeProvider Uhr
@inject NotificationService Hinweise

<PageTitle>@(aktuell?.Anzeige ?? "Person") · VibeVHS</PageTitle>

@if (person is null)
{
    <h1>Person nicht gefunden</h1>
    <NaechsteSchritte Schritte="@([new NaechsterSchritt("Zur Personenliste", "personen", Hauptschritt: true)])" />
    return;
}

<div class="vhs-head">
    <div>
        <h1>@aktuell!.Anzeige</h1>
        <p class="vhs-sub">Korrespondenzsprache: @Sprachen.Name(person.Sprache)</p>
    </div>
    <div class="vhs-row">
        <BegruendeterButton Text="Testmail in den Postausgang" Icon="mail" ButtonStyle="ButtonStyle.Light"
                            Freigabe="@MailFreigabe" Click="TestmailAsync" />
        <BegruendeterButton Text="Bescheinigung drucken" Icon="print" ButtonStyle="ButtonStyle.Light"
                            Freigabe="@(Freigabe.Geplant("Der Druck von Bescheinigungen (mit QR-Code „Translate this letter“)"))" />
    </div>
</div>

<section class="vhs-card">
    <h2>Stammdaten</h2>
    <div class="vhs-fields">
        <GesperrtesFeld Bezeichnung="Name" Wert="@aktuell.Anzeige"
                        Begruendung="Namen werden nie überschrieben, damit ältere Bescheinigungen den damals gültigen Namen behalten. Nutzen Sie unten „Name ändern ab Datum“ (z. B. Heirat) oder „Korrigieren“ (Tippfehler)." />
        <GesperrtesFeld Bezeichnung="Geburtsdatum" Wert="@(person.Geburtsdatum?.ToString("dd.MM.yyyy") ?? "–")"
                        Begruendung="Das Bearbeiten der Stammdaten folgt in einer späteren Iteration." />
        <GesperrtesFeld Bezeichnung="E-Mail" Wert="@(person.EMail ?? "–")"
                        Begruendung="Das Bearbeiten der Stammdaten folgt in einer späteren Iteration." />
        <GesperrtesFeld Bezeichnung="Angelegt am" Wert="@person.AngelegtAm.ToLocalTime().ToString("dd.MM.yyyy HH:mm")"
                        Begruendung="Der Erfassungszeitpunkt wird vom System gesetzt und ist Teil der Nachvollziehbarkeit." />
        <GesperrtesFeld Bezeichnung="Personen-ID" Wert="@person.Id.ToString()"
                        Begruendung="Die ID vergibt das System. Sie ändert sich nie und verknüpft alle Daten dieser Person." />
    </div>
</section>

<div class="vhs-grid-2">
    <section class="vhs-card">
        <h2>Namenshistorie</h2>
        <p class="vhs-small vhs-muted">Versionen werden nie gelöscht. Durchgestrichene Zeilen sind durch eine spätere Erfassung ersetzt (z. B. Korrektur) und bleiben für alte Ausdrucke nachvollziehbar.</p>
        <div class="vhs-tbl">
            <table>
                <thead>
                    <tr><th>Name</th><th>gültig ab</th><th>gültig bis</th><th>erfasst</th><th>ersetzt</th><th>Grund</th></tr>
                </thead>
                <tbody>
                    @foreach (var n in person.Namen.OrderBy(n => n.ErfasstAm).ThenBy(n => n.GueltigVon))
                    {
                        <tr class="@(n.IstAktuellerWissensstand ? "" : "vhs-ersetzt")">
                            <td>@n.Anzeige</td>
                            <td class="vhs-mono">@n.GueltigVon.ToString("dd.MM.yyyy")</td>
                            <td class="vhs-mono">@(n.GueltigBis?.ToString("dd.MM.yyyy") ?? "offen")</td>
                            <td class="vhs-mono">@n.ErfasstAm.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                            <td class="vhs-mono">@(n.ErsetztAm?.ToLocalTime().ToString("dd.MM.yyyy HH:mm") ?? "–")</td>
                            <td>@n.Grund</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <h3>Stichtagsabfrage</h3>
        <p class="vhs-small vhs-muted">So arbeitet z. B. der Nachdruck einer Bescheinigung: Name, der am Stichtag galt, nach dem Wissensstand zum Zeitpunkt des Originaldrucks.</p>
        <div class="vhs-fields">
            <RadzenFormField Text="Gültig am" Variant="Variant.Outlined">
                <RadzenDatePicker TValue="DateOnly?" @bind-Value="stichtag" DateFormat="dd.MM.yyyy" />
            </RadzenFormField>
            <RadzenFormField Text="Wissensstand vom" Variant="Variant.Outlined">
                <RadzenDatePicker TValue="DateTime?" @bind-Value="wissensstand" DateFormat="dd.MM.yyyy HH:mm" ShowTime="true" />
            </RadzenFormField>
        </div>
        <div class="vhs-alert vhs-info">@StichtagErgebnis</div>
    </section>

    <section class="vhs-card">
        <h2>Namen ändern</h2>
        <RadzenRadioButtonList TValue="bool" @bind-Value="istKorrektur" Orientation="Orientation.Vertical">
            <Items>
                <RadzenRadioButtonListItem Text="Änderung ab einem Datum (z. B. Heirat): ältere Dokumente behalten den alten Namen" Value="false" />
                <RadzenRadioButtonListItem Text="Korrektur (Tippfehler): der Name war schon immer falsch erfasst" Value="true" />
            </Items>
        </RadzenRadioButtonList>
        <div class="vhs-fields">
            <RadzenFormField Text="Vorname *" Variant="Variant.Outlined"><RadzenTextBox @bind-Value="neuVorname" /></RadzenFormField>
            <RadzenFormField Text="Nachname *" Variant="Variant.Outlined"><RadzenTextBox @bind-Value="neuNachname" /></RadzenFormField>
            <RadzenFormField Text="@(istKorrektur ? "Betroffene Version gültig am *" : "Gültig ab *")" Variant="Variant.Outlined">
                <RadzenDatePicker TValue="DateOnly?" @bind-Value="aenderungsdatum" DateFormat="dd.MM.yyyy" />
            </RadzenFormField>
        </div>
        <RadzenFormField Text="Grund / Nachweis *" Variant="Variant.Outlined" Style="width:100%">
            <RadzenTextBox @bind-Value="grund" Placeholder="z. B. Heirat, Nachweis: Heiratsurkunde" />
        </RadzenFormField>
        @if (fehler is not null)
        {
            <div class="vhs-alert vhs-crit" role="alert">@fehler</div>
        }
        <div class="vhs-row">
            <BegruendeterButton Text="@(istKorrektur ? "Korrektur speichern" : "Änderung speichern")" Icon="save"
                                Freigabe="@AenderungFreigabe" Click="NameSpeichernAsync" IsBusy="@speichert" />
        </div>
    </section>
</div>

<NaechsteSchritte Schritte="@folgeschritte" />

@code {
    [Parameter]
    public Guid Id { get; set; }

    private Person? person;
    private PersonName? aktuell;
    private DateOnly? stichtag;
    private DateTime? wissensstand;

    private bool istKorrektur, speichert;
    private string? neuVorname, neuNachname, grund, fehler;
    private DateOnly? aenderungsdatum;
    private IReadOnlyList<NaechsterSchritt> folgeschritte = [new("Zur Personenliste", "personen")];

    private Freigabe MailFreigabe => string.IsNullOrWhiteSpace(person?.EMail)
        ? Freigabe.Nein("Für diese Person ist keine E-Mail-Adresse hinterlegt.")
        : Freigabe.Ja;

    private Freigabe AenderungFreigabe =>
        string.IsNullOrWhiteSpace(neuVorname) || string.IsNullOrWhiteSpace(neuNachname)
            ? Freigabe.Nein("Bitte Vor- und Nachnamen eintragen.")
            : aenderungsdatum is null
                ? Freigabe.Nein(istKorrektur ? "Bitte angeben, für welchen Tag die zu korrigierende Version gilt." : "Bitte das Datum angeben, ab dem der neue Name gilt.")
                : string.IsNullOrWhiteSpace(grund)
                    ? Freigabe.Nein("Ein Grund ist Pflicht, damit die Änderung später nachvollziehbar ist.")
                    : Freigabe.Ja;

    private string StichtagErgebnis
    {
        get
        {
            if (person is null || stichtag is null || wissensstand is null)
            {
                return "Bitte Stichtag und Wissensstand wählen.";
            }

            var bekannt = new DateTimeOffset(wissensstand.Value, TimeZoneInfo.Local.GetUtcOffset(wissensstand.Value));
            var name = person.NameAm(stichtag.Value, bekannt);
            return name is null
                ? $"Für den {stichtag:dd.MM.yyyy} war am {wissensstand:dd.MM.yyyy HH:mm} kein Name erfasst."
                : $"Am {stichtag:dd.MM.yyyy} hieß die Person nach Wissensstand vom {wissensstand:dd.MM.yyyy HH:mm}: {name.Anzeige}";
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        await LadenAsync();
        stichtag ??= DateOnly.FromDateTime(Uhr.GetLocalNow().Date);
        wissensstand ??= Uhr.GetLocalNow().DateTime;
        aenderungsdatum ??= DateOnly.FromDateTime(Uhr.GetLocalNow().Date);
    }

    private async Task LadenAsync()
    {
        person = await Vorgang.AusfuehrenAsync(d => d.GetRequiredService<IPersonenSpeicher>().LadenAsync(Id));
        aktuell = person?.AktuellerName(Uhr.GetLocalNow());
        if (aktuell is not null)
        {
            neuVorname ??= aktuell.Vorname;
            neuNachname ??= aktuell.Nachname;
        }
    }

    private async Task NameSpeichernAsync()
    {
        fehler = null;
        speichert = true;
        try
        {
            var dienst = (IServiceProvider d) => d.GetRequiredService<PersonenDienst>();
            var neu = istKorrektur
                ? await Vorgang.AusfuehrenAsync(d => dienst(d).NameKorrigierenAsync(Id, neuVorname!, neuNachname!, aenderungsdatum!.Value, grund!))
                : await Vorgang.AusfuehrenAsync(d => dienst(d).NameAendernAbAsync(Id, neuVorname!, neuNachname!, aenderungsdatum!.Value, grund!));
            Hinweise.Notify(NotificationSeverity.Success, "Gespeichert",
                istKorrektur ? $"Name korrigiert in {neu.Anzeige}." : $"{neu.Anzeige} gilt ab {neu.GueltigVon:dd.MM.yyyy}.");
            grund = null;
            await LadenAsync();
            folgeschritte =
            [
                new("Änderung im Protokoll ansehen", "protokoll", Hauptschritt: true),
                new("Bescheinigungen neu drucken", "#", Freigabe: Freigabe.Geplant("Der Druck von Bescheinigungen")),
                new("Zur Personenliste", "personen"),
            ];
        }
        catch (Exception ex) when (ex is InvalidOperationException or ArgumentException)
        {
            fehler = ex.Message;
        }
        finally
        {
            speichert = false;
        }
    }

    private async Task TestmailAsync()
    {
        if (person?.EMail is null || aktuell is null)
        {
            return;
        }

        await Vorgang.AusfuehrenAsync(async d =>
        {
            await d.GetRequiredService<PostausgangDienst>().KundenmailEinreihenAsync(person.EMail, aktuell.Anzeige,
                "Testnachricht der VHS Musterstadt",
                $"Guten Tag {aktuell.Anzeige},\n\ndies ist eine Testnachricht aus VibeVHS.\n\nIhre VHS Musterstadt",
                person.Sprache, person.Id);
            await d.GetRequiredService<INachrichtenSpeicher>().SpeichernAsync();
        });
        Hinweise.Notify(NotificationSeverity.Info, "Im Postausgang", "Die Testmail liegt im Postausgang und wird simuliert zugestellt.");
        folgeschritte = [new("Postausgang ansehen", "postausgang", Hauptschritt: true), new("Zur Personenliste", "personen")];
    }
}
