@page "/personen/{Id:guid}"
@using VibeVHS.Application.Personen
@using VibeVHS.Application.Postausgang
@using VibeVHS.Domain.Personen
@inject Vorgang Vorgang
@inject TimeProvider Uhr
@inject NotificationService Hinweise
@inject NavigationManager Navigation

<PageTitle>@(stand?.NameMitTitel ?? "Person") · VibeVHS</PageTitle>

@if (person is null || stand is null)
{
    <h1>Person nicht gefunden</h1>
    <NaechsteSchritte Schritte="@([new NaechsterSchritt("Zur Personenliste", "personen", Hauptschritt: true)])" />
    return;
}

<div class="vhs-head">
    <div>
        <h1>@stand.NameMitTitel</h1>
        <p class="vhs-sub">@PersonMerkmal.RollenAnzeige(stand.Rollen) · Korrespondenz auf @Sprachen.Name(stand.Sprache ?? "de")</p>
    </div>
    <div class="vhs-row">
        <RadzenButton Text="Datenhistorie" Icon="history" ButtonStyle="ButtonStyle.Light"
                      Click="@(() => Navigation.NavigateTo($"personen/{Id}/historie"))" />
        <BegruendeterButton Text="Testmail" Icon="mail" ButtonStyle="ButtonStyle.Light"
                            Freigabe="@MailFreigabe" Click="TestmailAsync" />
        <BegruendeterButton Text="Bescheinigung drucken" Icon="print" ButtonStyle="ButtonStyle.Light"
                            Freigabe="@(Freigabe.Geplant("Der Druck von Bescheinigungen (mit QR-Code „Translate this letter“)"))" />
    </div>
</div>

<section class="vhs-card">
    <div class="vhs-head">
        <h2>Stammdaten</h2>
        <span class="vhs-small vhs-muted">Stand heute · <span class="vhs-why" tabindex="0"
            data-why="Die ID vergibt das System; sie ändert sich nie. Der Erfassungszeitpunkt ist Teil der Nachvollziehbarkeit.">angelegt
            @person.AngelegtAm.ToLocalTime().ToString("dd.MM.yyyy") · ID @person.Id.ToString()[..8]…</span></span>
    </div>
    <StammdatenKompakt Stand="@stand" PersonId="@Id" />
</section>

<details class="vhs-card" open="@nameOffen">
    <summary><b>Namen ändern</b> <span class="vhs-small vhs-muted">– Namen werden nie überschrieben, ältere Dokumente behalten den damals gültigen Namen</span></summary>
    <RadzenRadioButtonList TValue="bool" @bind-Value="istKorrektur" Orientation="Orientation.Vertical">
        <Items>
            <RadzenRadioButtonListItem Text="Änderung ab einem Datum (z. B. Heirat): ältere Dokumente behalten den alten Namen" Value="false" />
            <RadzenRadioButtonListItem Text="Korrektur (Tippfehler): der Name war schon immer falsch erfasst" Value="true" />
        </Items>
    </RadzenRadioButtonList>
    <div class="vhs-fields">
        <RadzenFormField Text="Vorname *" Variant="Variant.Outlined"><RadzenTextBox @bind-Value="neuVorname" /></RadzenFormField>
        <RadzenFormField Text="Nachname *" Variant="Variant.Outlined"><RadzenTextBox @bind-Value="neuNachname" /></RadzenFormField>
        <RadzenFormField Text="@(istKorrektur ? "Betroffene Version gültig am *" : "Gültig ab *")" Variant="Variant.Outlined">
            <RadzenDatePicker TValue="DateOnly?" @bind-Value="aenderungsdatum" DateFormat="dd.MM.yyyy" />
        </RadzenFormField>
        <RadzenFormField Text="Grund / Nachweis *" Variant="Variant.Outlined">
            <RadzenTextBox @bind-Value="grund" Placeholder="z. B. Heirat, Nachweis: Heiratsurkunde" />
        </RadzenFormField>
    </div>
    @if (fehler is not null)
    {
        <div class="vhs-alert vhs-crit" role="alert">@fehler</div>
    }
    <div class="vhs-row">
        <BegruendeterButton Text="@(istKorrektur ? "Korrektur speichern" : "Änderung speichern")" Icon="save"
                            Freigabe="@AenderungFreigabe" Click="NameSpeichernAsync" IsBusy="@speichert" />
    </div>
</details>

<NaechsteSchritte Schritte="@folgeschritte" />

@code {
    [Parameter]
    public Guid Id { get; set; }

    private Person? person;
    private PersonenStand? stand;

    private bool istKorrektur, speichert, nameOffen;
    private string? neuVorname, neuNachname, grund, fehler;
    private DateOnly? aenderungsdatum;
    private IReadOnlyList<NaechsterSchritt> folgeschritte = [];

    private Freigabe MailFreigabe => string.IsNullOrWhiteSpace(person?.EMail)
        ? Freigabe.Nein("Für diese Person ist keine E-Mail-Adresse hinterlegt.")
        : Freigabe.Ja;

    private Freigabe AenderungFreigabe =>
        string.IsNullOrWhiteSpace(neuVorname) || string.IsNullOrWhiteSpace(neuNachname)
            ? Freigabe.Nein("Bitte Vor- und Nachnamen eintragen.")
            : aenderungsdatum is null
                ? Freigabe.Nein(istKorrektur ? "Bitte angeben, für welchen Tag die zu korrigierende Version gilt." : "Bitte das Datum angeben, ab dem der neue Name gilt.")
                : string.IsNullOrWhiteSpace(grund)
                    ? Freigabe.Nein("Ein Grund ist Pflicht, damit die Änderung später nachvollziehbar ist.")
                    : Freigabe.Ja;

    protected override async Task OnParametersSetAsync()
    {
        await LadenAsync();
        aenderungsdatum ??= DateOnly.FromDateTime(Uhr.GetLocalNow().Date);
        folgeschritte = [new("Datenhistorie ansehen", $"personen/{Id}/historie"), new("Zur Personenliste", "personen")];
    }

    private async Task LadenAsync()
    {
        person = await Vorgang.AusfuehrenAsync(d => d.GetRequiredService<IPersonenSpeicher>().LadenAsync(Id));
        var jetzt = Uhr.GetLocalNow();
        stand = person?.StandAm(DateOnly.FromDateTime(jetzt.Date), jetzt);
        if (stand?.Name is { } name)
        {
            neuVorname ??= name.Vorname;
            neuNachname ??= name.Nachname;
        }
    }

    private async Task NameSpeichernAsync()
    {
        fehler = null;
        speichert = true;
        try
        {
            var dienst = (IServiceProvider d) => d.GetRequiredService<PersonenDienst>();
            var neu = istKorrektur
                ? await Vorgang.AusfuehrenAsync(d => dienst(d).NameKorrigierenAsync(Id, neuVorname!, neuNachname!, aenderungsdatum!.Value, grund!))
                : await Vorgang.AusfuehrenAsync(d => dienst(d).NameAendernAbAsync(Id, neuVorname!, neuNachname!, aenderungsdatum!.Value, grund!));
            Hinweise.Notify(NotificationSeverity.Success, "Gespeichert",
                istKorrektur ? $"Name korrigiert in {neu.Anzeige}." : $"{neu.Anzeige} gilt ab {neu.GueltigVon:dd.MM.yyyy}.");
            grund = null;
            nameOffen = false;
            await LadenAsync();
            folgeschritte =
            [
                new("Änderung in der Datenhistorie ansehen", $"personen/{Id}/historie?art=Name", Hauptschritt: true),
                new("Bescheinigungen neu drucken", "#", Freigabe: Freigabe.Geplant("Der Druck von Bescheinigungen")),
                new("Zur Personenliste", "personen"),
            ];
        }
        catch (Exception ex) when (ex is InvalidOperationException or ArgumentException)
        {
            fehler = ex.Message;
            nameOffen = true;
        }
        finally
        {
            speichert = false;
        }
    }

    private async Task TestmailAsync()
    {
        if (person?.EMail is null || stand is null)
        {
            return;
        }

        await Vorgang.AusfuehrenAsync(async d =>
        {
            await d.GetRequiredService<PostausgangDienst>().KundenmailEinreihenAsync(person.EMail, stand.NameMitTitel,
                "Testnachricht Ihrer Volkshochschule",
                $"Guten Tag {stand.NameMitTitel},\n\ndies ist eine Testnachricht aus VibeVHS.\n\nIhre Volkshochschule",
                person.Sprache, person.Id);
            await d.GetRequiredService<INachrichtenSpeicher>().SpeichernAsync();
        });
        Hinweise.Notify(NotificationSeverity.Info, "Im Postausgang", "Die Testmail liegt im Postausgang und wird simuliert zugestellt.");
        folgeschritte = [new("Postausgang ansehen", "postausgang", Hauptschritt: true), new("Zur Personenliste", "personen")];
    }
}
