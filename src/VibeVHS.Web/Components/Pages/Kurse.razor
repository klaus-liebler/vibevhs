@page "/kurse"
@using VibeVHS.Application.Programm
@using VibeVHS.Application.Stammdaten
@using VibeVHS.Domain.Programm
@using VibeVHS.Domain.Stammdaten
@inject Vorgang Vorgang
@inject NavigationManager Navigation
@inject NotificationService Hinweise

<PageTitle>Kurse · VibeVHS</PageTitle>

<div class="vhs-head">
    <div>
        <h1>Kurse</h1>
        <p class="vhs-sub">@(zahlen?.Gesamt ?? 0) Kurse@(semester is null ? "" : $" im {semester.Name}") · Konflikte werden beim Planen geprüft</p>
    </div>
    <div class="vhs-row">
        <BegruendeterButton Text="Kurs anlegen" Icon="add" Freigabe="@Planen" Click="@(() => Navigation.NavigateTo("kurse/neu"))" />
        <BegruendeterButton Text="Semester kopieren" Icon="content_copy" ButtonStyle="ButtonStyle.Light" Freigabe="@Planen"
                            Click="@(() => kopieOffen = !kopieOffen)" />
        <RadzenButton Text="Raumplan" Icon="calendar_view_week" ButtonStyle="ButtonStyle.Light" Click="@(() => Navigation.NavigateTo("raumplan"))" />
        <a class="vhs-btn vhs-btn-light" href="@($"kurse/qr-bogen.pdf?semester={semesterId}{(fachbereich is { } f ? $"&fb={f}" : "")}")" target="_blank"
           title="Sammel-PDF mit den QR-Codes aller öffentlichen Kurse des gewählten Semesters (und Fachbereichs) für das Programmheft">Kurs-QR-Bogen (PDF)</a>
        <a class="vhs-btn vhs-btn-light" href="@($"kurse/qr-bogen.pdf?semester={semesterId}{(fachbereich is { } f2 ? $"&fb={f2}" : "")}&schnitt=1")" target="_blank"
           title="Gleicher Bogen mit gestrichelten Kartenrändern zum Ausschneiden (Aushang, Flyer)">… zum Ausschneiden</a>
    </div>
</div>

@if (kopieOffen)
{
    <section class="vhs-card">
        <h2>Semester kopieren</h2>
        <p class="vhs-small vhs-muted" style="margin-top:-6px">Alle nicht abgesagten Kurse werden als Entwurf ins Zielsemester übernommen; Termine wandern um ganze Wochen mit (gleiche Wochentage), Ferien und Feiertage werden neu berücksichtigt.</p>
        <div class="vhs-fields">
            <RadzenFormField Text="Von" Variant="Variant.Outlined"><RadzenDropDown TValue="Guid?" @bind-Value="kopieVon" Data="@alleSemester" TextProperty="Name" ValueProperty="Id" /></RadzenFormField>
            <RadzenFormField Text="Nach" Variant="Variant.Outlined"><RadzenDropDown TValue="Guid?" @bind-Value="kopieNach" Data="@alleSemester" TextProperty="Name" ValueProperty="Id" /></RadzenFormField>
        </div>
        <div class="vhs-row">
            <BegruendeterButton Text="Kopieren" Icon="content_copy" Click="KopierenAsync" IsBusy="@kopiert"
                                Freigabe="@(kopieVon is null || kopieNach is null ? Freigabe.Nein("Bitte Quell- und Zielsemester wählen.") : kopieVon == kopieNach ? Freigabe.Nein("Quelle und Ziel sind dasselbe Semester.") : Freigabe.Ja)" />
        </div>
    </section>
}

<NaechsteSchritte Schritte="@folgeschritte" />

<section class="vhs-card">
    <div class="vhs-row">
        <RadzenDropDown TValue="Guid?" @bind-Value="semesterId" @bind-Value:after="LadenAsync" aria-label="Semester" Data="@alleSemester" TextProperty="Name" ValueProperty="Id" Style="min-width:180px" />
        <div class="vhs-suche" style="flex:1 1 280px">
            <RadzenIcon Icon="search" />
            <input type="search" @bind="suche" @bind:event="oninput" @bind:after="SucheGeaendertAsync" placeholder="Kursnummer oder Titel" aria-label="Kurse suchen" />
        </div>
        <label class="vhs-small"><input type="checkbox" @bind="archivierte" @bind:after="LadenAsync" /> archivierte Kurse zeigen</label>
    </div>
    <div class="vhs-filter">
        <span class="vhs-filter-lbl">Fachbereich</span>
        @foreach (var fb in fachbereiche)
        {
            var n = zahlen?.Fachbereiche.GetValueOrDefault(fb.Nr) ?? 0;
            <button class="vhs-chip @(fachbereich == fb.Nr ? "on" : "")" title="@fb.Anzeige" disabled="@(n == 0)" @onclick="@(async () => { fachbereich = fachbereich == fb.Nr ? null : fb.Nr; await LadenAsync(); })" aria-pressed="@(fachbereich == fb.Nr ? "true" : "false")">FB @fb.Nr <span class="vhs-chip-n">@n</span></button>
        }
        <span class="vhs-filter-lbl">Status</span>
        @foreach (var s in Enum.GetValues<Kursstatus>())
        {
            var n = zahlen?.Status.GetValueOrDefault(s) ?? 0;
            <button class="vhs-chip @(status == s ? "on" : "")" disabled="@(n == 0)" @onclick="@(async () => { status = status == s ? null : s; await LadenAsync(); })" aria-pressed="@(status == s ? "true" : "false")">@KursAnzeige.Status(s) <span class="vhs-chip-n">@n</span></button>
        }
    </div>
    <div class="vhs-vliste-kopf vhs-kursliste" aria-hidden="true">
        <span>Nr.</span><span>Titel</span><span>FB</span><span>Termine</span><span>Ort</span><span>Leitung</span><span>Plätze</span><span>Status</span>
    </div>
    <div class="vhs-vliste" role="list" aria-label="Kurse" data-liste="kurse">
        <Virtualize @ref="liste" TItem="KursZeile" ItemsProvider="BlockLadenAsync" ItemComparer="@GleicheId" ItemSize="46" OverscanCount="15" Context="z">
            <ItemContent>
                <a @key="z.Id" class="vhs-vzeile vhs-kursliste" role="listitem" data-zeile="@z.Id" href="@DetailLink(z.Id)">
                    <span class="vhs-mono">@z.Kursnummer</span>
                    <span class="vhs-ellipse"><b>@z.Titel</b>
                        @if (z.Sichtbarkeit != Sichtbarkeit.Oeffentlich) { <StatusPille Stil="info">@KursAnzeige.Sichtbarkeit(z.Sichtbarkeit)</StatusPille> }
                        @if (z.Umfang == Kursumfang.Unbefristet) { <StatusPille Stil="neutral">fortlaufend</StatusPille> }
                    </span>
                    <span>@z.Fachbereich</span>
                    <span class="vhs-small">@(z.ErsterTermin is { } e ? $"{e:ddd dd.MM.} {e:HH:mm}" : "–")@(z.Termine > 1 ? $" · {z.Termine}×" : "")</span>
                    <span class="vhs-small vhs-ellipse">@z.Ort</span>
                    <span class="vhs-small vhs-ellipse">@z.Leitung</span>
                    <span class="vhs-mono">@z.MaxTeilnehmende</span>
                    <span><StatusPille Stil="@(z.Status == Kursstatus.Veroeffentlicht ? "gut" : z.Status == Kursstatus.Abgesagt ? "krit" : "neutral")">@KursAnzeige.Status(z.Status)</StatusPille></span>
                </a>
            </ItemContent>
            <Placeholder>
                <div class="vhs-vzeile vhs-muted">wird geladen …</div>
            </Placeholder>
            <EmptyContent>
                <div class="vhs-vzeile vhs-muted">Keine Kurse gefunden. Suchbegriff kürzen oder Filter zurücksetzen.</div>
            </EmptyContent>
        </Virtualize>
    </div>
    <p class="vhs-small vhs-muted" style="margin:0">@(zahlen?.Gesamt ?? 0) Treffer · beim Scrollen werden je @Blockgroesse weitere nachgeladen</p>
</section>

@code {
    private IReadOnlyList<Semester> alleSemester = [];
    private IReadOnlyList<Fachbereich> fachbereiche = [];
    private const int Blockgroesse = 50;

    private static readonly IEqualityComparer<KursZeile> GleicheId = EqualityComparer<KursZeile>.Create((a, b) => a?.Id == b?.Id, z => z.Id.GetHashCode());

    private Virtualize<KursZeile>? liste;
    private Kurszahlen? zahlen;
    private readonly List<KursZeile> geladen = [];
    private bool ende;
    private readonly SemaphoreSlim ladesperre = new(1, 1);
    private CancellationTokenSource? sucheVerzoegerung;
    private Semester? semester;
    private Guid? semesterId;
    private string? suche;
    private int? fachbereich;
    private Kursstatus? status;
    private Rolle? rolle;
    private bool kopieOffen, kopiert, archivierte;
    private Guid? kopieVon, kopieNach;
    private IReadOnlyList<NaechsterSchritt> folgeschritte = [];

    // Listenzustand in der Adresse: teilbar, Browser-Zurück und „← Zurück zur Liste“ stellen ihn wieder her.
    [SupplyParameterFromQuery(Name = "fb")]
    private int? FbAusAdresse { get; set; }

    [SupplyParameterFromQuery(Name = "semester")]
    private Guid? SemesterAusAdresse { get; set; }

    [SupplyParameterFromQuery(Name = "q")]
    private string? SucheAusAdresse { get; set; }

    [SupplyParameterFromQuery(Name = "status")]
    private string? StatusAusAdresse { get; set; }

    [SupplyParameterFromQuery(Name = "archiv")]
    private bool? ArchivAusAdresse { get; set; }

    /// <summary>Basisrelative Adresse der Liste im aktuellen Zustand.</summary>
    private string ListenUrl => Ruecksprung.Url("kurse",
        ("semester", semesterId?.ToString()), ("q", string.IsNullOrWhiteSpace(suche) ? null : suche.Trim()), ("fb", fachbereich?.ToString(System.Globalization.CultureInfo.InvariantCulture)),
        ("status", status?.ToString()), ("archiv", archivierte ? "true" : null));

    private string DetailLink(Guid id) => Ruecksprung.Detail($"kurse/{id}", ListenUrl);

    private Freigabe Planen => Freigabe.NurFuer(rolle, Rolle.Fachbereichsleitung, Rolle.Leitung);

    protected override async Task OnInitializedAsync()
    {
        rolle = (await Vorgang.BenutzerAsync()).Rolle;
        fachbereich = FbAusAdresse;
        suche = SucheAusAdresse;
        status = Enum.TryParse<Kursstatus>(StatusAusAdresse, out var st) ? st : null;
        archivierte = ArchivAusAdresse == true;
        await Vorgang.AusfuehrenAsync(async d =>
        {
            alleSemester = await d.GetRequiredService<IProgrammSpeicher>().SemesterAsync();
            fachbereiche = await d.GetRequiredService<IStammdaten>().FachbereicheAsync();
        });
        var heute = DateOnly.FromDateTime(DateTime.Today);
        semesterId = alleSemester.Any(s => s.Id == SemesterAusAdresse)
            ? SemesterAusAdresse
            : (alleSemester.FirstOrDefault(s => s.Beginn <= heute && heute <= s.Ende) ?? alleSemester.LastOrDefault())?.Id;
        kopieVon = semesterId;
        kopieNach = alleSemester.FirstOrDefault(s => s.Beginn > heute)?.Id;
        await LadenAsync();
    }

    private KursFilter Filter => new(semesterId, fachbereich, status, suche, archivierte);

    /// <summary>Filter oder Semester geändert: Zähler neu, Liste von vorn (Keyset-Blöcke lädt Virtualize beim Scrollen nach).</summary>
    private async Task LadenAsync()
    {
        semester = alleSemester.FirstOrDefault(s => s.Id == semesterId);
        zahlen = await Vorgang.AusfuehrenAsync(d => d.GetRequiredService<IProgrammSpeicher>().KurszahlenAsync(Filter));
        await ladesperre.WaitAsync();
        try
        {
            geladen.Clear();
            ende = false;
        }
        finally
        {
            ladesperre.Release();
        }

        if (liste is not null)
        {
            await liste.RefreshDataAsync();
        }

        if (zustandSchreiben)
        {
            Ruecksprung.ZustandSetzen(Navigation, ListenUrl);
        }
    }

    /// <summary>Suche mit kurzer Verzögerung (nicht bei jedem Tastendruck neu laden).</summary>
    private async Task SucheGeaendertAsync()
    {
        sucheVerzoegerung?.Cancel();
        sucheVerzoegerung = new CancellationTokenSource();
        try
        {
            await Task.Delay(250, sucheVerzoegerung.Token);
            await LadenAsync();
        }
        catch (TaskCanceledException)
        {
        }
    }

    /// <summary>Virtualize fragt nach Positionen; geladen wird per Keyset (Kursnummer) in Blöcken, bis die Position erreicht ist.</summary>
    private async ValueTask<ItemsProviderResult<KursZeile>> BlockLadenAsync(ItemsProviderRequest anfrage)
    {
        await ladesperre.WaitAsync(anfrage.CancellationToken);
        try
        {
            var filter = Filter;
            while (!ende && (geladen.Count == 0 || geladen.Count < anfrage.StartIndex + anfrage.Count))
            {
                var nach = geladen.Count == 0 ? null : geladen[^1].Kursnummer;
                var block = await Vorgang.AusfuehrenAsync(d => d.GetRequiredService<IProgrammSpeicher>()
                    .KurseAsync(filter with { NachKursnummer = nach, Anzahl = Blockgroesse }, anfrage.CancellationToken));
                geladen.AddRange(block);
                ende = block.Count < Blockgroesse;
            }

            var gesamt = ende ? geladen.Count : Math.Max(zahlen?.Gesamt ?? 0, geladen.Count + 1);
            return new ItemsProviderResult<KursZeile>(geladen.Skip(anfrage.StartIndex).Take(anfrage.Count).ToList(), gesamt);
        }
        finally
        {
            ladesperre.Release();
        }
    }

    // Erst nach dem ersten Laden schreiben (beim Vorrendern gibt es noch keine interaktive Navigation).
    private bool zustandSchreiben;

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender && RendererInfo.IsInteractive)
        {
            zustandSchreiben = true;
            Ruecksprung.ZustandSetzen(Navigation, ListenUrl);
        }
    }

    private async Task KopierenAsync()
    {
        kopiert = true;
        try
        {
            var n = await Vorgang.AusfuehrenAsync(d => d.GetRequiredService<ProgrammDienst>().SemesterKopierenAsync(kopieVon!.Value, kopieNach!.Value));
            Hinweise.Notify(NotificationSeverity.Success, "Semesterkopie", $"{n} Kurse als Entwurf angelegt.");
            semesterId = kopieNach;
            kopieOffen = false;
            folgeschritte = [new("Raumplan des Zielsemesters prüfen", "raumplan", "Konflikte durch neue Ferien oder Räume erkennen", Hauptschritt: true)];
            await LadenAsync();
        }
        finally
        {
            kopiert = false;
        }
    }
}
