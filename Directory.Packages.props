<Project>
  <PropertyGroup>
    <!-- Transitive Abhängigkeiten (z. B. von PDFsharp) auf die hier genannten, sicheren Versionen heben. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <!-- Zentrale Paketversionen. Erlaubt: Radzen.Blazor, EF Core + PostgreSQL (Npgsql), Serilog, Quartz.NET, xUnit, Shouldly, Bogus, Verify, ClosedXML.
       Nicht verwenden: QuestPDF, Nager.Date, MediatR, AutoMapper, FluentAssertions. -->
  <ItemGroup>
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="11.0.0" />
    <!-- nur für die einmalige Übernahme alter Kommentar-Dateien (kommentare.db) nach PostgreSQL -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="11.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="11.0.0" />
    <PackageVersion Include="Radzen.Blazor" Version="13.1.0" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageVersion Include="Quartz.Extensions.Hosting" Version="4.7.3" />
    <PackageVersion Include="Bogus" Version="35.6.5" />
    <PackageVersion Include="ClosedXML" Version="0.105.1" />
    <PackageVersion Include="PDFsharp-MigraDoc" Version="6.2.4" />
    <PackageVersion Include="QRCoder" Version="1.6.0" />
    <PackageVersion Include="Markdig" Version="1.5.1" />
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="11.0.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="Verify.XunitV3" Version="33.4.0" />
  </ItemGroup>
</Project>
