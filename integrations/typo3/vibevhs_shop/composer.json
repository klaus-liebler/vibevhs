{
  "name": "vibevhs/vibevhs-shop",
  "type": "typo3-cms-extension",
  "description": "Kursprogramm und Buchung aus VibeVHS für TYPO3: Delta-Abgleich, Kursliste, Suche, Detail (schema.org/Course), Warenkorb und Kasse über die VibeVHS-Buchungs-API.",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": "^8.2",
    "typo3/cms-core": "^13.4",
    "typo3/cms-extbase": "^13.4",
    "typo3/cms-fluid": "^13.4",
    "typo3/cms-scheduler": "^13.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "typo3/testing-framework": "^9.1"
  },
  "autoload": {
    "psr-4": { "Vhs\VibevhsShop\\": "Classes/" }
  },
  "autoload-dev": {
    "psr-4": { "Vhs\VibevhsShop\Tests\\": "Tests/" }
  },
  "extra": {
    "typo3/cms": { "extension-key": "vibevhs_shop" }
  },
  "scripts": {
    "test": "phpunit -c phpunit.xml.dist"
  },
  "config": {
    "allow-plugins": { "typo3/class-alias-loader": true, "typo3/cms-composer-installers": true }
  }
}
