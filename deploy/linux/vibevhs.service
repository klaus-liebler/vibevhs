# systemd-Dienst für VibeVHS (Testsystem), nativ ohne Docker.
# Installation (als root):
#   cp vibevhs.service /etc/systemd/system/
#   install -d -o vibevhs -g vibevhs /var/lib/vibevhs
#   printf 'Anmeldung__Zugangscode=HIER-EINEN-LANGEN-CODE-SETZEN\n' > /etc/vibevhs.env && chmod 600 /etc/vibevhs.env
#   systemctl daemon-reload && systemctl enable --now vibevhs
[Unit]
Description=VibeVHS Verwaltung (Testsystem)
After=network.target

[Service]
Type=simple
User=vibevhs
Group=vibevhs
WorkingDirectory=/opt/vibevhs
ExecStart=/opt/vibevhs/VibeVHS.Web
Restart=on-failure
RestartSec=5

Environment=ASPNETCORE_ENVIRONMENT=Testsystem
Environment=ASPNETCORE_URLS=http://127.0.0.1:5189
Environment=DOTNET_NOLOGO=1
Environment=ConnectionStrings__VibeVHS=Data Source=/var/lib/vibevhs/vibevhs.db
Environment=Speicher__Dokumente=/var/lib/vibevhs/dokumente
Environment=Speicher__Schluessel=/var/lib/vibevhs/schluessel
Environment=Speicher__Logs=/var/lib/vibevhs/logs
# Zugangscode (geheim) und ggf. PathBase=/vibevhs stehen hier:
EnvironmentFile=/etc/vibevhs.env

# Härtung
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/vibevhs

[Install]
WantedBy=multi-user.target
