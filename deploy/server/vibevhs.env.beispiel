# /etc/vibevhs/vibevhs.env – Geheimnisse und Abweichungen für VibeVHS (root:vibevhs, 0640). NICHT ins Repository.
# Schritt 06 legt die Datei an, falls sie fehlt; Werte hier eintragen, danach: sudo systemctl restart vibevhs

# Zusätzlicher Zugangscode auf der Testanmeldeseite (zweite Hürde hinter dem nginx-Passwort); leer = aus
#Anmeldung__Zugangscode=

# Massendaten für realistische Listen (Standard im Testsystem: 3000); 0 = nur die benannten Demopersonen
#Demodaten__Massendaten=3000
