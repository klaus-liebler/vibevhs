# VibeVHS (Testsystem) als systemd-Dienst – Ziel: /etc/systemd/system/vibevhs.service (Schritt 06)
# Self-contained Linux-Build in /opt/vibevhs (kein .NET auf dem Server nötig), Daten getrennt in /var/lib/vibevhs.
# Geheimnisse (z. B. Anmeldung__Zugangscode) stehen nur in /etc/vibevhs/vibevhs.env (root, 0640), nie im Repository.
[Unit]
Description=VibeVHS Verwaltung (Testsystem)
After=network-online.target snap.docker.dockerd.service
Wants=network-online.target

[Service]
Type=exec
User=vibevhs
Group=vibevhs
WorkingDirectory=/opt/vibevhs
ExecStart=/opt/vibevhs/VibeVHS.Web
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

Environment=ASPNETCORE_ENVIRONMENT=Testsystem
# Nur lokal: nach außen spricht ausschließlich nginx
Environment=ASPNETCORE_URLS=http://127.0.0.1:5080
Environment=DOTNET_NOLOGO=1
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
# Datenbank: PostgreSQL im Container vibevhs-db (Schritt 09); die Verbindung mit Passwort steht nur in /etc/vibevhs/vibevhs.env.
# Sicherung mit pg_dump/pg_restore 17 vom Host (Paket postgresql-client-17), alte kommentare.db wird beim ersten Start übernommen.
Environment=Sicherung__PgBin=/usr/lib/postgresql/17/bin
Environment=Kommentare__Altdatei=/var/lib/vibevhs/kommentare.db
Environment=Speicher__Dokumente=/var/lib/vibevhs/dokumente
Environment=Speicher__Schluessel=/var/lib/vibevhs/schluessel
Environment=Speicher__Logs=/var/log/vibevhs
Environment=Sicherung__Ordner=/var/backups/vibevhs
Environment=ReverseProxy__Aktiv=true
Environment=ReverseProxy__Host=liebler.iui.hs-osnabrueck.de
EnvironmentFile=-/etc/vibevhs/vibevhs.env

# Härtung
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/lib/vibevhs /var/log/vibevhs /var/backups/vibevhs

[Install]
WantedBy=multi-user.target
